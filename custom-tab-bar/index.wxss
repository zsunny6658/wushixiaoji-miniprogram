.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 100rpx;
  background: #fff;
  border-top: 1rpx solid #e5e5e5;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
}

.tab-text {
  font-size: 20rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

.tab-active .tab-text {
  color: #4A90D9;
}

.tab-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
}

.center-btn {
  width: 100rpx;
  height: 100rpx;
  background: #4A90D9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 217, 0.3);
  margin-top: -40rpx;
}

.center-plus {
  color: #fff;
  font-size: 56rpx;
  font-weight: bold;
  line-height: 1;
}
.center-plus.rec-icon {
  font-size: 44rpx;
}
.center-btn.recording {
  background: #ff4d4f;
  animation: recPulse 1s infinite;
}
.center-btn.recording .center-plus {
  font-size: 44rpx;
}
.rec-badges {
  position: absolute;
  bottom: -60rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.rec-wave {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 20rpx;
}
.rec-bar {
  width: 4rpx;
  background: #ff4d4f;
  border-radius: 2rpx;
  animation: recWave 0.6s infinite ease-in-out;
}
.rec-bar:nth-child(2) { animation-delay: 0.15s; }
.rec-bar:nth-child(3) { animation-delay: 0.3s; }
.center-rec-label {
  font-size: 18rpx;
  color: #fff;
  background: rgba(255,77,79,0.85);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}
@keyframes recPulse {
  0% { box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3); }
  50% { box-shadow: 0 4rpx 24rpx rgba(255, 77, 79, 0.6); }
  100% { box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3); }
}
@keyframes recWave {
  0%, 100% { transform: scaleY(0.4); }
  50% { transform: scaleY(1); }
}
