.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 100rpx;
  background: var(--bg-card, #fff);
  border-top: 1rpx solid var(--border, #e5e5e5);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
}

.tab-text {
  font-size: 20rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

.tab-active .tab-text {
  color: #4A90D9;
}

.tab-center {
  flex: 1.5;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
}

.tab-item-wide {
  flex: 2;
}

.center-btn {
  width: 100rpx;
  height: 100rpx;
  background: #4A90D9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 217, 0.3);
  margin-top: -40rpx;
}

.center-plus {
  color: #fff;
  font-size: 56rpx;
  font-weight: bold;
  line-height: 1;
}
.center-plus.rec-icon {
  font-size: 44rpx;
}
.center-btn.recording {
  background: #ff4d4f;
  animation: recPulse 1s infinite;
}
.center-btn.recording .center-plus {
  font-size: 44rpx;
}
.rec-badges {
  position: absolute;
  bottom: -60rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.rec-wave {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 20rpx;
}
.rec-bar {
  width: 4rpx;
  background: #ff4d4f;
  border-radius: 2rpx;
  animation: recWave 0.6s infinite ease-in-out;
}
.rec-bar:nth-child(2) { animation-delay: 0.15s; }
.rec-bar:nth-child(3) { animation-delay: 0.3s; }
.center-rec-label {
  font-size: 18rpx;
  color: #fff;
  background: rgba(255,77,79,0.85);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}
@keyframes recPulse {
  0% { box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3); }
  50% { box-shadow: 0 4rpx 24rpx rgba(255, 77, 79, 0.6); }
  100% { box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3); }
}
@keyframes recWave {
  0%, 100% { transform: scaleY(0.4); }
  50% { transform: scaleY(1); }
}

/* 全屏录音遮罩 */
.rec-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rec-overlay-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
}
.rec-overlay-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.rec-anim {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rec-ring {
  position: absolute;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 77, 79, 0.6);
}
.rec-ring-1 {
  width: 160rpx;
  height: 160rpx;
  animation: recRingPulse 1.5s infinite ease-out;
}
.rec-ring-2 {
  width: 160rpx;
  height: 160rpx;
  animation: recRingPulse 1.5s infinite ease-out 0.5s;
}
.rec-ring-3 {
  width: 160rpx;
  height: 160rpx;
  animation: recRingPulse 1.5s infinite ease-out 1s;
}
@keyframes recRingPulse {
  0% { transform: scale(0.6); opacity: 1; }
  100% { transform: scale(2); opacity: 0; }
}
.rec-mic-icon {
  font-size: 72rpx;
  z-index: 2;
}
.rec-status-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}
.rec-time {
  font-size: 48rpx;
  color: #fff;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.rec-hint-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
.rec-wave-large {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 48rpx;
  margin-top: 8rpx;
}
.rec-wave-bar {
  width: 5rpx;
  background: #ff4d4f;
  border-radius: 3rpx;
  animation: recWave 0.6s infinite ease-in-out;
}
.rec-wave-bar:nth-child(1) { animation-delay: 0s; }
.rec-wave-bar:nth-child(2) { animation-delay: 0.1s; }
.rec-wave-bar:nth-child(3) { animation-delay: 0.2s; }
.rec-wave-bar:nth-child(4) { animation-delay: 0.3s; }
.rec-wave-bar:nth-child(5) { animation-delay: 0.4s; }
.rec-wave-bar:nth-child(6) { animation-delay: 0.5s; }
.rec-wave-bar:nth-child(7) { animation-delay: 0.6s; }

/* 转写中全屏遮罩 */
.transcribing-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9998;
  display: flex;
  align-items: center;
  justify-content: center;
}
.transcribing-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
}
.transcribing-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.transcribing-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #4A90D9;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.transcribing-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

/* 转写结果预览遮罩 */
.preview-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
}
.preview-content {
  width: 85%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.preview-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.preview-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  max-height: 400rpx;
  overflow-y: auto;
  word-break: break-all;
}
.preview-actions {
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
}
.preview-actions .btn-sm {
  min-width: 160rpx;
}
