.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 100rpx;
  background: #fff;
  border-top: 1rpx solid #e5e5e5;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
}

.tab-text {
  font-size: 20rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

.tab-active .tab-text {
  color: #4A90D9;
}

.tab-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
}

.center-btn {
  width: 100rpx;
  height: 100rpx;
  background: #4A90D9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 217, 0.3);
  margin-top: -40rpx;
}

.center-plus {
  color: #fff;
  font-size: 56rpx;
  font-weight: bold;
  line-height: 1;
}
.center-rec-dot {
  font-size: 32rpx;
  color: #ff4d4f;
}
.center-rec-label {
  position: absolute;
  bottom: -28rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18rpx;
  color: #fff;
  white-space: nowrap;
}
.center-btn.recording {
  background: #ff4d4f;
  animation: recPulse 1s infinite;
}
@keyframes recPulse {
  0% { box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3); }
  50% { box-shadow: 0 4rpx 24rpx rgba(255, 77, 79, 0.6); }
  100% { box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3); }
}
