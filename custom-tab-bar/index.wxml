<view class="tab-bar">
  <view class="tab-item {{active === 0 ? 'tab-active' : ''}}" bindtap="switchTab" data-index="0">
    <ficon name="home" size="40" color="{{active === 0 ? '#4A90D9' : '#9CA3AF'}}" />
    <text class="tab-text">概览</text>
  </view>
  <view class="tab-item {{active === 1 ? 'tab-active' : ''}}" bindtap="switchTab" data-index="1">
    <ficon name="clipboard" size="40" color="{{active === 1 ? '#4A90D9' : '#9CA3AF'}}" />
    <text class="tab-text">小记</text>
  </view>
  <view class="tab-center">
    <view class="center-btn {{voiceRecording ? 'recording' : ''}}" catchtap="openAdd" catchlongpress="onVoiceTap" catchtouchend="onVoiceEnd">
      <ficon class="center-plus" wx:if="{{voiceRecording}}" name="mic" size="48" color="#fff" />
      <text class="center-plus" wx:else>+</text>
    </view>
  </view>
  <view class="tab-item {{active === 2 ? 'tab-active' : ''}}" bindtap="switchTab" data-index="2">
    <ficon name="target" size="40" color="{{active === 2 ? '#4A90D9' : '#9CA3AF'}}" />
    <text class="tab-text">四象限</text>
  </view>
  <view class="tab-item {{active === 3 ? 'tab-active' : ''}}" bindtap="switchTab" data-index="3">
    <ficon name="user" size="40" color="{{active === 3 ? '#4A90D9' : '#9CA3AF'}}" />
    <text class="tab-text">我的</text>
  </view>
  <!-- 全屏录音遮罩 -->
  <view class="rec-overlay" wx:if="{{voiceRecording}}" catchtouchend="onVoiceEnd">
    <view class="rec-overlay-bg"></view>
    <view class="rec-overlay-content">
      <view class="rec-anim">
        <view class="rec-ring rec-ring-1"></view>
        <view class="rec-ring rec-ring-2"></view>
        <view class="rec-ring rec-ring-3"></view>
        <ficon class="rec-mic-icon" name="mic" size="72" color="#fff" />
      </view>
      <text class="rec-status-text">正在录音</text>
      <text class="rec-time">{{recSeconds}}s</text>
      <text class="rec-hint-text">松开手指结束</text>
      <view class="rec-wave-large">
        <view class="rec-wave-bar" style="height:20rpx"></view>
        <view class="rec-wave-bar" style="height:36rpx"></view>
        <view class="rec-wave-bar" style="height:28rpx"></view>
        <view class="rec-wave-bar" style="height:44rpx"></view>
        <view class="rec-wave-bar" style="height:32rpx"></view>
        <view class="rec-wave-bar" style="height:40rpx"></view>
        <view class="rec-wave-bar" style="height:24rpx"></view>
      </view>
    </view>
  </view>
  <!-- 转写中遮罩 -->
  <view class="transcribing-overlay" wx:if="{{transcribing}}">
    <view class="transcribing-bg"></view>
    <view class="transcribing-content">
      <view class="transcribing-spinner"></view>
      <text class="transcribing-text">语音转写中...</text>
    </view>
  </view>
  <!-- 转写结果预览遮罩 -->
  <view class="preview-overlay" wx:if="{{showPreview}}" catchtap="onDismissPreview">
    <view class="preview-content" catchtap="noop">
      <view class="preview-title"><ficon style="vertical-align:-6rpx;margin-right:8rpx" name="mic" size="30" color="#4A90D9" /> 语音识别结果</view>
      <text class="preview-text">{{transcriptPreview}}</text>
      <view class="preview-actions">
        <button class="btn-sm btn-outline" bindtap="onCopyTranscript"><ficon style="vertical-align:-4rpx;margin-right:6rpx" name="copy" size="26" color="#4A90D9" /> 复制</button>
        <button class="btn-sm btn-danger" bindtap="onDismissPreview">取消</button>
        <button class="btn-sm btn-primary" bindtap="onConfirmPreview">确认使用</button>
      </view>
    </view>
  </view>
</view>
