<view class="bind-page">
  <view class="bind-header">
    <view class="bind-icon">🏠</view>
    <view class="bind-title">绑定家庭</view>
    <view class="bind-desc">输入管理员给你的家庭入口口令，即可加入家庭</view>
  </view>

  <view class="bind-card">
    <view class="bind-input-wrap">
      <text class="bind-input-label">家庭入口口令</text>
      <textarea class="bind-input" placeholder="请输入口令" placeholder-class="bind-placeholder"
                type="text" maxlength="-1" bindinput="onPasscodeInput" auto-height />
    </view>
    <button class="bind-btn {{loading ? 'btn-loading' : ''}}" bindtap="onBind" hover-class="none">
      {{loading ? '绑定中...' : '绑定并登录'}}
    </button>

    <view class="bind-divider">
      <view class="bind-divider-line"></view>
      <text class="bind-divider-text">或</text>
      <view class="bind-divider-line"></view>
    </view>

    <button class="bind-btn-secondary" bindtap="onShowCreate">创建新家庭</button>
  </view>

  <!-- 创建家庭弹窗 -->
  <view class="modal" wx:if="{{showCreate}}">
    <view class="modal-mask" bindtap="onCancelCreate"></view>
    <view class="modal-panel">
      <view class="modal-head">
        <text class="modal-title">创建新家庭</text>
        <text class="modal-close" bindtap="onCancelCreate">×</text>
      </view>
      <view class="modal-desc">创建后将自动成为家庭管理员</view>
      <textarea class="bind-input" placeholder="家庭名称（如：郑家）" placeholder-class="bind-placeholder"
                type="text" maxlength="-1" bindinput="onFamilyNameInput" auto-height />
      <view class="modal-actions">
        <button class="bind-btn {{loading ? 'btn-loading' : ''}}" bindtap="onCreateFamily" hover-class="none">{{loading ? '创建中...' : '创建'}}</button>
      </view>
    </view>
  </view>

  <view class="bind-footer" bindtap="onBack">
    <text>返回登录</text>
  </view>
</view>
