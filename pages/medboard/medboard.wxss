/* pages/medboard/medboard.wxss - 仿真药板 */
.medboard-page {
  padding: 24rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}
.mb-state {
  text-align: center;
  color: var(--text-tertiary);
  padding: 120rpx 0;
  font-size: 28rpx;
}

/* 药品信息头 */
.med-header {
  background: linear-gradient(135deg, #4A90D9, #5B8DEF);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.med-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.med-name {
  font-size: 34rpx;
  font-weight: 600;
}
.med-note {
  font-size: 24rpx;
  opacity: 0.85;
  margin-left: 8rpx;
}
.med-sched {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 6rpx;
  margin-left: 40rpx;
}
/* 打卡成功弹跳动效 */
.hole-pop {
  animation: holepop 0.55s ease;
}
@keyframes holepop {
  0% { transform: scale(0.6); }
  55% { transform: scale(1.18); }
  100% { transform: scale(1); }
}
.progress-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
}
.progress-label {
  font-size: 28rpx;
  font-weight: 600;
}
.box-remaining {
  font-size: 22rpx;
  opacity: 0.85;
}
.progress-bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.3);
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #fff;
  transition: width 0.3s ease;
}

/* 今日时段 + 对比切换 */
.slots-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.slots {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  display: flex;
  flex-wrap: nowrap;
}
.slot-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: var(--bg-card, #fff);
  border: 2rpx solid var(--border, #E2E8F0);
  color: var(--text-secondary, #475569);
}
.slot-chip + .slot-chip {
  margin-left: 12rpx;
}
.slot-chip.slot-taken {
  background: rgba(16, 185, 129, 0.12);
  border-color: rgba(16, 185, 129, 0.4);
  color: #10B981;
  font-weight: 600;
}
.slot-check {
  font-size: 22rpx;
  font-weight: 700;
}
.compare-switch {
  display: flex;
  background: var(--bg-page, #F1F5F9);
  border-radius: 999rpx;
  padding: 4rpx;
  flex-shrink: 0;
}
.cs-item {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--text-tertiary, #94A3B8);
}
.cs-item.cs-active {
  background: var(--bg-card, #fff);
  color: var(--color-primary, #4A90D9);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(15, 42, 86, 0.08);
}

/* 版 tab */
.board-tabs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}
.board-tab {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 26rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  background: var(--bg-card, #fff);
  border: 2rpx solid var(--border, #E2E8F0);
  color: var(--text-secondary, #475569);
}
.board-tab.bt-active {
  border-color: var(--color-primary, #4A90D9);
  color: var(--color-primary, #4A90D9);
  background: rgba(74, 144, 217, 0.08);
  font-weight: 600;
}
.bt-count {
  font-size: 22rpx;
  color: var(--text-tertiary, #94A3B8);
}
.board-tab.bt-active .bt-count {
  color: var(--color-primary, #4A90D9);
}
/* 当前正在吃的版徽标 */
.bt-current {
  font-size: 18rpx;
  line-height: 1;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(16, 185, 129, 0.14);
  color: #059669;
  font-weight: 600;
}
.board-reset {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 26rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  background: rgba(16, 185, 129, 0.10);
  border: 2rpx solid rgba(16, 185, 129, 0.45);
  color: #10B981;
  font-weight: 600;
}

/* 初始化覆盖层 */
.init-overlay {
  position: sticky;
  top: 0;
  z-index: 10;
  background: linear-gradient(135deg, #059669 0%, #10B981 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.25);
}
.init-overlay-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.init-overlay-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.init-overlay-icon {
  font-size: 40rpx;
  line-height: 1;
}
.init-overlay-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}
.init-overlay-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}
.init-overlay-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}
.init-overlay-actions {
  display: flex;
  gap: 14rpx;
  flex-shrink: 0;
}
.init-btn-cancel {
  padding: 14rpx 28rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-weight: 600;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
}
.init-btn-confirm {
  padding: 14rpx 32rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  background: #fff;
  color: #059669;
  font-weight: 700;
}
.init-overlay-hint {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
}
/* 初始化模式内各版切换 tab */
.init-board-tabs {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.init-board-tab {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  color: #fff;
}
.init-board-tab.ibt-active {
  background: #fff;
  border-color: #fff;
  color: #059669;
  font-weight: 700;
}
.ibt-count {
  font-size: 20rpx;
  opacity: 0.75;
}

/* 初始化模式药丸 */
.init-pill {
  opacity: 0.85;
}
.init-hole {
  background: rgba(16, 185, 129, 0.22);
  border-color: rgba(16, 185, 129, 0.75);
  border-style: dashed;
  flex-direction: column;
  gap: 2rpx;
}
.init-hole-check {
  color: #059669;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}
.init-hole-text {
  color: #059669;
  font-size: 20rpx;
  font-weight: 700;
}
.init-overlay-hint-page {
  margin: 16rpx 4rpx 0;
  padding: 0;
  border-top: none;
  color: var(--text-tertiary, #94A3B8);
  text-align: center;
}

/* 铝箔药板 */
.blister {
  background: linear-gradient(160deg, #F8FAFC, #EEF2F7);
  border: 2rpx solid var(--border, #E2E8F0);
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  box-shadow: inset 0 2rpx 12rpx rgba(15, 42, 86, 0.05);
  overflow: hidden;
}
.blister-row {
  display: flex;
  min-width: 0;
}
.cell {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 130rpx;
}

/* 药丸（形状） */
.pill {
  position: relative;
  box-shadow: inset 0 -6rpx 10rpx rgba(0, 0, 0, 0.12), inset 0 4rpx 8rpx rgba(255, 255, 255, 0.55), 0 4rpx 8rpx rgba(15, 42, 86, 0.15);
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}
.shape-round {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}
.shape-oval {
  width: 108rpx;
  height: 68rpx;
  border-radius: 34rpx;
}
.shape-capsule {
  width: 120rpx;
  height: 54rpx;
  border-radius: 27rpx;
}
.shape-square {
  width: 88rpx;
  height: 88rpx;
  border-radius: 14rpx;
}
.capsule-line {
  position: absolute;
  left: 50%;
  top: 10%;
  bottom: 10%;
  width: 2rpx;
  background: rgba(0, 0, 0, 0.14);
  transform: translateX(-50%);
}

/* 已服缺口（铝箔凹槽） */
.pill-hole {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(15, 42, 86, 0.06);
  border: 3rpx dashed rgba(100, 116, 139, 0.35);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hole-text {
  font-size: 34rpx;
  font-weight: 700;
  color: rgba(100, 116, 139, 0.55);
}

.board-hint {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-tertiary, #94A3B8);
  margin-top: 20rpx;
}

/* 非服药日：药板禁用态 */
.blister-rest {
  opacity: 0.5;
  filter: saturate(0.35);
  pointer-events: none;
}
.board-hint-rest {
  color: #7C93B4;
}

/* 今日前后对比（双板，紧凑头） */
.compare-card {
  /* 容器：紧凑头部 + 上下两块小板 */
}
.compare-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 22rpx;
  margin-bottom: 12rpx;
}
.ch-before {
  color: var(--text-secondary, #475569);
  font-weight: 600;
}
.ch-after {
  color: #10B981;
  font-weight: 600;
}
.cmp-gap {
  margin-top: 16rpx;
}
.blister-mini {
  padding: 18rpx 14rpx;
}
.blister-mini .cell {
  height: 88rpx;
}
.blister-mini .shape-round,
.blister-mini .shape-square,
.blister-mini .pill-hole {
  width: 58rpx;
  height: 58rpx;
}
.blister-mini .shape-oval {
  width: 72rpx;
  height: 46rpx;
  border-radius: 23rpx;
}
.blister-mini .shape-capsule {
  width: 80rpx;
  height: 36rpx;
  border-radius: 18rpx;
}
.blister-mini .hole-text {
  font-size: 24rpx;
}
.blister-after {
  border-color: rgba(16, 185, 129, 0.35);
}

/* 今日服用的缺口高亮 */
.hole-today {
  background: rgba(16, 185, 129, 0.12);
  border-color: rgba(16, 185, 129, 0.65);
  position: relative;
}
.hole-today .hole-text {
  color: #10B981;
}
.hole-today-tag {
  position: absolute;
  top: -10rpx;
  right: -12rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 999rpx;
  background: #10B981;
  color: #fff;
  font-size: 18rpx;
  text-align: center;
  padding: 0 4rpx;
  box-sizing: border-box;
}

/* 近 7 天依从性 */
.week-card {
  background: var(--bg-card, #fff);
  border: 2rpx solid var(--border, #E2E8F0);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-top: 24rpx;
}
.week-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #0F172A);
  margin-bottom: 18rpx;
}
.week-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.week-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.week-day {
  width: 80rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #475569);
  flex-shrink: 0;
}
.week-bar {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--bg-page, #F1F5F9);
  overflow: hidden;
}
.week-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--color-primary, #4A90D9);
  transition: width 0.3s ease;
}
.week-bar-fill.wbf-full {
  background: #10B981;
}
.week-bar-fill.wbf-none {
  background: rgba(100, 116, 139, 0.3);
}
.week-count {
  width: 64rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-tertiary, #94A3B8);
  flex-shrink: 0;
}

/* 7 天汇总（头部） */
.week-summary {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}
.ws-item {
  font-size: 22rpx;
  opacity: 0.9;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

/* 今日打卡时间线 */
.timeline-card {
  background: var(--bg-card, #fff);
  border: 2rpx solid var(--border, #E2E8F0);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-top: 24rpx;
}
.tl-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 0;
}
.tl-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #10B981;
  flex-shrink: 0;
}
.tl-time {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary, #0F172A);
  width: 90rpx;
}
.tl-by {
  font-size: 24rpx;
  color: var(--text-secondary, #475569);
}
.tl-pos {
  font-size: 22rpx;
  color: var(--text-tertiary, #94A3B8);
  margin-left: auto;
}
.tl-empty {
  font-size: 24rpx;
  color: var(--text-tertiary, #94A3B8);
  text-align: center;
  padding: 10rpx 0 6rpx;
}

/* 今日缺口出现动画 */
.hole-today {
  animation: holeIn 0.35s ease;
}
@keyframes holeIn {
  from { transform: scale(1.35); opacity: 0.3; }
  to { transform: scale(1); opacity: 1; }
}

/* 非服药日横幅 */
.rest-banner {
  margin-top: 12rpx;
  background: rgba(74, 144, 217, 0.16);
  border: 2rpx dashed rgba(74, 144, 217, 0.45);
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #3D7EC2;
  text-align: center;
}

/* SSE 断线黄条 */
.rt-banner {
  background: #FEF3C7;
  color: #92400E;
  font-size: 24rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

/* 昨天补记按钮 */
.week-catchup {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #4A90D9;
  border: 2rpx solid #4A90D9;
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
}

/* 本月依从热力图 */
.month-card {
  background: var(--bg-card, #fff);
  border-radius: var(--radius-lg, 24rpx);
  padding: 24rpx;
  margin-top: 20rpx;
}
.month-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}
.mg-blank {
  width: calc((100% - 60rpx) / 7);
  height: 72rpx;
}
.mg-cell {
  width: calc((100% - 60rpx) / 7);
  height: 72rpx;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.mg-num {
  font-size: 22rpx;
  line-height: 1.1;
}
.mg-mark {
  font-size: 18rpx;
  line-height: 1.1;
}
.mg-full { background: #D1FAE5; color: #065F46; }
.mg-full .mg-mark { color: #059669; }
.mg-part { background: #FEF9C3; color: #854D0E; }
.mg-due { background: #FEE2E2; color: #991B1B; }
.mg-off { background: var(--bg-page, #F1F5F9); color: var(--text-tertiary, #94A3B8); }
.mg-future { background: transparent; color: var(--text-tertiary, #CBD5E1); }
.month-legend {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}
.lg-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: var(--text-tertiary, #94A3B8);
}
.lg-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 6rpx;
}
.lg-full { background: #D1FAE5; }
.lg-part { background: #FEF9C3; }
.lg-due { background: #FEE2E2; }
.lg-off { background: #F1F5F9; }
