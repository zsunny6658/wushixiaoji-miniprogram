<view class="medboard-page">
  <!-- 加载/错误态 -->
  <view class="mb-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  <view class="mb-state" wx:elif="{{error}}">
    <text>{{error}}</text>
  </view>

  <block wx:if="{{!loading && !error}}">
    <!-- SSE 断线提示 -->
    <view class="rt-banner" wx:if="{{rtOff}}">⚡ 实时同步已断开，正在重连…（家人打卡可能延迟显示）</view>
    <!-- 药品信息头 -->
    <view class="med-header">
      <view class="med-title-row">
        <ficon name="pill" size="32" color="#10B981" />
        <text class="med-name">{{pkg.code}}</text>
        <text class="med-note" wx:if="{{pkg.note}}">{{pkg.note}}</text>
      </view>
      <view class="med-progress">
        <view class="rest-banner" wx:if="{{!dueToday}}">🌙 今日非服药日 · 好好休息</view>
        <view class="progress-head">
          <text class="progress-label">今日已服 {{todayTaken}}/{{todayTotal}}</text>
          <text class="box-remaining">盒内剩余 {{boxRemaining}} 颗</text>
        </view>
        <view class="progress-bar">
          <view class="progress-fill" style="width:{{todayPercent}}%"></view>
        </view>
        <view class="week-summary" wx:if="{{weekDays.length}}">
          <text class="ws-item">7 天依从率 {{weekRate}}%</text>
          <text class="ws-item" wx:if="{{streak > 0}}">连续达标 {{streak}} 天 🔥</text>
        </view>
      </view>
    </view>

    <!-- 今日时段 + 对比切换 -->
    <view class="slots-row">
      <scroll-view class="slots" scroll-x enable-flex="{{true}}">
        <view class="slot-chip {{item.taken ? 'slot-taken' : ''}}" wx:for="{{slots}}" wx:key="index">
          <text>{{item.time}}</text>
          <text class="slot-check" wx:if="{{item.taken}}">✓</text>
        </view>
      </scroll-view>
      <view class="compare-switch">
        <view class="cs-item {{compare === 'current' ? 'cs-active' : ''}}" bindtap="onCompareToggle" data-mode="current">当前</view>
        <view class="cs-item {{compare === 'today' ? 'cs-active' : ''}}" bindtap="onCompareToggle" data-mode="today">今日对比</view>
        <view class="cs-item {{compare === 'full' ? 'cs-active' : ''}}" bindtap="onCompareToggle" data-mode="full">满版</view>
      </view>
    </view>

    <!-- 版 tab -->
    <view class="board-tabs">
      <view class="board-tab {{boardNo === item.no ? 'bt-active' : ''}}" wx:for="{{boards}}" wx:key="no" bindtap="onBoardTap" data-no="{{item.no}}">
        <text>第{{item.no}}版</text>
        <text class="bt-count">{{item.taken}}/{{item.cap}}</text>
      </view>
    </view>

    <!-- 今日前后对比（双板，紧凑头） -->
    <view class="compare-card" wx:if="{{compare === 'today'}}">
      <view class="compare-head">
        <text class="ch-before">上 · 今天之前</text>
        <text class="ch-after">下 · 现在，绿「今」= 今日已服</text>
      </view>
      <view class="blister blister-mini">
        <view class="blister-row" wx:for="{{compareRows}}" wx:for-item="row" wx:for-index="ri" wx:key="ri">
          <view class="cell" wx:for="{{row}}" wx:for-item="cell" wx:key="index">
            <view wx:if="{{cell.showPill}}" class="pill shape-{{pillShape}}" style="{{pillStyleMini}}background:{{colorHex}}">
              <view wx:if="{{pillShape === 'capsule'}}" class="capsule-line"></view>
            </view>
            <view wx:else class="pill-hole" style="{{holeStyleMini}}">
              <text class="hole-text">{{cell.holeText}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="blister blister-mini blister-after {{!dueToday ? 'blister-rest' : ''}} cmp-gap">
        <view class="blister-row" wx:for="{{rows}}" wx:for-item="row" wx:for-index="ri" wx:key="ri">
          <view class="cell" wx:for="{{row}}" wx:for-item="cell" wx:key="index">
            <view
              wx:if="{{cell.showPill}}"
              class="pill shape-{{pillShape}}"
              style="{{pillStyleMini}}background:{{colorHex}}"
              bindtap="onPillTap"
              data-board="{{cell.boardNo}}"
              data-pill="{{cell.index}}"
              data-taken="{{cell.taken}}"
            >
              <view wx:if="{{pillShape === 'capsule'}}" class="capsule-line"></view>
            </view>
            <view
              wx:else
              class="pill-hole {{cell.isToday ? 'hole-today' : ''}}"
              style="{{holeStyleMini}}"
              bindtap="onTodayHoleTap"
              data-board="{{cell.boardNo}}"
              data-pill="{{cell.index}}"
              data-today="{{cell.isToday}}"
              data-logid="{{cell.todayLogId}}"
            >
              <text class="hole-text">{{cell.holeText}}</text>
              <text class="hole-today-tag" wx:if="{{cell.isToday}}">今</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 单板（当前 / 满版） -->
    <view class="blister {{!dueToday ? 'blister-rest' : ''}}" wx:else>
      <view class="blister-row" wx:for="{{rows}}" wx:for-item="row" wx:for-index="ri" wx:key="ri">
        <view class="cell" wx:for="{{row}}" wx:for-item="cell" wx:key="index">
          <view
            wx:if="{{cell.showPill}}"
            class="pill shape-{{pillShape}}"
            style="{{pillStyle}}background:{{colorHex}}"
            bindtap="onPillTap"
            data-board="{{cell.boardNo}}"
            data-pill="{{cell.index}}"
            data-taken="{{cell.taken}}"
          >
            <view wx:if="{{pillShape === 'capsule'}}" class="capsule-line"></view>
          </view>
          <view
            wx:else
            class="pill-hole {{cell.isToday ? 'hole-today' : ''}}"
            style="{{holeStyle}}"
            bindtap="onTodayHoleTap"
            bindlongpress="onCellLongPress"
            data-board="{{cell.boardNo}}"
            data-pill="{{cell.index}}"
            data-taken="{{cell.taken}}"
            data-today="{{cell.isToday}}"
            data-logid="{{cell.todayLogId}}"
          >
            <text class="hole-text">{{cell.holeText}}</text>
            <text class="hole-today-tag" wx:if="{{cell.isToday}}">今</text>
          </view>
        </view>
      </view>
    </view>
    <view class="board-hint board-hint-rest" wx:if="{{!dueToday}}">今日非服药日 · 药板仅供参考，明晚见 🌙</view>
    <view class="board-hint" wx:elif="{{compare !== 'today'}}">点击任意药丸记录服药（无需按顺序）· 长按缺口撤销今日打卡</view>

    <!-- 今日打卡时间线 -->
    <view class="timeline-card">
      <view class="week-title">今日打卡记录</view>
      <block wx:if="{{timeline.length}}">
        <view class="tl-item" wx:for="{{timeline}}" wx:key="id">
          <view class="tl-dot"></view>
          <text class="tl-time">{{item.time}}</text>
          <text class="tl-by">{{item.by}}</text>
          <text class="tl-pos">{{item.pos}}</text>
        </view>
      </block>
      <view class="tl-empty" wx:else>今日还未打卡 · 点击上方药丸记录第一次服药</view>
    </view>

    <!-- 近 7 天依从性 -->
    <view class="week-card" wx:if="{{weekDays.length}}">
      <view class="week-title">近 7 天服药情况</view>
      <view class="week-list">
        <view class="week-item" wx:for="{{weekDays}}" wx:key="date">
          <text class="week-day">{{item.label}}</text>
          <view class="week-bar">
            <view class="week-bar-fill {{item.full ? 'wbf-full' : (item.none ? 'wbf-none' : '')}}" style="width:{{item.percent}}%"></view>
          </view>
          <text class="week-count">{{item.taken}}/{{item.total}}</text>
          <text class="week-catchup" wx:if="{{item.catchable}}" catchtap="onWeekCatchup" data-date="{{item.date}}">补记</text>
        </view>
      </view>
    </view>

    <!-- 本月依从热力图 -->
    <view class="month-card" wx:if="{{monthCells.length}}">
      <view class="week-title">{{monthLabel}}依从 {{monthRate}}%</view>
      <view class="month-grid">
        <text class="mg-blank" wx:for="{{monthBlanks}}" wx:key="index"></text>
        <view class="mg-cell mg-{{item.state}}" wx:for="{{monthCells}}" wx:key="d">
          <text class="mg-num">{{item.d}}</text>
          <text class="mg-mark" wx:if="{{item.state === 'full'}}">✓</text>
          <text class="mg-mark" wx:elif="{{item.state === 'part'}}">…</text>
        </view>
      </view>
      <view class="month-legend">
        <text class="lg-item"><view class="lg-dot lg-full"></view>达标</text>
        <text class="lg-item"><view class="lg-dot lg-part"></view>部分</text>
        <text class="lg-item"><view class="lg-dot lg-due"></view>未服</text>
        <text class="lg-item"><view class="lg-dot lg-off"></view>休息日</text>
      </view>
    </view>
  </block>
</view>
