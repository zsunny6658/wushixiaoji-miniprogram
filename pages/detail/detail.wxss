/* pages/detail/detail.wxss - 详情页 */

.detail-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 140rpx;
}

/* 顶部状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, #6C8AFF 100%);
  color: var(--text-white);
  font-size: var(--font-body);
  font-weight: 600;
}
.status-bar.done {
  background: linear-gradient(135deg, var(--color-success) 0%, #4ADE80 100%);
}
.status-icon { font-size: 32rpx; margin-right: 12rpx; }
.status-text { flex: 1; }
.status-right { display: flex; align-items: center; }
.overdue-badge {
  background: var(--color-error);
  color: var(--text-white);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-caption);
  font-weight: 700;
}

/* 主要内容 */
.main-content { padding: var(--spacing-md); }

/* 标题卡片 */
.title-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-1);
  margin-bottom: var(--spacing-md);
}
.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}
.main-value {
  font-size: var(--font-heading);
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
  word-break: break-all;
  letter-spacing: -0.02em;
}
.sub-value {
  font-size: var(--font-body-lg);
  font-weight: 600;
  color: var(--text-secondary);
  margin-top: 8rpx;
  word-break: break-all;
}
.station {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: var(--spacing-sm);
  font-size: var(--font-body);
  color: var(--text-secondary);
  font-weight: 500;
}

/* 原始内容 */
.raw-section {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-1);
  margin-bottom: var(--spacing-md);
}
.raw-title {
  font-size: var(--font-body-sm);
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}
.raw-content {
  font-size: var(--font-body);
  color: var(--text-primary);
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
  background: var(--bg-page);
  border-radius: var(--radius-sm);
  padding: var(--spacing-sm);
}

/* 信息区 */
.info-section {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-1);
}
.info-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}
.info-row {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
}
.info-label {
  flex-shrink: 0;
  width: 140rpx;
  font-size: var(--font-body-sm);
  color: var(--text-tertiary);
}
.info-value {
  flex: 1;
  font-size: var(--font-body);
  color: var(--text-primary);
  word-break: break-all;
  line-height: 1.5;
}
.info-value.warn {
  color: var(--color-error);
  font-weight: 600;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: var(--spacing-sm);
  padding: var(--spacing-sm) var(--spacing-md);
  padding-bottom: calc(var(--spacing-sm) + env(safe-area-inset-bottom));
  background: var(--bg-card);
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  z-index: 100;
}
.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 16rpx 0;
  border: none;
  border-radius: var(--radius-md);
  font-size: var(--font-caption);
  color: var(--text-secondary);
  background: var(--bg-hover);
  transition: all 0.15s;
}
.action-btn:active { transform: scale(0.97); }
.action-btn::after { border: none; }
.action-icon { font-size: 36rpx; line-height: 1; }
.action-copy { background: var(--color-info-light); color: var(--color-info); }
.action-edit { background: var(--color-primary-light); color: var(--color-primary); }
.action-delete { background: var(--color-error-light); color: var(--color-error); }
.action-main {
  flex: 1.5;
  background: linear-gradient(135deg, var(--color-primary) 0%, #6C8AFF 100%);
  color: var(--text-white);
  font-weight: 700;
}
.action-unpick {
  background: linear-gradient(135deg, var(--text-tertiary) 0%, var(--text-disabled) 100%);
}
