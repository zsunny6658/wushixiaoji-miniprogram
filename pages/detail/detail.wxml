<view class="detail-page">
  <!-- 顶部状态栏 -->
  <view class="status-bar {{pkg.status === 'picked' ? 'done' : ''}} {{pkg.status === 'ignored' ? 'ignored' : ''}} {{pkg.status === 'archived' ? 'archived' : ''}}">
    <text class="status-icon">{{pkg.status === 'picked' ? '✅' : (pkg.status === 'ignored' ? '🚫' : (pkg.status === 'archived' ? '📦' : '⏳'))}}</text>
    <text class="status-text">{{pkg.status === 'picked' ? '已完成' : (pkg.status === 'ignored' ? '已忽略' : (pkg.status === 'archived' ? '已归档' : '待处理'))}}</text>
    <view class="status-right" wx:if="{{pkg.overdue && pkg.status !== 'ignored' && pkg.status !== 'picked' && pkg.status !== 'archived'}}">
      <text class="overdue-badge">逾期</text>
    </view>
  </view>
  <!-- 忽略自动删除提示 -->
  <view class="ignore-notice" wx:if="{{pkg.status === 'ignored'}}">
    <text class="ignore-notice-icon">🗑️</text>
    <text class="ignore-notice-text">已忽略，{{pkg.ignoreDeleteLabel}}</text>
  </view>
  <!-- 归档提示 -->
  <view class="archive-notice" wx:if="{{pkg.status === 'archived'}}">
    <text class="archive-notice-icon">📦</text>
    <text class="archive-notice-text">已归档，可恢复</text>
  </view>

  <!-- 主要内容 -->
  <view class="main-content">
    <!-- 标题卡片 -->
    <view class="title-card">
      <view class="title-row">
        <text class="type-badge {{pkg.type}}">{{pkg.type === 'pickup' ? '📦 取件' : (pkg.type === 'debt' ? '💳 待还' : '📝 备忘')}}</text>
        <text class="private-badge" wx:if="{{pkg.isPrivate}}">🔒 个人</text>
        <text class="occ-badge" wx:if="{{pkg.occCount > 1}}">×{{pkg.occCount}}</text>
        <text class="tag-badge" wx:if="{{pkg.tagLabel}}">{{pkg.tagLabel}}</text>
      </view>
      <view class="main-value">{{pkg.title || pkg.code}}</view>
      <view class="sub-value" wx:if="{{pkg.type === 'pickup'}}">{{pkg.code}}</view>
      <view class="station" wx:if="{{pkg.type === 'pickup' && pkg.station}}">
        <text class="station-icon">📍</text>
        <text>{{pkg.station}}</text>
      </view>
      <view class="debt-amount" wx:if="{{pkg.type === 'debt' && pkg.amount}}">
        <text class="debt-amount-label">还款金额</text>
        <text class="debt-amount-value">¥{{pkg.amountLabel}}</text>
      </view>
    </view>

    <!-- 内容区 (todo/debt 的完整内容) -->
    <view class="content-section" wx:if="{{pkg.type === 'todo' || pkg.type === 'debt'}}">
      <view class="content-title">{{pkg.type === 'debt' ? '💳 待还款项' : '📝 备忘内容'}}</view>
      <view class="content-text">{{pkg.code}}</view>
      <view class="debt-institution" wx:if="{{pkg.type === 'debt' && pkg.institution}}">
        <text class="debt-inst-label">金融机构</text>
        <text class="debt-inst-value">{{pkg.institution}}</text>
      </view>
    </view>

    <!-- 原始内容 -->
    <view class="raw-section" wx:if="{{pkg.raw}}">
      <view class="raw-title">📋 原始内容</view>
      <view class="raw-content">{{pkg.raw}}</view>
    </view>

    <!-- 详情信息 -->
    <view class="info-section">
      <view class="section-title">详情</view>
      <view class="info-list">
        <view class="info-row" wx:if="{{pkg.type === 'pickup' && pkg.company}}">
          <text class="info-label">🚚 公司</text>
          <text class="info-value">{{pkg.company}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.type === 'debt' && pkg.dueDate}}">
          <text class="info-label">📅 还款期限</text>
          <text class="info-value {{pkg.dueDays ? 'warn' : ''}}">{{pkg.dueDate}} {{pkg.dueDays ? '(' + pkg.dueDays + ')' : ''}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.trackingNo}}">
          <text class="info-label">🔢 单号</text>
          <text class="info-value mono">{{pkg.trackingNo}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">🕐 时间</text>
          <text class="info-value {{pkg.overdue ? 'warn' : ''}}">{{pkg.arrivedLabel}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.type === 'pickup'}}">
          <text class="info-label">📦 驿站</text>
          <text class="info-value">{{pkg.station || '—'}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.initiator}}">
          <text class="info-label">👤 发起人</text>
          <text class="info-value">{{pkg.initiator}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.assignee}}">
          <text class="info-label">📋 待办人</text>
          <text class="info-value">{{pkg.assignee}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.createdBy}}">
          <text class="info-label">🏷️ 创建</text>
          <text class="info-value">{{pkg.createdBy === 'cli' ? 'CLI' : pkg.createdBy === 'webhook' ? 'Webhook' : '手动'}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.source}}">
          <text class="info-label">📡 来源</text>
          <text class="info-value mono">{{pkg.source}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.importance}}">
          <text class="info-label">⚖️ 重要</text>
          <text class="info-value">{{pkg.impLabel}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.urgency}}">
          <text class="info-label">⚡ 紧迫</text>
          <text class="info-value">{{pkg.urgLabel}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.note}}">
          <text class="info-label">📝 备注</text>
          <text class="info-value">{{pkg.note}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.status === 'picked' && pkg.pickedBy}}">
          <text class="info-label">✅ 完成</text>
          <text class="info-value">{{pkg.pickedBy}} {{pkg.pickedAtLabel}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <button class="action-btn action-flag {{pkg.importance === 'high' ? 'action-flag-active' : ''}}" bindtap="onToggleFlag">
      <ficon class="action-icon-vec" name="flag" size="34" color="{{pkg.importance === 'high' ? '#EF5350' : '#718096'}}" />
      <text>{{pkg.importance === 'high' ? '取消重点' : '标重点'}}</text>
    </button>
    <button class="action-btn action-edit" bindtap="onEdit">
      <ficon class="action-icon-vec" name="edit" size="34" color="#718096" />
      <text>编辑</text>
    </button>
    <button class="action-btn action-ignore {{pkg.status === 'ignored' ? 'action-ignored' : ''}}" bindtap="onToggleIgnore" wx:if="{{pkg.status !== 'archived'}}">
      <ficon class="action-icon-vec" name="belloff" size="34" color="#718096" />
      <text>{{pkg.status === 'ignored' ? '恢复' : '忽略'}}</text>
    </button>
    <button class="action-btn action-main {{pkg.status === 'picked' ? 'action-unpick' : ''}}" bindtap="onTogglePick" wx:if="{{pkg.status !== 'archived'}}">
      <ficon class="action-icon-vec" name="check-circle" size="34" color="#FFFFFF" />
      <text>{{pkg.status === 'picked' ? '撤销' : '完成'}}</text>
    </button>
    <button class="action-btn action-more" bindtap="onMoreActions">
      <ficon class="action-icon-vec" name="copy" size="34" color="#718096" />
      <text>更多</text>
    </button>
  </view>
</view>
