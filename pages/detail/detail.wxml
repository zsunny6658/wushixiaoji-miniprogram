<view class="detail-page">
  <!-- 顶部状态栏 -->
  <view class="status-bar {{pkg.status === 'picked' ? 'done' : ''}} {{pkg.status === 'ignored' ? 'ignored' : ''}} {{pkg.status === 'archived' ? 'archived' : ''}}">
    <ficon class="status-icon" name="{{pkg.status === 'picked' ? 'check-circle' : (pkg.status === 'ignored' ? 'slash' : (pkg.status === 'archived' ? 'archive' : 'clock'))}}" size="48" color="#fff" />
    <text class="status-text">{{pkg.status === 'picked' ? '已完成' : (pkg.status === 'ignored' ? '已忽略' : (pkg.status === 'archived' ? '已归档' : '待处理'))}}</text>
    <view class="status-right" wx:if="{{pkg.overdue && pkg.status !== 'ignored' && pkg.status !== 'picked' && pkg.status !== 'archived'}}">
      <text class="overdue-badge">逾期</text>
    </view>
  </view>
  <!-- 忽略自动删除提示 -->
  <view class="ignore-notice" wx:if="{{pkg.status === 'ignored'}}">
    <ficon class="ignore-notice-icon" name="trash" size="32" color="#9CA3AF" />
    <text class="ignore-notice-text">已忽略，{{pkg.ignoreDeleteLabel}}</text>
  </view>
  <!-- 归档提示 -->
  <view class="archive-notice" wx:if="{{pkg.status === 'archived'}}">
    <ficon class="archive-notice-icon" name="archive" size="32" color="#F59E0B" />
    <text class="archive-notice-text">已归档，可恢复</text>
  </view>

  <!-- 主要内容 -->
  <view class="main-content">
    <!-- 标题卡片 -->
    <view class="title-card">
      <view class="title-row">
        <view class="type-badge {{pkg.type}}"><ficon wx:if="{{pkg.type === 'pickup'}}" style="vertical-align:-5rpx;margin-right:6rpx" name="box" size="24" color="#4A90D9" /><ficon wx:elif="{{pkg.type === 'debt'}}" style="vertical-align:-5rpx;margin-right:6rpx" name="creditcard" size="24" color="#EF4444" /><ficon wx:elif="{{pkg.type === 'medication'}}" style="vertical-align:-5rpx;margin-right:6rpx" name="pill" size="24" color="#10B981" /><ficon wx:else style="vertical-align:-5rpx;margin-right:6rpx" name="clipboard" size="24" color="#F59E0B" /> {{pkg.type === 'pickup' ? '取件' : (pkg.type === 'debt' ? '待还' : (pkg.type === 'medication' ? '用药' : '备忘'))}}</view>
        <view class="private-badge" wx:if="{{pkg.isPrivate}}"><ficon style="vertical-align:-5rpx;margin-right:6rpx" name="lock" size="24" color="#64748B" /> 个人</view>
        <text class="occ-badge" wx:if="{{pkg.occCount > 1}}">×{{pkg.occCount}}</text>
        <text class="tag-badge" wx:if="{{pkg.tagLabel}}">{{pkg.tagLabel}}</text>
      </view>
      <view class="main-value">{{pkg.title || pkg.code}}</view>
      <view class="sub-value" wx:if="{{pkg.type === 'pickup'}}">{{pkg.code}}</view>
      <view class="station" wx:if="{{pkg.type === 'pickup' && pkg.station}}">
        <text class="station-icon">📍</text>
        <text>{{pkg.station}}</text>
      </view>
      <view class="debt-amount" wx:if="{{pkg.type === 'debt' && pkg.amount}}">
        <text class="debt-amount-label">还款金额</text>
        <text class="debt-amount-value">¥{{pkg.amountLabel}}</text>
      </view>
    </view>

    <!-- 内容区 (todo/debt 的完整内容) -->
    <view class="content-section" wx:if="{{pkg.type === 'todo' || pkg.type === 'debt' || pkg.type === 'medication'}}">
      <view class="content-title"><ficon wx:if="{{pkg.type === 'debt'}}" name="creditcard" size="28" color="#EF4444" /><ficon wx:elif="{{pkg.type === 'medication'}}" name="pill" size="28" color="#10B981" /><ficon wx:else name="clipboard" size="28" color="#F59E0B" /> {{pkg.type === 'debt' ? '待还款项' : (pkg.type === 'medication' ? '用药计划' : '备忘内容')}}</view>
      <view class="content-text">{{pkg.code}}</view>
      <view class="debt-institution" wx:if="{{pkg.type === 'debt' && pkg.institution}}">
        <text class="debt-inst-label">金融机构</text>
        <text class="debt-inst-value">{{pkg.institution}}</text>
      </view>
    </view>

    <!-- 仿真药板入口（用药） -->
    <view class="medboard-entry" wx:if="{{pkg.type === 'medication' && pkg.status === 'pending'}}" bindtap="onOpenMedboard">
      <view class="mb-entry-icon"><ficon name="pill" size="36" color="#10B981" /></view>
      <view class="mb-entry-text">
        <text class="mb-entry-title">仿真药板 · 点击打卡</text>
        <text class="mb-entry-sub" wx:if="{{pkg.scheduleLabel}}">每日 {{pkg.scheduleLabel}}</text>
      </view>
      <text class="mb-entry-arrow">›</text>
    </view>

    <!-- 原始内容 -->
    <view class="raw-section" wx:if="{{pkg.raw}}">
      <view class="raw-title"><ficon name="clipboard" size="28" color="#718096" /> 原始内容</view>
      <view class="raw-content">{{pkg.raw}}</view>
    </view>

    <!-- 详情信息 -->
    <view class="info-section">
      <view class="section-title">详情</view>
      <view class="info-list">
        <view class="info-row" wx:if="{{pkg.type === 'pickup' && pkg.company}}">
          <view class="info-label"><ficon style="vertical-align:-5rpx;margin-right:6rpx" name="truck" size="26" color="#718096" /> 公司</view>
          <text class="info-value">{{pkg.company}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.type === 'debt' && pkg.dueDate}}">
          <view class="info-label"><ficon style="vertical-align:-5rpx;margin-right:6rpx" name="calendar" size="26" color="#EF4444" /> 还款期限</view>
          <text class="info-value {{pkg.dueDays ? 'warn' : ''}}">{{pkg.dueDate}} {{pkg.dueDays ? '(' + pkg.dueDays + ')' : ''}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.trackingNo}}">
          <view class="info-label"><ficon style="vertical-align:-5rpx;margin-right:6rpx" name="hash" size="26" color="#718096" /> 单号</view>
          <text class="info-value mono">{{pkg.trackingNo}}</text>
        </view>
        <view class="info-row">
          <view class="info-label"><ficon style="vertical-align:-5rpx;margin-right:6rpx" name="clock" size="26" color="#718096" /> 时间</view>
          <text class="info-value {{pkg.overdue ? 'warn' : ''}}">{{pkg.arrivedLabel}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.type === 'pickup'}}">
          <view class="info-label"><ficon style="vertical-align:-5rpx;margin-right:6rpx" name="box" size="26" color="#4A90D9" /> 驿站</view>
          <text class="info-value">{{pkg.station || '—'}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.scheduleLabel}}">
          <view class="info-label"><ficon style="vertical-align:-5rpx;margin-right:6rpx" name="clock" size="26" color="#10B981" /> 服药时间</view>
          <text class="info-value">{{pkg.scheduleLabel}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.initiator}}">
          <view class="info-label"><ficon style="vertical-align:-5rpx;margin-right:6rpx" name="user" size="26" color="#718096" /> 发起人</view>
          <text class="info-value">{{pkg.initiator}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.assignee}}">
          <view class="info-label"><ficon style="vertical-align:-5rpx;margin-right:6rpx" name="clipboard" size="26" color="#718096" /> 待办人</view>
          <text class="info-value">{{pkg.assignee}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.createdBy}}">
          <view class="info-label"><ficon style="vertical-align:-5rpx;margin-right:6rpx" name="folder" size="26" color="#718096" /> 创建</view>
          <text class="info-value">{{pkg.createdBy === 'cli' ? 'CLI' : pkg.createdBy === 'webhook' ? 'Webhook' : '手动'}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.source}}">
          <view class="info-label"><ficon style="vertical-align:-5rpx;margin-right:6rpx" name="link" size="26" color="#718096" /> 来源</view>
          <text class="info-value mono">{{pkg.source}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.importance}}">
          <view class="info-label"><ficon style="vertical-align:-5rpx;margin-right:6rpx" name="flag" size="26" color="#718096" /> 重要</view>
          <text class="info-value">{{pkg.impLabel}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.urgency}}">
          <view class="info-label"><ficon style="vertical-align:-5rpx;margin-right:6rpx" name="zap" size="26" color="#718096" /> 紧迫</view>
          <text class="info-value">{{pkg.urgLabel}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.note}}">
          <view class="info-label"><ficon style="vertical-align:-5rpx;margin-right:6rpx" name="edit" size="26" color="#718096" /> 备注</view>
          <text class="info-value">{{pkg.note}}</text>
        </view>
        <view class="info-row" wx:if="{{pkg.status === 'picked' && pkg.pickedBy}}">
          <view class="info-label"><ficon name="check-circle" size="26" color="#10B981" /> 完成</view>
          <text class="info-value">{{pkg.pickedBy}} {{pkg.pickedAtLabel}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <button class="action-btn action-flag {{pkg.importance === 'high' ? 'action-flag-active' : ''}}" bindtap="onToggleFlag">
      <ficon class="action-icon-vec" name="flag" size="34" color="{{pkg.importance === 'high' ? '#EF5350' : '#718096'}}" />
      <text>{{pkg.importance === 'high' ? '取消重点' : '标重点'}}</text>
    </button>
    <button class="action-btn action-edit" bindtap="onEdit">
      <ficon class="action-icon-vec" name="edit" size="34" color="#718096" />
      <text>编辑</text>
    </button>
    <button class="action-btn action-ignore {{pkg.status === 'ignored' ? 'action-ignored' : ''}}" bindtap="onToggleIgnore" wx:if="{{pkg.status !== 'archived'}}">
      <ficon class="action-icon-vec" name="belloff" size="34" color="#718096" />
      <text>{{pkg.status === 'ignored' ? '恢复' : '忽略'}}</text>
    </button>
    <button class="action-btn action-main {{pkg.status === 'picked' ? 'action-unpick' : ''}}" bindtap="onTogglePick" wx:if="{{pkg.status !== 'archived'}}">
      <ficon class="action-icon-vec" name="check-circle" size="34" color="#FFFFFF" />
      <text>{{pkg.status === 'picked' ? '撤销' : '完成'}}</text>
    </button>
    <button class="action-btn action-more" bindtap="onMoreActions">
      <ficon class="action-icon-vec" name="copy" size="34" color="#718096" />
      <text>更多</text>
    </button>
  </view>
</view>
