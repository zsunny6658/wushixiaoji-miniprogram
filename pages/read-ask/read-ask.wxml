<view class="qa-page">
  <scroll-view
    class="qa-scroll"
    scroll-y
    scroll-into-view="{{scrollInto}}"
    scroll-with-animation
    style="{{kbHeight ? 'padding-bottom:' + kbHeight + 'px' : ''}}"
  >
    <view class="qa-list">

      <!-- 欢迎 & 建议 -->
      <view class="qa-welcome">
        <view class="qa-welcome-top">
          <view class="qa-welcome-title">基于你的待读知识库回答</view>
          <view class="qa-welcome-acts">
            <view class="qa-act" bindtap="onOpenSessions">对话记录</view>
          </view>
        </view>
        <block wx:if="{{!messages.length}}">
          <view class="qa-welcome-sub">只依据已收藏文章的正文内容，据实回答并标注来源；库里没有的会明说。支持多轮追问。</view>
          <view class="qa-suggests">
            <view class="qa-suggest" wx:for="{{suggestions}}" wx:key="*this" bindtap="onSuggestTap" data-q="{{item}}">{{item}}</view>
          </view>
        </block>
      </view>

      <!-- 消息 -->
      <block wx:for="{{messages}}" wx:key="id">
        <!-- 用户 -->
        <view wx:if="{{item.role === 'user'}}" class="qa-row qa-row-user">
          <view class="qa-bubble qa-bubble-user">{{item.text}}</view>
        </view>

        <!-- AI -->
        <view wx:else class="qa-row qa-row-ai">
          <view class="qa-bubble qa-bubble-ai">
            <text>{{item.text}}{{item.streaming ? ' ▌' : ''}}</text>
            <view wx:if="{{item.streaming && !item.text}}" class="qa-thinking-inline">
              <text class="qa-dot"></text><text class="qa-dot qa-dot2"></text><text class="qa-dot qa-dot3"></text>
              <text class="qa-thinking-text">正在检索知识库…{{elapsed > 0 ? ' ' + elapsed + 's' : ''}}</text>
            </view>
            <view wx:if="{{item.sources.length}}" class="qa-srcs">
              <view class="qa-srcs-label">来源（点标题看引用片段）</view>
              <block
                wx:for="{{item.sources}}"
                wx:for-item="s"
                wx:for-index="sidx"
                wx:key="no"
              >
                <view
                  class="qa-src"
                  bindtap="onSourceTap"
                  data-idx="{{index}}"
                  data-no="{{s.no}}"
                >
                  <text class="qa-src-no">[{{s.no}}]</text>
                  <text class="qa-src-title">{{s.title}}</text>
                  <text class="qa-src-plat">{{s.platformLabel}}</text>
                </view>
                <view wx:if="{{item.openNo === s.no && s.snippet}}" class="qa-src-snippet">
                  <text class="qa-src-snippet-text">{{s.snippet}}</text>
                  <view class="qa-src-open" catchtap="onSourceOpen" data-id="{{s.id}}">查看全文 →</view>
                </view>
              </block>
            </view>
            <view wx:if="{{item.extractive}}" class="qa-note">（降级回答：未配置大模型或生成失败）</view>
            <view wx:if="{{item.text}}" class="qa-copy" bindtap="onCopy" data-text="{{item.text}}">复制回答</view>
          </view>
        </view>
      </block>

      <view id="qa-bottom" class="qa-bottom-anchor"></view>
    </view>
  </scroll-view>

  <!-- 悬浮新对话：有消息时始终可见，一步开新对话 -->
  <view
    wx:if="{{messages.length}}"
    class="qa-newbtn"
    style="{{kbHeight ? 'transform: translateY(-' + kbHeight + 'px)' : ''}}"
    bindtap="onNewSession"
  >＋ 新对话</view>

  <!-- 输入区 -->
  <view
    class="qa-input-bar"
    style="{{kbHeight ? 'transform: translateY(-' + kbHeight + 'px)' : ''}}"
  >
    <view
      class="qa-mic {{recording ? 'on' : ''}}"
      bindtouchstart="onMicStart"
      bindtouchend="onMicEnd"
      bindtouchcancel="onMicEnd"
    >
      <ficon name="mic" size="36" color="{{recording ? '#FFFFFF' : '#8A94A6'}}" />
    </view>
    <input
      class="qa-input"
      value="{{input}}"
      placeholder="{{recording ? '正在聆听，松开转写…' : (transcribing ? '正在转写…' : '问问知识库里的文章…')}}"
      placeholder-class="qa-input-ph"
      confirm-type="send"
      confirm-hold
      adjust-position="{{false}}"
      bindinput="onInput"
      bindconfirm="onSend"
      disabled="{{sending}}"
      maxlength="500"
    />
    <view class="qa-send {{canSend ? 'on' : ''}}" bindtap="onSend">
      <ficon name="send" size="32" color="#FFFFFF" />
    </view>
  </view>

  <!-- 对话记录管理面板（半屏弹层） -->
  <view wx:if="{{showSessions}}" class="qa-mask" bindtap="onCloseSessions">
    <view class="qa-sheet" catchtap="onStopPropagation">
      <view class="qa-sheet-head">
        <text class="qa-sheet-title">对话记录</text>
        <view class="qa-sheet-new" bindtap="onNewSession">＋ 新对话</view>
      </view>
      <scroll-view scroll-y class="qa-sheet-list">
        <view
          wx:for="{{sessions}}"
          wx:key="id"
          class="qa-sess {{item.id === currentId ? 'cur' : ''}}"
          bindtap="onSwitchSession"
          data-id="{{item.id}}"
        >
          <view class="qa-sess-main">
            <view class="qa-sess-title">{{item.title}}</view>
            <view class="qa-sess-meta">{{item.count}} 问 · {{item.timeText}}</view>
          </view>
          <view class="qa-sess-del" catchtap="onDeleteSession" data-id="{{item.id}}">删除</view>
        </view>
        <view wx:if="{{!sessions.length}}" class="qa-sess-empty">暂无历史对话</view>
        <view class="qa-sheet-pad"></view>
      </scroll-view>
    </view>
  </view>
</view>
