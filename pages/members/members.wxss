/* pages/members/members.wxss - 成员管理 */

.container {
  padding: var(--spacing-md);
  min-height: 100vh;
}

/* 头部 */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}
.section-title {
  font-size: var(--font-subtitle);
  font-weight: 700;
  color: var(--text-primary);
}
.section-count {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
}

/* 成员列表 */
.member-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-1);
}
.member-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid var(--border);
}
.member-item:last-child { border-bottom: none; }
.member-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}
.member-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: var(--font-body);
  font-weight: 600;
  flex-shrink: 0;
}
.member-name {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-primary);
}
.member-email {
  font-size: var(--font-caption);
  color: var(--text-secondary);
  margin-top: 2rpx;
}
.member-actions {
  display: flex;
  gap: var(--spacing-xs);
}

/* 添加成员 */
.add-section {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-1);
}
.add-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
  margin-bottom: var(--spacing-sm);
  color: var(--text-primary);
}

/* 口令卡片 */
.passcode-card {
  background: var(--color-success-light);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-top: var(--spacing-md);
  border: 2rpx solid var(--color-success);
}
.passcode-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: #166534;
  margin-bottom: var(--spacing-sm);
}
.passcode-value {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  text-align: center;
  font-size: var(--font-heading);
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #166534;
  margin-bottom: var(--spacing-sm);
}
.passcode-actions {
  display: flex;
  gap: var(--spacing-sm);
}
.passcode-hint {
  font-size: var(--font-caption);
  color: var(--text-secondary);
  margin-top: var(--spacing-sm);
  text-align: center;
}
