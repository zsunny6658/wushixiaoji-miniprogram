/* pages/overview/overview.wxss - 概览页 */

.container {
  padding: var(--spacing-md);
  min-height: 100vh;
}

/* 问候语 */
.greeting {
  margin-bottom: var(--spacing-md);
}
.greeting-text {
  font-size: var(--font-title);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.02em;
}
.greeting-date {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
  margin-top: var(--spacing-xs);
}

/* 统计卡片 */
.stats {
  display: flex;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}
.stat-card {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md) 16rpx;
  text-align: center;
  box-shadow: var(--shadow-1);
  cursor: pointer;
  transition: transform 0.15s;
}
.stat-card:active {
  transform: scale(0.97);
}
.stat-num {
  font-size: var(--font-heading);
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}
.stat-label {
  font-size: var(--font-caption);
  color: var(--text-secondary);
  margin-top: var(--spacing-xs);
}
.s-pickup { border-top: 6rpx solid var(--color-primary); }
.s-pickup .stat-num { color: var(--color-primary); }
.s-todo { border-top: 6rpx solid var(--color-warning); }
.s-todo .stat-num { color: var(--color-warning); }
.s-overdue { border-top: 6rpx solid var(--color-error); }
.s-overdue .stat-num { color: var(--color-error); }
.s-done { border-top: 6rpx solid var(--color-success); }
.s-done .stat-num { color: var(--color-success); }

/* 通用 section */
.section {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-1);
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}
.section-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-primary);
}
.section-count {
  font-size: var(--font-body-sm);
  color: var(--color-primary);
  cursor: pointer;
}

/* 四象限 */
.quad-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}
.quad-box {
  width: calc(50% - var(--spacing-xs));
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 180rpx;
  cursor: pointer;
  transition: transform 0.15s;
}
.quad-box:active {
  transform: scale(0.97);
}
.quad-num {
  font-size: var(--font-display);
  font-weight: 700;
  line-height: 1;
}
.quad-label {
  font-size: var(--font-body-sm);
  margin-top: var(--spacing-xs);
}
.q1 { background: var(--quad-q1-bg); }
.q1 .quad-num { color: var(--quad-q1-num); }
.q1 .quad-label { color: var(--quad-q1-label); }
.q2 { background: var(--quad-q2-bg); }
.q2 .quad-num { color: var(--quad-q2-num); }
.q2 .quad-label { color: var(--quad-q2-label); }
.q3 { background: var(--quad-q3-bg); }
.q3 .quad-num { color: var(--quad-q3-num); }
.q3 .quad-label { color: var(--quad-q3-label); }
.q4 { background: var(--quad-q4-bg); }
.q4 .quad-num { color: var(--quad-q4-num); }
.q4 .quad-label { color: var(--quad-q4-label); }

/* 今日摘要 */
.summary-card {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}
.summary-icon {
  font-size: 56rpx;
}
.summary-body {
  flex: 1;
}
.summary-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-primary);
}
.summary-desc {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
  margin-top: var(--spacing-xs);
  line-height: 1.5;
}
