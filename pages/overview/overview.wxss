/* pages/overview/overview.wxss - 概览页 */

.container {
  padding: var(--spacing-md);
  min-height: 100vh;
}

/* 问候语 */
.greeting {
  margin-bottom: var(--spacing-md);
  background: linear-gradient(135deg, #1E5B3C 0%, #2E7D52 65%, #6FA6F0 100%);
  border-radius: var(--radius-lg);
  padding: 32rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 91, 60, 0.28);
}
.greeting-text {
  font-size: var(--font-title);
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.02em;
}
.greeting-date {
  font-size: var(--font-body-sm);
  color: rgba(255, 255, 255, 0.85);
  margin-top: var(--spacing-xs);
}

/* 统计卡片 */
.stats {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}
.stats-row {
  display: flex;
  gap: var(--spacing-sm);
}
.stat-card {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 20rpx 16rpx;
  text-align: center;
  box-shadow: var(--shadow-1);
  cursor: pointer;
  transition: transform 0.15s;
  border-top: 6rpx solid transparent;
}
.stat-card:active {
  transform: scale(0.97);
}
.stat-icon {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 40rpx;
  line-height: 1;
}
.s-pickup .stat-icon { background: rgba(30, 91, 60, 0.12); }
.s-todo .stat-icon { background: rgba(255, 167, 38, 0.15); }
.s-debt .stat-icon { background: rgba(239, 83, 80, 0.10); }
.s-private .stat-icon { background: rgba(100, 116, 139, 0.14); }
.s-overdue .stat-icon { background: rgba(239, 83, 80, 0.12); }
.s-done .stat-icon { background: rgba(16, 185, 129, 0.12); }
.s-ignored .stat-icon { background: rgba(156, 163, 175, 0.16); }
.stat-num {
  font-size: var(--font-heading);
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}
.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.s-pickup { border-top-color: var(--color-primary); }
.s-pickup .stat-num { color: var(--color-accent, #E8622C); }
.s-todo { border-top-color: var(--color-warning); }
.s-todo .stat-num { color: var(--color-warning); }
.s-overdue { border-top-color: var(--color-error); }
.s-overdue .stat-num { color: var(--color-error); }
.s-done { border-top-color: var(--color-success); }
.s-done .stat-num { color: var(--color-success); }
.s-debt { border-top-color: #7c3aed; }
.s-debt .stat-num { color: #7c3aed; }
.s-med { border-top-color: #10B981; }
.s-med .stat-icon { background: rgba(16, 185, 129, 0.12); }
.s-med .stat-num { color: #10B981; }
.s-private { border-top-color: #6b7280; }
.s-private .stat-num { color: #6b7280; }
.s-ignored { border-top-color: var(--text-tertiary); }
.s-ignored .stat-num { color: var(--text-tertiary); }
.stat-sub {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 2rpx;
  font-weight: 500;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}
.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  box-shadow: var(--shadow-1);
}
.search-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  min-width: 0;
}
.search-placeholder {
  color: var(--text-tertiary);
}
.search-go {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 600;
  padding: 16rpx 20rpx;
  flex-shrink: 0;
  cursor: pointer;
}

/* 通用 section */
.section {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-1);
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.section-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-primary);
}
.section-more {
  font-size: var(--font-body-sm);
  color: var(--color-primary);
  cursor: pointer;
}

/* 四象限 */
.quad-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}
.quad-box {
  width: calc(50% - var(--spacing-xs));
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 180rpx;
  cursor: pointer;
  transition: transform 0.15s;
}
.quad-box:active {
  transform: scale(0.97);
}
.quad-num {
  font-size: var(--font-display);
  font-weight: 700;
  line-height: 1;
}
.quad-label {
  font-size: var(--font-body-sm);
  margin-top: var(--spacing-xs);
}
.q1 { background: var(--quad-q1-bg); }
.q1 .quad-num { color: var(--quad-q1-num); }
.q1 .quad-label { color: var(--quad-q1-label); }
.q2 { background: var(--quad-q2-bg); }
.q2 .quad-num { color: var(--quad-q2-num); }
.q2 .quad-label { color: var(--quad-q2-label); }
.q3 { background: var(--quad-q3-bg); }
.q3 .quad-num { color: var(--quad-q3-num); }
.q3 .quad-label { color: var(--quad-q3-label); }
.q4 { background: var(--quad-q4-bg); }
.q4 .quad-num { color: var(--quad-q4-num); }
.q4 .quad-label { color: var(--quad-q4-label); }

/* 今日动态 · 时间线 */
.pending-list {
  display: flex;
  flex-direction: column;
}
.pending-empty {
  text-align: center;
  padding: 20rpx 0;
  font-size: var(--font-body-sm);
  color: var(--text-tertiary);
}

/* ── 今日动态 · 极简时间线（v0.16.4：刻意弱化，与块状待办形成主次层级） ── */
.act-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--bg-hover);
  transition: background 0.15s;
}
.act-row:last-child { border-bottom: none; }
.act-row:active { background: var(--bg-hover); }
.act-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.act-dot.new { background: var(--color-primary, #1E5B3C); }
.act-dot.done {
  background: transparent;
  border: 3rpx solid var(--color-success, #66BB6A);
}
.act-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}
.act-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}
.act-empty {
  text-align: center;
  padding: 20rpx 0;
  font-size: var(--font-body-sm);
  color: var(--text-tertiary);
}

/* 使用活跃度热力图（GitHub 风格，与年度报告同源） */
.heat-card {
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 20rpx;
}
.hm-scroll { width: 100%; }
.hm-inner { padding: 4rpx 4rpx 8rpx; }
.hm-months { position: relative; height: 26rpx; margin-bottom: 6rpx; }
.hm-month { position: absolute; top: 0; font-size: 18rpx; color: var(--text-tertiary); white-space: nowrap; }
.hm-cols { display: flex; gap: 4rpx; }
.hm-col { display: flex; flex-direction: column; gap: 4rpx; flex-shrink: 0; }
.hm-cell { width: 14rpx; height: 14rpx; border-radius: 3rpx; flex-shrink: 0; }
.hm-l0 { background: var(--bg-page); border: 1rpx solid var(--border); }
.hm-l1 { background: #9be9a8; }
.hm-l2 { background: #40c463; }
.hm-l3 { background: #30a14e; }
.hm-l4 { background: #216e39; }
.hm-future { opacity: 0.3; }
.hm-blank { background: transparent; border: none; }
.hm-legend {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
}
