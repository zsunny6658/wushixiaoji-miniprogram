/* pages/pickup-run/pickup-run.wxss - 按序取件 */
.page { padding: 24rpx var(--spacing-md) 60rpx; }

.hint {
  margin: 8rpx 4rpx 24rpx;
  font-size: var(--font-caption);
  color: var(--text-tertiary);
  line-height: 1.6;
}

/* 选驿站 */
.station-list { display: flex; flex-direction: column; gap: 16rpx; }
.station-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 28rpx 24rpx;
}
.station-icon { font-size: 40rpx; }
.station-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.station-name { font-size: var(--font-body); font-weight: 600; color: var(--text-primary); }
.station-sub { font-size: var(--font-caption); color: #1E5B3C; font-weight: 600; }
.station-go { font-size: var(--font-caption); color: var(--text-tertiary); }

.empty-state { padding: 120rpx 0; display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.empty-icon { font-size: 72rpx; }
.empty-text { font-size: var(--font-body); color: var(--text-secondary); font-weight: 600; }
.empty-desc { font-size: var(--font-caption); color: var(--text-tertiary); }

/* 执行态头部 */
.run-head {
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.run-station { display: flex; align-items: center; justify-content: space-between; }
.run-station-name { font-size: var(--font-body); font-weight: 700; color: var(--text-primary); }
.run-switch { font-size: var(--font-caption); color: #4f6ef7; }
.run-progress { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; }
.run-progress-bar {
  flex: 1;
  height: 12rpx;
  background: var(--bg-page);
  border-radius: 8rpx;
  overflow: hidden;
}
.run-progress-fill {
  height: 100%;
  background: #22c55e;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}
.run-progress-text { font-size: var(--font-caption); color: var(--text-secondary); font-weight: 600; min-width: 72rpx; text-align: right; }

/* 完成 */
.run-finished {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx 0 24rpx;
}
.run-finished-icon { font-size: 80rpx; }
.run-finished-text { font-size: var(--font-body); font-weight: 700; color: var(--text-primary); }
.btn-back {
  margin-top: 16rpx;
  background: #1E5B3C;
  color: #fff;
  border-radius: 999rpx;
  font-size: var(--font-body-sm);
  padding: 0 60rpx;
  line-height: 2.8;
}

/* 货架分组 */
.shelf { margin-bottom: 24rpx; }
.shelf-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 4rpx 12rpx;
}
.shelf-title { font-size: var(--font-body-sm); font-weight: 700; color: var(--text-primary); }
.shelf-count { font-size: var(--font-caption); color: var(--text-tertiary); }

/* 行 */
.run-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}
.run-row.row-done { opacity: 0.55; }
.seq {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--bg-page);
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  flex-shrink: 0;
}
.seq-done { background: #22c55e; border-color: #22c55e; color: #fff; }
.row-main { flex: 1; display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.row-code {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-family: monospace;
  letter-spacing: 1rpx;
}
.code-done { text-decoration: line-through; color: var(--text-tertiary); }
.row-sub { font-size: var(--font-caption); color: var(--text-tertiary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.row-act {
  flex-shrink: 0;
  background: #1E5B3C;
  color: #fff;
  font-size: var(--font-caption);
  font-weight: 600;
  border-radius: 999rpx;
  padding: 14rpx 32rpx;
}
.row-act.act-undo { background: var(--bg-page); color: var(--text-secondary); border: 2rpx solid var(--border); }

.bottom-tip {
  margin-top: 8rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-tertiary);
}

/* 批量/全量操作（v0.23.16） */
.run-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.run-act-btn {
  font-size: var(--font-caption);
  color: #4f6ef7;
  background: rgba(79, 110, 247, 0.08);
  border: 2rpx solid rgba(79, 110, 247, 0.3);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}
.run-row.row-selected { border-color: #4f6ef7; background: rgba(79, 110, 247, 0.06); }
.row-check {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  background: var(--bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: transparent;
}
.row-check.checked { background: #4f6ef7; border-color: #4f6ef7; color: #fff; }

.run-batch-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: var(--bg-card);
  border-top: 2rpx solid var(--border);
  z-index: 10;
}
.bb-all { font-size: var(--font-body-sm); color: var(--text-secondary); font-weight: 600; }
.bb-pick {
  flex: 1;
  background: #1E5B3C;
  color: #fff;
  font-size: var(--font-body-sm);
  font-weight: 600;
  border-radius: 999rpx;
  line-height: 2.6;
  padding: 0;
}
.bb-pick.bb-disabled { opacity: 0.45; }
.bb-exit { font-size: var(--font-body-sm); color: var(--text-tertiary); }
