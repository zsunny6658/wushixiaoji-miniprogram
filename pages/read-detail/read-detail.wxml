<view class="page" wx:if="{{item}}">
  <!-- 标题区 -->
  <view class="dt-head">
    <text class="dt-plat plat-{{item.platform}}">{{item.platformLabel}}</text>
    <text class="dt-title">{{item.title || item.url}}</text>
    <view class="dt-meta">
      <text wx:if="{{item.author}}" class="dt-meta-item">{{item.author}}</text>
      <text wx:if="{{item.publishedAt}}" class="dt-meta-item">{{item.publishedAt}}</text>
      <text wx:if="{{item.contentChars}}" class="dt-meta-item">{{item.contentChars}} 字</text>
    </view>
  </view>

  <!-- 操作条 -->
  <view class="dt-actions">
    <view class="dt-act" bindtap="onMark" data-status="done">
      <ficon name="check-circle" size="30" color="{{item.readStatus === 'done' ? '#1E5B3C' : '#64705F'}}" />
      <text class="dt-act-text {{item.readStatus === 'done' ? 'on' : ''}}">{{item.readStatus === 'done' ? '已读' : '标为已读'}}</text>
    </view>
    <view class="dt-act" bindtap="onCopyLink">
      <ficon name="external" size="30" color="#64705F" />
      <text class="dt-act-text">复制链接</text>
    </view>
    <view class="dt-act" bindtap="onCopySummary">
      <ficon name="copy" size="30" color="#64705F" />
      <text class="dt-act-text">复制摘要</text>
    </view>
    <view class="dt-act" bindtap="onDelete">
      <ficon name="trash" size="30" color="#EF5350" />
      <text class="dt-act-text danger">删除</text>
    </view>
  </view>

  <!-- 摘要 -->
  <view wx:if="{{item.summary}}" class="dt-section">
    <view class="dt-section-head">
      <text class="dt-section-title">摘要</text>
      <text class="dt-section-hint">{{item.wordCount ? 'AI 提炼' : ''}}</text>
    </view>
    <text class="dt-summary">{{item.summary}}</text>

    <view wx:if="{{item.highlights.length}}" class="dt-hl">
      <view class="dt-hl-item" wx:for="{{item.highlights}}" wx:key="*this">
        <text class="dt-hl-dot">·</text>
        <text class="dt-hl-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 标签（可编辑） -->
  <view class="dt-tags">
    <view class="dt-tag" wx:for="{{item.tags}}" wx:key="*this">
      <text>#{{item}}</text>
      <text wx:if="{{editingTags}}" class="dt-tag-x" catchtap="onRemoveTag" data-tag="{{item}}">✕</text>
    </view>
    <view wx:if="{{editingTags}}" class="dt-tag-add-wrap">
      <input
        class="dt-tag-input"
        value="{{newTag}}"
        placeholder="新标签"
        placeholder-class="dt-tag-ph"
        maxlength="16"
        bindinput="onNewTagInput"
        bindconfirm="onAddTag"
      />
      <text class="dt-tag-add" bindtap="onAddTag">添加</text>
    </view>
    <text class="dt-tag-edit" bindtap="onToggleTagEdit">{{editingTags ? '完成' : '编辑'}}</text>
  </view>

  <!-- 抓取状态提示 -->
  <view wx:if="{{item.contentStatus === 'failed'}}" class="dt-warn">
    <text class="dt-warn-text">正文抓取失败：{{item.contentError || '该站点可能反爬或需要登录'}}</text>
    <text class="dt-warn-btn" bindtap="onRefetch">重新解析</text>
  </view>
  <view wx:elif="{{item.contentStatus === 'partial'}}" class="dt-warn is-info">
    <text class="dt-warn-text">{{item.contentError || '仅获取到文章摘要，全文可点「复制链接」阅读原文'}}</text>
    <text class="dt-warn-btn" bindtap="onRefetch">重新解析</text>
  </view>
  <view wx:elif="{{item.contentStatus === 'pending' || item.contentStatus === 'fetching'}}" class="dt-warn is-info">
    <text class="dt-warn-text">正在抓取正文并建立索引，稍后下拉刷新查看</text>
  </view>

  <!-- 正文 -->
  <view class="dt-section">
    <view class="dt-section-head">
      <text class="dt-section-title">正文</text>
      <text class="dt-section-hint">来自原页面快照</text>
    </view>

    <view wx:if="{{contentLoading}}" class="dt-loading">正文加载中…</view>

    <block wx:elif="{{contentEmpty}}">
      <text class="dt-empty">{{item.contentStatus === 'failed' ? '正文未抓取到，可点上方「复制链接」在浏览器阅读。' : '暂无正文快照。'}}</text>
    </block>

    <block wx:else>
      <view wx:for="{{headBlocks}}" wx:key="index" wx:for-item="b" id="{{index === headHitIdx ? 'first-hit' : ''}}">
        <text wx:if="{{b.type === 'h1'}}" class="md-h1"><block wx:if="{{b.segs}}"><text wx:for="{{b.segs}}" wx:for-item="sg" wx:key="index" class="{{sg.hit ? 'hl' : ''}}">{{sg.t}}</text></block><block wx:else>{{b.text}}</block></text>
        <text wx:elif="{{b.type === 'h2'}}" class="md-h2"><block wx:if="{{b.segs}}"><text wx:for="{{b.segs}}" wx:for-item="sg" wx:key="index" class="{{sg.hit ? 'hl' : ''}}">{{sg.t}}</text></block><block wx:else>{{b.text}}</block></text>
        <text wx:elif="{{b.type === 'h3'}}" class="md-h3"><block wx:if="{{b.segs}}"><text wx:for="{{b.segs}}" wx:for-item="sg" wx:key="index" class="{{sg.hit ? 'hl' : ''}}">{{sg.t}}</text></block><block wx:else>{{b.text}}</block></text>
        <text wx:elif="{{b.type === 'h4'}}" class="md-h4"><block wx:if="{{b.segs}}"><text wx:for="{{b.segs}}" wx:for-item="sg" wx:key="index" class="{{sg.hit ? 'hl' : ''}}">{{sg.t}}</text></block><block wx:else>{{b.text}}</block></text>
        <view wx:elif="{{b.type === 'li'}}" class="md-li">
          <text class="md-li-dot">•</text>
          <text class="md-li-text"><block wx:if="{{b.segs}}"><text wx:for="{{b.segs}}" wx:for-item="sg" wx:key="index" class="{{sg.hit ? 'hl' : ''}}">{{sg.t}}</text></block><block wx:else>{{b.text}}</block></text>
        </view>
        <view wx:elif="{{b.type === 'quote'}}" class="md-quote"><block wx:if="{{b.segs}}"><text wx:for="{{b.segs}}" wx:for-item="sg" wx:key="index" class="{{sg.hit ? 'hl' : ''}}">{{sg.t}}</text></block><block wx:else>{{b.text}}</block></view>
        <view wx:elif="{{b.type === 'img'}}" class="md-img-wrap">
          <image class="md-img" src="{{b.src}}" mode="widthFix" lazy-load />
        </view>
        <text wx:elif="{{b.type === 'code'}}" class="md-code">{{b.text}}</text>
        <view wx:elif="{{b.type === 'hr'}}" class="md-hr"></view>
        <text wx:else class="md-p"><block wx:if="{{b.segs}}"><text wx:for="{{b.segs}}" wx:for-item="sg" wx:key="index" class="{{sg.hit ? 'hl' : ''}}">{{sg.t}}</text></block><block wx:else>{{b.text}}</block></text>
      </view>

      <block wx:if="{{!showAll && restBlocks.length}}">
        <view class="dt-expand" bindtap="onToggleAll">展开全文（还有 {{restBlocks.length}} 段）</view>
      </block>
      <block wx:if="{{showAll && restBlocks.length}}">
        <view wx:for="{{restBlocks}}" wx:key="index" wx:for-item="b" id="{{index === restHitIdx ? 'first-hit' : ''}}">
          <text wx:if="{{b.type === 'h1'}}" class="md-h1"><block wx:if="{{b.segs}}"><text wx:for="{{b.segs}}" wx:for-item="sg" wx:key="index" class="{{sg.hit ? 'hl' : ''}}">{{sg.t}}</text></block><block wx:else>{{b.text}}</block></text>
          <text wx:elif="{{b.type === 'h2'}}" class="md-h2"><block wx:if="{{b.segs}}"><text wx:for="{{b.segs}}" wx:for-item="sg" wx:key="index" class="{{sg.hit ? 'hl' : ''}}">{{sg.t}}</text></block><block wx:else>{{b.text}}</block></text>
          <text wx:elif="{{b.type === 'h3'}}" class="md-h3"><block wx:if="{{b.segs}}"><text wx:for="{{b.segs}}" wx:for-item="sg" wx:key="index" class="{{sg.hit ? 'hl' : ''}}">{{sg.t}}</text></block><block wx:else>{{b.text}}</block></text>
          <text wx:elif="{{b.type === 'h4'}}" class="md-h4"><block wx:if="{{b.segs}}"><text wx:for="{{b.segs}}" wx:for-item="sg" wx:key="index" class="{{sg.hit ? 'hl' : ''}}">{{sg.t}}</text></block><block wx:else>{{b.text}}</block></text>
          <view wx:elif="{{b.type === 'li'}}" class="md-li">
            <text class="md-li-dot">•</text>
            <text class="md-li-text"><block wx:if="{{b.segs}}"><text wx:for="{{b.segs}}" wx:for-item="sg" wx:key="index" class="{{sg.hit ? 'hl' : ''}}">{{sg.t}}</text></block><block wx:else>{{b.text}}</block></text>
          </view>
          <view wx:elif="{{b.type === 'quote'}}" class="md-quote"><block wx:if="{{b.segs}}"><text wx:for="{{b.segs}}" wx:for-item="sg" wx:key="index" class="{{sg.hit ? 'hl' : ''}}">{{sg.t}}</text></block><block wx:else>{{b.text}}</block></view>
          <view wx:elif="{{b.type === 'img'}}" class="md-img-wrap">
            <image class="md-img" src="{{b.src}}" mode="widthFix" lazy-load />
          </view>
          <text wx:elif="{{b.type === 'code'}}" class="md-code">{{b.text}}</text>
          <view wx:elif="{{b.type === 'hr'}}" class="md-hr"></view>
          <text wx:else class="md-p"><block wx:if="{{b.segs}}"><text wx:for="{{b.segs}}" wx:for-item="sg" wx:key="index" class="{{sg.hit ? 'hl' : ''}}">{{sg.t}}</text></block><block wx:else>{{b.text}}</block></text>
        </view>
      </block>
    </block>
  </view>

  <!-- 相关阅读 -->
  <view wx:if="{{relatedItems.length}}" class="dt-section dt-related">
    <view class="dt-section-head">
      <text class="dt-section-title">相关阅读</text>
      <text class="dt-section-hint">基于内容向量相似度</text>
    </view>
    <view
      class="dt-rel-item"
      wx:for="{{relatedItems}}"
      wx:key="id"
      bindtap="onRelatedTap"
      data-id="{{item.id}}"
      hover-class="hover-press"
    >
      <text class="dt-rel-plat plat-{{item.platform}}">{{item.platformLabel}}</text>
      <text class="dt-rel-title">{{item.title}}</text>
      <text wx:if="{{item.sim}}" class="dt-rel-sim">{{item.sim}}</text>
    </view>
  </view>

  <view class="dt-foot">
    <text class="dt-foot-text">收藏于 {{item.createdLabel}}</text>
  </view>
</view>

<view wx:else class="page dt-loading">加载中…</view>
