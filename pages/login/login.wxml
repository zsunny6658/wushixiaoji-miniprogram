<view class="login-page">
  <!-- 自托管服务端提示/配置条（v0.23.5） -->
  <view class="server-bar">
    <text class="server-label" bindtap="onEditServer">服务端：{{serverUrl}}{{hubCode ? ' · 接入码 ' + hubCode : ''}}</text>
    <text class="server-edit" bindtap="onEditServer">{{serverEditing ? '收起' : '更换'}}</text>
  </view>
  <view class="server-edit-box" wx:if="{{serverEditing}}">
    <input class="server-input" placeholder="https://你的域名（留空恢复官方）" placeholder-class="login-placeholder"
           value="{{serverUrl}}" bindinput="onServerInput" />
    <input class="server-input hub-code-input" placeholder="自托管接入码（选填，向服务方获取）" placeholder-class="login-placeholder"
           value="{{hubCode}}" bindinput="onHubCodeInput" />
    <view class="server-edit-actions">
      <button class="server-btn" bindtap="onSaveServer">保存并连接</button>
      <button class="server-btn ghost" bindtap="onResetServer">恢复官方服务端</button>
    </view>
    <view class="server-tip">自托管数据同样经由官方统一接入：填接入码即可连你自己的服务端，无需改地址、无需域名白名单；仅直连自建网关时才需要改上方地址。</view>
  </view>
  <view class="server-status" wx:if="{{serverProbing}}">正在探测服务端…</view>
  <view class="server-status err" wx:if="{{probeFail && !serverProbing}}">服务端连接失败，请检查地址或网络</view>

  <!-- 微信登录视图 -->
  <view class="login-header" wx:if="{{view === 'wx'}}">
    <view class="login-icon"><ficon name="box" size="96" color="#fff" /></view>
    <view class="login-title">屋事小记</view>
    <view class="login-sub">输入家庭成员口令，即可查看与完成你的备忘记录</view>
  </view>

  <view class="login-card">
    <!-- 微信一键登录（仅当端点支持 wxLogin，v0.23.5 capabilities 探测） -->
    <button class="wx-login-btn" wx:if="{{view === 'wx' && wxLoginSupported}}" bindtap="onWxLogin">
      <text>{{wxLoading ? '登录中...' : '微信一键登录'}}</text>
    </button>

    <!-- 账号登录 -->
    <view wx:if="{{view === 'email'}}">
      <view class="login-header">
        <view class="login-title">邮箱登录</view>
        <view class="login-sub">输入邮箱和密码登录</view>
      </view>

      <!-- 密码/验证码 Tab -->
      <view class="auth-tabs">
        <view class="auth-tab {{emailTab === 'password' ? 'active' : ''}}" bindtap="onEmailTab" data-tab="password">密码登录</view>
        <view class="auth-tab {{emailTab === 'code' ? 'active' : ''}}" wx:if="{{emailCodeSupported}}" bindtap="onEmailTab" data-tab="code">验证码登录</view>
      </view>

      <view class="input-label">邮箱</view>
      <input class="login-input" placeholder="邮箱地址" placeholder-class="login-placeholder"
             type="text" cursor-spacing="20" bindinput="onEmailInput" />

      <!-- 密码登录 -->
      <block wx:if="{{emailTab === 'password'}}">
        <view class="input-label">密码</view>
        <input class="login-input" placeholder="请输入密码" placeholder-class="login-placeholder"
               password cursor-spacing="20" bindinput="onEmailPassInput" />
      </block>

      <!-- 验证码登录（端点支持时才展示，capabilities.emailCode） -->
      <block wx:if="{{emailTab === 'code' && emailCodeSupported}}">
        <view class="input-label">验证码</view>
        <view class="code-row">
          <input class="login-input code-input" placeholder="6 位验证码" placeholder-class="login-placeholder"
                 type="number" maxlength="6" cursor-spacing="20" bindinput="onEmailCodeInput" />
          <button class="code-btn" bindtap="onSendCode" disabled="{{codeSending || codeSent}}">
            {{codeSending ? '发送中' : (codeSent ? countdown + 's后重试' : '获取验证码')}}
          </button>
        </view>
      </block>

      <button class="login-btn" bindtap="onEmailLogin">登录</button>
      <view class="login-back" wx:if="{{wxLoginSupported}}" bindtap="onBackToWx">← 返回微信登录</view>
    </view>

    <!-- 微信视图底部：切换到邮箱登录 -->
    <view wx:if="{{view === 'wx'}}" class="login-divider">
      <view class="login-divider-line"></view>
      <text class="login-divider-text">其他登录方式</text>
      <view class="login-divider-line"></view>
    </view>
    <view class="login-alt" wx:if="{{view === 'wx' && wxLoginSupported}}" bindtap="onShowEmail">
      <text>用邮箱密码登录 →</text>
    </view>
    <view class="login-alt" wx:if="{{view === 'wx' && !wxLoginSupported}}">
      <text class="login-alt-muted">当前服务端不支持微信一键登录，请使用邮箱登录</text>
    </view>
  </view>
</view>
