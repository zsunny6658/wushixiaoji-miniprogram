/* pages/archive/archive.wxss - 归档记录列表 */
.page {
  padding: var(--spacing-md);
  min-height: 100vh;
  box-sizing: border-box;
}

.arch-item {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-sm);
  box-shadow: var(--shadow-1);
}
.arch-main {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
}
.arch-icon {
  font-size: 40rpx;
  line-height: 1.2;
}
.arch-body {
  flex: 1;
  min-width: 0;
}
.arch-title-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}
.arch-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.arch-type {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-tertiary);
  background: var(--bg-page);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}
.arch-sub {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.arch-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
}
.arch-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 2rpx solid var(--border);
}
.arch-btn {
  font-size: var(--font-body-sm);
  color: var(--color-primary);
  padding: 8rpx 24rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: 999rpx;
}
.arch-loading {
  text-align: center;
  color: var(--text-tertiary);
  font-size: var(--font-body-sm);
  padding: var(--spacing-md) 0;
}

.arch-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.arch-empty-icon { font-size: 96rpx; }
.arch-empty-text {
  font-size: var(--font-body);
  color: var(--text-secondary);
  margin-top: var(--spacing-md);
}
.arch-empty-hint {
  font-size: var(--font-body-sm);
  color: var(--text-tertiary);
  margin-top: var(--spacing-xs);
}

.arch-bottom-spacer { height: env(safe-area-inset-bottom); }

.arch-type-done {
  background: rgba(16, 185, 129, 0.12);
  color: #0F6E56;
}

.arch-type-ignored {
  background: rgba(245, 158, 11, 0.14);
  color: #854F0B;
}

.arch-btn-med {
  color: #4A90D9;
  background: rgba(74, 144, 217, 0.1);
}
