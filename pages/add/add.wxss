/* pages/add/add.wxss - 新增/编辑页 */

.container {
  padding: var(--spacing-md);
  min-height: 100vh;
}

/* 编辑模式提示 */
.edit-tip {
  padding: var(--spacing-sm);
  background: var(--color-warning-light);
  border-radius: var(--radius-sm);
  color: var(--quad-q2-label);
  font-size: var(--font-body-sm);
  margin-bottom: var(--spacing-md);
}

/* 智能解析区 */
.smart-section {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-1);
}
.smart-title {
  font-size: var(--font-body);
  font-weight: 600;
  margin-bottom: var(--spacing-sm);
}
.smart-textarea {
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm);
  font-size: var(--font-body);
  line-height: 1.5;
  box-sizing: border-box;
  margin-bottom: var(--spacing-sm);
  background: var(--bg-page);
  transition: border-color 0.15s;
}
.smart-textarea:focus { border-color: var(--color-primary); }

/* 图片识别区 */
.image-section {
  margin-top: var(--spacing-sm);
}
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}
.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}
.image-thumb {
  width: 100%;
  height: 100%;
}
.image-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.image-actions {
  display: flex;
  gap: var(--spacing-sm);
}
.image-actions .btn {
  flex: 1;
}

/* 表单区域 */
.form-section {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-1);
}
.form-grid { display: block; }
.field {
  margin-bottom: var(--spacing-md);
}
.field:last-child { margin-bottom: 0; }
.field-label {
  display: block;
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-xs);
  font-weight: 500;
}
.field-input,
.field-picker {
  width: 100%;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: var(--font-body);
  line-height: 1.5;
  box-sizing: border-box;
  background: var(--bg-card);
  transition: border-color 0.15s;
  min-height: 80rpx;
}
.field-input:focus { border-color: var(--color-primary); }
.private-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.private-label {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
}
.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
}
.field-picker-value {
  color: var(--text-primary);
}
.field-picker-arrow {
  color: var(--text-tertiary);
  font-size: 24rpx;
}
.field-picker-second {
  margin-top: var(--spacing-xs);
}
.req { color: var(--color-error); margin-left: 4rpx; }

/* 用药时间 chips */
.med-times { display: flex; flex-wrap: wrap; gap: 16rpx; }
.med-time-chip {
  padding: 12rpx 28rpx;
  background: rgba(74, 144, 217, 0.08);
  border: 1rpx solid rgba(74, 144, 217, 0.35);
  border-radius: 32rpx;
  font-size: var(--font-body-sm, 28rpx);
  color: var(--color-primary, #4A90D9);
  font-weight: 600;
}
.field-hint {
  display: block;
  font-size: var(--font-body-sm);
  color: var(--text-tertiary);
  margin-top: var(--spacing-xs);
}

/* 类型分段切换 */
.type-segmented {
  display: flex;
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 6rpx;
  margin-bottom: var(--spacing-md);
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
  border-radius: calc(var(--radius-md) - 4rpx);
  transition: all 0.15s;
}
.seg-active {
  background: var(--bg-card);
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: var(--shadow-1);
}

/* 时间双列 */
.datetime-row {
  display: flex;
  gap: var(--spacing-sm);
}
.datetime-row picker { flex: 1; }

/* 更多选项折叠 */
.more-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 0 4rpx;
  margin-top: var(--spacing-sm);
  border-top: 2rpx solid var(--border);
  font-size: var(--font-body-sm);
  color: var(--text-tertiary);
}
.more-badge {
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--bg-page);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}
.more-section {
  padding-top: var(--spacing-md);
}

/* 底部操作 */
.footer-actions {
  padding: var(--spacing-md);
  display: flex;
  gap: var(--spacing-sm);
}
.footer-save {
  flex: 1;
}

/* 药板设置（仿真药板） */
.pill-colors {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin: 8rpx 0 16rpx;
}
.pill-color-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 4rpx solid var(--border);
  box-sizing: border-box;
}
.pill-color-dot.pc-active {
  border-color: var(--color-primary);
  transform: scale(1.15);
  box-shadow: 0 0 0 4rpx rgba(74, 144, 217, 0.18);
}
.pill-shapes {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 16rpx;
}
.pill-shape-chip {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: var(--bg-page);
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
}
.pill-shape-chip.ps-active {
  background: rgba(74, 144, 217, 0.12);
  color: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 600;
}
.pill-layout {
  display: flex;
  gap: 24rpx;
  margin-bottom: 8rpx;
}
.pill-layout-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-page);
  border-radius: 16rpx;
  padding: 12rpx 16rpx;
}
.pl-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.step-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--color-primary);
  line-height: 1;
}
.step-val {
  min-width: 36rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 拍药板识别按钮 */
.pill-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pill-photo-btn {
  font-size: 24rpx;
  color: var(--color-primary, #4A90D9);
  background: rgba(74, 144, 217, 0.1);
  border: 2rpx solid rgba(74, 144, 217, 0.3);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

/* 药名联想下拉 */
.field-drug {
  position: relative;
}
.drug-suggest {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  z-index: 30;
  background: var(--bg-card, #fff);
  border: 2rpx solid var(--border, #E2E8F0);
  border-radius: 16rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.12);
  overflow: hidden;
  margin-top: 4rpx;
}
.drug-suggest-item {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  padding: 16rpx 24rpx;
  border-bottom: 2rpx solid var(--bg-page, #F1F5F9);
}
.drug-suggest-item:last-child {
  border-bottom: none;
}
.drug-suggest-item:active {
  background: rgba(74, 144, 217, 0.08);
}
.ds-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-primary, #0F172A);
}
.ds-note {
  font-size: 22rpx;
  color: var(--text-tertiary, #94A3B8);
}

/* 服药频率：每周几 chips */
.week-chips {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}
.week-chip {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  background: var(--bg-page, #F1F5F9);
  color: var(--text-secondary, #475569);
  border: 2rpx solid var(--border, #E2E8F0);
}
.week-chip.wc-active {
  background: rgba(74, 144, 217, 0.14);
  color: var(--color-primary, #4A90D9);
  border-color: var(--color-primary, #4A90D9);
  font-weight: 600;
}
