<view class="container">
  <!-- 编辑模式提示 -->
  <view class="edit-tip" wx:if="{{editId}}">编辑模式：修改 {{editTitle}}</view>

  <!-- 智能解析区（仅新建模式显示，编辑模式隐藏） -->
  <view class="smart-section" wx:if="{{!editId}}">
    <view class="smart-title">✨ 智能识别</view>
    <textarea class="smart-textarea" placeholder="粘贴快递短信或备忘文本" auto-height value="{{smartText}}" bindinput="onSmartText"></textarea>
    <button class="btn btn-primary btn-block" bindtap="onSmartParse"><ficon name="clipboard" size="28" color="#fff" /> 文本识别</button>

    <!-- 图片识别区 -->
    <view class="image-section">
      <view class="image-list" wx:if="{{imageTempPaths.length}}">
        <view class="image-item" wx:for="{{imageTempPaths}}" wx:key="*this">
          <image class="image-thumb" src="{{item}}" mode="aspectFill" />
          <view class="image-remove" catchtap="onRemoveImage" data-idx="{{index}}">✕</view>
        </view>
      </view>
      <view class="image-actions">
        <button class="btn btn-outline btn-sm" bindtap="onChooseImage">📷 选择图片</button>
        <button class="btn btn-primary btn-sm" bindtap="onParseImage" disabled="{{imageParsing || !imageTempPaths.length}}">
          {{imageParsing ? '识别中...' : '图片识别'}}<ficon wx:if="{{!imageParsing}}" name="search" size="28" color="#4A90D9" />
        </button>
      </view>
    </view>
  </view>

  <!-- 表单 -->
  <view class="form-section">
    <!-- 类型分段切换 -->
    <view class="type-segmented">
      <view class="seg-item {{type === 'pickup' ? 'seg-active' : ''}}" bindtap="onTypeTap" data-type="pickup"><ficon name="box" size="30" color="{{type === 'pickup' ? '#4A90D9' : '#718096'}}" /> 取件</view>
      <view class="seg-item {{type === 'todo' ? 'seg-active' : ''}}" bindtap="onTypeTap" data-type="todo"><ficon name="clipboard" size="30" color="{{type === 'todo' ? '#4A90D9' : '#718096'}}" /> 备忘</view>
      <view class="seg-item {{type === 'debt' ? 'seg-active' : ''}}" bindtap="onTypeTap" data-type="debt"><ficon name="creditcard" size="30" color="{{type === 'debt' ? '#4A90D9' : '#718096'}}" /> 还款</view>
      <view class="seg-item {{type === 'medication' ? 'seg-active' : ''}}" bindtap="onTypeTap" data-type="medication"><ficon name="pill" size="30" color="{{type === 'medication' ? '#4A90D9' : '#718096'}}" /> 用药</view>
    </view>

    <view class="form-grid">
      <block wx:if="{{type === 'pickup'}}">
        <view class="field">
          <text class="field-label">取件驿站 <text class="req">*</text></text>
          <input class="field-input" placeholder="如：菜鸟驿站" value="{{form.station}}" bindinput="onField" data-field="station" />
        </view>
        <view class="field">
          <text class="field-label">取件码 <text class="req">*</text></text>
          <input class="field-input" placeholder="如：8-3-2201" value="{{form.code}}" bindinput="onField" data-field="code" />
        </view>
      </block>

      <block wx:if="{{type === 'todo'}}">
        <view class="field">
          <text class="field-label">备忘内容 <text class="req">*</text></text>
          <input class="field-input" placeholder="如：买排骨" value="{{form.code}}" bindinput="onField" data-field="code" />
        </view>
      </block>

      <block wx:if="{{type === 'debt'}}">
        <view class="field">
          <text class="field-label">还款事项 <text class="req">*</text></text>
          <input class="field-input" placeholder="如：招行信用卡还款" value="{{form.code}}" bindinput="onField" data-field="code" />
        </view>
        <view class="field">
          <text class="field-label">金额（元）</text>
          <input class="field-input" type="digit" placeholder="如：5230.5" value="{{form.amount}}" bindinput="onField" data-field="amount" />
        </view>
        <view class="field">
          <text class="field-label">还款期限</text>
          <picker mode="date" value="{{dueDateStr}}" bindchange="onDueDateChange" end="{{endDate}}">
            <view class="field-picker">
              <text class="field-picker-value">{{dueDateStr || '选择日期'}}</text>
              <text class="field-picker-arrow">▼</text>
            </view>
          </picker>
          <text class="field-hint">到期将收到逾期提醒</text>
        </view>
      </block>

      <block wx:if="{{type === 'medication'}}">
        <view class="field field-drug">
          <view class="pill-head-row">
            <text class="field-label">药品名称 <text class="req">*</text></text>
            <view class="pill-photo-btn" bindtap="onDrugSearchTap">🔍 搜形态</view>
          </view>
          <input class="field-input" placeholder="如：阿莫西林（输入可联想）" value="{{form.code}}" bindinput="onMedNameInput" />
          <view class="drug-suggest" wx:if="{{showDrugSuggest}}">
            <view class="drug-suggest-item" wx:for="{{drugSuggests}}" wx:key="name" bindtap="onDrugSuggestTap" data-name="{{item.name}}">
              <text class="ds-name">{{item.name}}</text>
              <text class="ds-note">{{item.note}}</text>
            </view>
            <view class="ds-empty" wx:if="{{suggestEmpty}}">词库暂无此药 · 可直接保存，或点「搜形态」AI 推测</view>
          </view>
        </view>
        <view class="field">
          <text class="field-label">每日次数</text>
          <picker range="{{doseOptions}}" value="{{doseIndex}}" bindchange="onDoseChange">
            <view class="field-picker">
              <text class="field-picker-value">{{doseOptions[doseIndex]}}</text>
              <text class="field-picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        <view class="field">
          <text class="field-label">服药频率</text>
          <picker range="{{freqOptions}}" value="{{freqIndex}}" bindchange="onFreqChange">
            <view class="field-picker">
              <text class="field-picker-value">{{freqOptions[freqIndex]}}</text>
              <text class="field-picker-arrow">▼</text>
            </view>
          </picker>
          <view class="week-chips" wx:if="{{showWeekChips}}">
            <view class="week-chip {{item.sel ? 'wc-active' : ''}}" wx:for="{{weekChips}}" wx:key="v" bindtap="onWeekChipTap" data-v="{{item.v}}">{{item.l}}</view>
          </view>
        </view>
        <view class="field">
          <text class="field-label">服药时间</text>
          <view class="med-times">
            <picker wx:for="{{medTimes}}" wx:key="index" mode="time" value="{{item}}" data-idx="{{index}}" bindchange="onMedTimeChange">
              <view class="med-time-chip">{{item}}</view>
            </picker>
          </view>
          <text class="field-hint">到点将通过邮件/订阅消息提醒</text>
        </view>
        <view class="field">
          <view class="pill-head-row">
            <text class="field-label">药板设置</text>
            <view class="pill-head-actions">
              <view class="pill-photo-btn" bindtap="onPillPhoto">📷 拍药板识别</view>
              <view class="pill-photo-btn" bindtap="onTogglePillBoard">{{pillBoardOpen ? '收起 ▲' : '展开 ▼'}}</view>
            </view>
          </view>
          <text class="pill-board-summary" wx:if="{{!pillBoardOpen}}">当前：{{pillInfo.rows}}×{{pillInfo.cols}} · {{pillInfo.boards}} 版 · 点「展开」调颜色/形状</text>
          <view class="pill-preview">
            <view class="pp-row" wx:for="{{pillPreviewRows}}" wx:for-item="prow" wx:key="*this">
              <view class="pp-cell" wx:for="{{prow}}" wx:for-item="pci" wx:key="*this">
                <view class="pp-pill" style="{{pillPrevStyle}}"></view>
              </view>
            </view>
          </view>
          <block wx:if="{{pillBoardOpen}}">
          <view class="pill-colors">
            <view class="pill-color-dot {{pillInfo.color === item ? 'pc-active' : ''}}" wx:for="{{pillColorOptions}}" wx:key="*this" style="background:{{pillColorHex[item]}}" bindtap="onPillColorTap" data-color="{{item}}"></view>
          </view>
          <view class="pill-shapes">
            <view class="pill-shape-chip {{pillInfo.shape === item.value ? 'ps-active' : ''}}" wx:for="{{pillShapeOptions}}" wx:key="value" bindtap="onPillShapeTap" data-shape="{{item.value}}">{{item.label}}</view>
          </view>
          <view class="pill-layout">
            <view class="pill-layout-item">
              <text class="pl-label">行数</text>
              <view class="stepper"><view class="step-btn" bindtap="onPillStep" data-field="rows" data-delta="-1">−</view><text class="step-val">{{pillInfo.rows}}</text><view class="step-btn" bindtap="onPillStep" data-field="rows" data-delta="1">＋</view></view>
            </view>
            <view class="pill-layout-item">
              <text class="pl-label">列数</text>
              <view class="stepper"><view class="step-btn" bindtap="onPillStep" data-field="cols" data-delta="-1">−</view><text class="step-val">{{pillInfo.cols}}</text><view class="step-btn" bindtap="onPillStep" data-field="cols" data-delta="1">＋</view></view>
            </view>
            <view class="pill-layout-item">
              <text class="pl-label">版数</text>
              <view class="stepper"><view class="step-btn" bindtap="onPillStep" data-field="boards" data-delta="-1">−</view><text class="step-val">{{pillInfo.boards}}</text><view class="step-btn" bindtap="onPillStep" data-field="boards" data-delta="1">＋</view></view>
            </view>
          </view>
          </block>
          <text class="field-hint">一版 {{pillInfo.rows}}×{{pillInfo.cols}} 共 {{pillInfo.rows * pillInfo.cols}} 颗，一盒 {{pillInfo.boards}} 版；详情页打开仿真药板打卡</text>
        </view>
      </block>

      <view class="field">
        <text class="field-label">时间</text>
        <view class="datetime-row">
          <picker mode="date" value="{{dateStr}}" bindchange="onDateChange" end="{{endDate}}">
            <view class="field-picker">
              <text class="field-picker-value">{{dateStr}}</text>
              <text class="field-picker-arrow">▼</text>
            </view>
          </picker>
          <picker mode="time" value="{{timeStr}}" bindchange="onTimeChange">
            <view class="field-picker">
              <text class="field-picker-value">{{timeStr}}</text>
              <text class="field-picker-arrow">▼</text>
            </view>
          </picker>
        </view>
      </view>
    </view>

    <!-- 更多选项折叠区 -->
    <view class="more-toggle" bindtap="onToggleMore">
      <text>{{showMore ? '收起选项 ▲' : '更多选项 ▼'}}</text>
      <text class="more-badge" wx:if="{{!showMore && moreFilled}}">已填写</text>
    </view>
    <view class="more-section" wx:if="{{showMore}}">
      <block wx:if="{{type === 'pickup'}}">
        <view class="field">
          <text class="field-label">快递公司</text>
          <input class="field-input" placeholder="如：中通快递" value="{{form.company}}" bindinput="onField" data-field="company" />
        </view>
        <view class="field">
          <text class="field-label">快递单号</text>
          <input class="field-input" placeholder="如：781234567" value="{{form.trackingNo}}" bindinput="onField" data-field="trackingNo" />
        </view>
      </block>

      <block wx:if="{{type === 'debt'}}">
        <view class="field">
          <text class="field-label">金融机构</text>
          <input class="field-input" placeholder="如：招商银行、花呗、建设银行" value="{{form.institution}}" bindinput="onField" data-field="institution" />
        </view>
      </block>

      <view class="field">
        <text class="field-label">归属成员</text>
        <picker range="{{memberOptions}}" value="{{memberIndex}}" bindchange="onMemberChange">
          <view class="field-picker">
            <text class="field-picker-value">{{memberOptions[memberIndex]}}</text>
            <text class="field-picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">待办人</text>
        <picker range="{{memberOptions}}" value="{{assigneeIndex}}" bindchange="onAssigneeChange">
          <view class="field-picker">
            <text class="field-picker-value">{{memberOptions[assigneeIndex]}}</text>
            <text class="field-picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">发起人</text>
        <picker range="{{memberOptions}}" value="{{assignerIndex}}" bindchange="onAssignerChange">
          <view class="field-picker">
            <text class="field-picker-value">{{memberOptions[assignerIndex]}}</text>
            <text class="field-picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">重要性</text>
        <picker range="{{impOptions}}" value="{{impIndex}}" bindchange="onImpChange">
          <view class="field-picker">
            <text class="field-picker-value">{{impOptions[impIndex]}}</text>
            <text class="field-picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">紧迫性</text>
        <picker range="{{urgOptions}}" value="{{urgIndex}}" bindchange="onUrgChange">
          <view class="field-picker">
            <text class="field-picker-value">{{urgOptions[urgIndex]}}</text>
            <text class="field-picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">备注</text>
        <input class="field-input" placeholder="补充说明" value="{{form.note}}" bindinput="onField" data-field="note" />
      </view>

      <view class="field">
        <text class="field-label">可见范围</text>
        <view class="private-toggle">
          <switch checked="{{isPrivate}}" bindchange="onPrivateChange" color="#4A90D9" />
          <view class="private-label"><ficon style="vertical-align:-4rpx;margin-right:6rpx" name="{{isPrivate ? 'lock' : 'users'}}" size="26" color="{{isPrivate ? '#64748B' : '#4A90D9'}}" /> {{isPrivate ? '仅本人可见' : '家庭成员可见'}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="footer-actions">
    <button class="btn btn-primary footer-save" bindtap="onSave">保存</button>
    <button class="btn btn-danger" wx:if="{{editId}}" bindtap="onDelete">删除</button>
  </view>
</view>
