<view class="page">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-bg"></view>
    <view class="user-content">
      <view class="user-avatar-wrap">
        <image wx:if="{{meAvatar}}" class="user-avatar-img" src="{{meAvatar}}" mode="aspectFill" />
        <view wx:else class="user-avatar">{{meFirstChar}}</view>
      </view>
      <view class="user-details">
        <text class="user-name">{{meName}}</text>
        <text class="user-email" wx:if="{{meEmail}}">{{meEmail}}</text>
        <view class="user-meta">
          <text class="user-role">{{roleLabel}}</text>
          <text class="user-divider">·</text>
          <text class="user-family">{{familyName}}</text>
        </view>
      </view>
      <view class="edit-btn" hover-class="hover-press" bindtap="onEditProfile">
        <text class="edit-btn-text">编辑资料</text>
        <text class="edit-btn-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 家庭切换 -->
  <view class="section-card" wx:if="{{families.length > 1}}">
    <text class="section-label">当前家庭</text>
    <view class="family-switcher">
      <view class="family-item {{item.id === familyId ? 'active' : ''}}" wx:for="{{families}}" wx:key="id" bindtap="switchFamily" data-id="{{item.id}}" hover-class="hover-press">
        <text class="family-dot {{item.id === familyId ? 'active' : ''}}"></text>
        <text class="family-name">{{item.name}}</text>
        <text class="family-check" wx:if="{{item.id === familyId}}">✓</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card">
    <!-- 账户 -->
    <text class="menu-group-title">账户</text>
    <view class="cell" bindtap="onChangePassword" hover-class="cell-hover">
      <view class="cell-left">
        <ficon class="cell-icon-vec" name="lock" size="36" />
        <text class="cell-title">修改密码</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onManageTokens" hover-class="cell-hover">
      <view class="cell-left">
        <ficon class="cell-icon-vec" name="key" size="36" />
        <text class="cell-title">CLI Token</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onOpenArchive" hover-class="cell-hover">
      <view class="cell-left">
        <ficon class="cell-icon-vec" name="archive" size="36" />
        <text class="cell-title">归档记录</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onManageIgnoreRules" hover-class="cell-hover">
      <view class="cell-left">
        <ficon class="cell-icon-vec" name="slash" size="36" />
        <text class="cell-title">忽略规则</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onManageWebhooks" hover-class="cell-hover">
      <view class="cell-left">
        <ficon class="cell-icon-vec" name="link" size="36" />
        <text class="cell-title">Webhook</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>

    <!-- 家庭管理（管理员） -->
    <block wx:if="{{isAdmin}}">
      <text class="menu-group-title">家庭管理</text>
      <view class="cell" bindtap="onManageMembers" hover-class="cell-hover">
        <view class="cell-left">
          <ficon class="cell-icon-vec" name="users" size="36" />
          <text class="cell-title">家庭成员</text>
        </view>
        <text class="cell-arrow">›</text>
      </view>
      <view class="cell" bindtap="onFamilySettings" hover-class="cell-hover">
        <view class="cell-left">
          <ficon class="cell-icon-vec" name="settings" size="36" />
          <text class="cell-title">家庭配置</text>
        </view>
        <text class="cell-arrow">›</text>
      </view>
    </block>

    <!-- 偏好 -->
    <text class="menu-group-title">偏好</text>
    <picker range="{{groupOptions}}" value="{{groupIndex}}" bindchange="onGroupChange">
      <view class="cell" hover-class="cell-hover">
        <view class="cell-left">
          <ficon class="cell-icon-vec" name="folder" size="36" />
          <text class="cell-title">分组方式</text>
        </view>
        <view class="cell-right">
          <text class="cell-value">{{groupOptions[groupIndex]}}</text>
          <text class="cell-arrow">›</text>
        </view>
      </view>
    </picker>

    <!-- 通知 -->
    <text class="menu-group-title">通知</text>
    <view class="cell" bindtap="onOpenNotifyModal" hover-class="cell-hover">
      <view class="cell-left">
        <ficon class="cell-icon-vec" name="bell" size="36" />
        <text class="cell-title">通知设置</text>
      </view>
      <view class="cell-right">
        <text class="cell-value">{{notifyEnabled ? '已开启' : '已关闭'}}</text>
        <text class="cell-arrow">›</text>
      </view>
    </view>

    <!-- 关于 -->
    <text class="menu-group-title">关于</text>
    <view class="cell" bindtap="onOpenAboutModal" hover-class="cell-hover">
      <view class="cell-left">
        <view class="cell-icon-wrap">
          <image class="cell-icon-img" src="/images/logo.png" mode="aspectFit" />
        </view>
        <text class="cell-title">屋事小记</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <!-- 创建家庭 -->
  <view class="create-btn" wx:if="{{isAdmin}}" bindtap="onShowCreateFamily" hover-class="hover-press">
    <text class="create-icon">＋</text>
    <text>创建新家庭</text>
  </view>

  <!-- 退出登录 -->
  <button class="logout-btn" bindtap="onLogout">退出登录</button>

  <!-- 底部间距 -->
  <view class="me-bottom-spacer"></view>
</view>

<!-- 创建家庭弹窗 -->
<view class="modal" wx:if="{{showCreateFamily}}">
  <view class="modal-mask" bindtap="onCancelCreateFamily"></view>
  <view class="modal-panel" catchtap="noop">
    <view class="modal-head">
      <text class="modal-title">创建家庭</text>
      <text class="modal-close" bindtap="onCancelCreateFamily">✕</text>
    </view>
    <input class="modal-input" placeholder="家庭名称（如：郑家）" placeholder-class="placeholder" value="{{newFamilyName}}" bindinput="onNewFamilyName" />
    <view class="modal-foot">
      <button class="modal-btn modal-btn-cancel" bindtap="onCancelCreateFamily">取消</button>
      <button class="modal-btn modal-btn-confirm" bindtap="onCreateFamily">创建</button>
    </view>
  </view>
</view>

<!-- 通知设置弹窗 -->
<view class="modal" wx:if="{{showNotifyModal}}">
  <view class="modal-mask" catchtap="onCloseNotifyModal"></view>
  <view class="modal-panel" catchtap="noop">
    <view class="modal-head">
      <text class="modal-title">通知设置</text>
      <text class="modal-close" bindtap="onCloseNotifyModal">✕</text>
    </view>
    <view class="notify-item">
      <view class="notify-item-left">
        <ficon class="notify-item-icon" name="bell" size="36" color="#F59E0B" />
        <view class="notify-item-text">
          <text class="notify-item-title">逾期提醒</text>
          <text class="notify-item-desc">快递逾期前提醒</text>
        </view>
      </view>
      <switch checked="{{notifyEnabled}}" bindchange="onNotifyToggle" color="#4A90D9" />
    </view>
    <view class="notify-item" wx:if="{{notifyEnabled}}">
      <view class="notify-item-left">
        <ficon class="notify-item-icon" name="flag" size="36" color="#EF4444" />
        <view class="notify-item-text">
          <text class="notify-item-title">通知范围</text>
          <text class="notify-item-desc">默认重要或紧急才推送；用药/逾期不受限</text>
        </view>
      </view>
      <view class="level-seg">
        <view class="level-seg-item {{minLevel === 'all' ? 'level-seg-active' : ''}}" bindtap="onMinLevelTap" data-level="all">全部</view>
        <view class="level-seg-item {{minLevel === 'important' ? 'level-seg-active' : ''}}" bindtap="onMinLevelTap" data-level="important">重要</view>
        <view class="level-seg-item {{minLevel === 'flag' ? 'level-seg-active' : ''}}" bindtap="onMinLevelTap" data-level="flag">红旗</view>
      </view>
    </view>
    <view class="notify-item" wx:if="{{notifyEnabled}}">
      <view class="notify-item-left">
        <ficon class="notify-item-icon" name="clock" size="36" color="#718096" />
        <view class="notify-item-text">
          <text class="notify-item-title">提前天数</text>
          <text class="notify-item-desc">逾期前多少天提醒</text>
        </view>
      </view>
      <input class="notify-input" type="number" value="{{notifyDays}}" bindblur="onNotifyDaysBlur" />
    </view>
    <view class="notify-item">
      <view class="notify-item-left">
        <ficon class="notify-item-icon" name="trash" size="36" color="#718096" />
        <view class="notify-item-text">
          <text class="notify-item-title">忽略处理</text>
          <text class="notify-item-desc">忽略超过保留天数后自动处理</text>
        </view>
      </view>
      <input class="notify-input" type="number" value="{{notifyCleanupDays}}" bindblur="onNotifyCleanupBlur" />
    </view>
    <view class="notify-item notify-subscribe-row">
      <view class="notify-hours">
        <text class="hour-tag {{ignoreCleanupMode === 'delete' ? 'hour-active' : ''}}" bindtap="onIgnoreModeTap" data-mode="delete">删除</text>
        <text class="hour-tag {{ignoreCleanupMode === 'archive' ? 'hour-active' : ''}}" bindtap="onIgnoreModeTap" data-mode="archive">转归档</text>
      </view>
      <text class="notify-item-desc">超期后 {{ignoreCleanupMode === 'archive' ? '转入归档区，可恢复' : '直接删除，不可恢复'}}</text>
    </view>
    <view class="notify-item">
      <view class="notify-item-left">
        <ficon class="notify-item-icon" name="archive" size="36" color="#718096" />
        <view class="notify-item-text">
          <text class="notify-item-title">完成归档</text>
          <text class="notify-item-desc">完成 N 天后自动归档，0=不自动</text>
        </view>
      </view>
      <input class="notify-input" type="number" value="{{pickArchiveDays}}" bindblur="onPickArchiveDaysBlur" />
    </view>
    <view class="notify-item">
      <view class="notify-item-left">
        <ficon class="notify-item-icon" name="pill" size="36" color="#10B981" />
        <view class="notify-item-text">
          <text class="notify-item-title">药量预警</text>
          <text class="notify-item-desc">盒内剩余 ≤ N 颗提醒备药，0=关闭</text>
        </view>
      </view>
      <input class="notify-input" type="number" value="{{medLowStockThreshold}}" bindblur="onLowStockThresholdBlur" />
    </view>
    <!-- 导出打卡记录 -->
    <view class="notify-item" bindtap="onExportMedLogs">
      <view class="notify-item-left">
        <ficon class="notify-item-icon" name="pill" size="36" color="#10B981" />
        <view class="notify-item-text">
          <text class="notify-item-title">导出打卡记录</text>
          <text class="notify-item-desc">全部服药记录导出 CSV（复制到剪贴板）</text>
        </view>
      </view>
      <text class="notify-arrow">›</text>
    </view>
    <!-- 提醒时间 -->
    <view class="notify-divider"></view>
    <text class="notify-section-title">提醒时间</text>
    <view class="notify-item">
      <view class="notify-item-left">
        <ficon class="notify-item-icon" name="box" size="36" color="#4A90D9" />
        <view class="notify-item-text">
          <text class="notify-item-title">待取件提醒</text>
          <text class="notify-item-desc">超过24小时未取时提醒</text>
        </view>
      </view>
      <view class="notify-hours">
        <text class="hour-tag {{pickupHour8 ? 'hour-active' : ''}}" bindtap="onTogglePickupHour" data-hour="8">8:00</text>
        <text class="hour-tag {{pickupHour20 ? 'hour-active' : ''}}" bindtap="onTogglePickupHour" data-hour="20">20:00</text>
      </view>
    </view>
    <view class="notify-item">
      <view class="notify-item-left">
        <ficon class="notify-item-icon" name="creditcard" size="36" color="#EF4444" />
        <view class="notify-item-text">
          <text class="notify-item-title">还款提醒</text>
          <text class="notify-item-desc">即将逾期/已逾期时提醒</text>
        </view>
      </view>
      <view class="notify-hours">
        <text class="hour-tag {{debtHour8 ? 'hour-active' : ''}}" bindtap="onToggleDebtHour" data-hour="8">8:00</text>
        <text class="hour-tag {{debtHour20 ? 'hour-active' : ''}}" bindtap="onToggleDebtHour" data-hour="20">20:00</text>
      </view>
    </view>
    <view class="notify-item">
      <view class="notify-item-left">
        <ficon class="notify-item-icon" name="clipboard" size="36" color="#718096" />
        <view class="notify-item-text">
          <text class="notify-item-title">每日汇总</text>
          <text class="notify-item-desc">每天发送待办概览邮件</text>
        </view>
      </view>
      <view class="notify-hours">
        <text class="hour-tag {{summaryHour === 8 ? 'hour-active' : ''}}" bindtap="onSetSummaryHour" data-hour="8">8:00</text>
        <text class="hour-tag {{summaryHour === 20 ? 'hour-active' : ''}}" bindtap="onSetSummaryHour" data-hour="20">20:00</text>
      </view>
    </view>

    <!-- 通知方式 -->
    <view class="notify-divider"></view>
    <text class="notify-section-title">通知方式</text>
    <view class="notify-item">
      <view class="notify-item-left">
        <ficon class="notify-item-icon" name="smartphone" size="36" color="#718096" />
        <view class="notify-item-text">
          <text class="notify-item-title">小程序通知</text>
          <text class="notify-item-desc">授权后可接收逾期/取件提醒</text>
        </view>
      </view>
    </view>
    <view class="notify-item notify-subscribe-row">
      <button class="modal-btn modal-btn-sm modal-btn-outline" bindtap="onSubscribeNotify"><ficon name="bell" size="26" color="#4A90D9" /> 授权订阅消息</button>
      <text class="notify-status {{subscribeAuthorized ? 'notify-status-enabled' : 'notify-status-disabled'}}">{{subscribeAuthorized ? '已授权' : '未授权'}}</text>
    </view>
    <view class="notify-item">
      <view class="notify-item-left">
        <text class="notify-item-icon">📧</text>
        <view class="notify-item-text">
          <text class="notify-item-title">邮箱通知</text>
          <text class="notify-item-desc">{{mailConfigured ? '已配置邮箱' : '未配置邮箱'}}</text>
        </view>
      </view>
      <text class="notify-status {{mailConfigured ? 'notify-status-enabled' : 'notify-status-disabled'}}">{{mailConfigured ? '可用' : '不可用'}}</text>
    </view>
    <view class="modal-foot">
      <button class="modal-btn modal-btn-confirm" bindtap="onSaveNotify">保存</button>
    </view>
  </view>
</view>

<!-- 忽略规则管理弹窗 -->
<view class="modal" wx:if="{{showRulesModal}}">
  <view class="modal-mask" catchtap="onCloseRulesModal"></view>
  <view class="modal-panel" catchtap="noop">
    <view class="modal-head">
      <text class="modal-title">忽略规则</text>
      <text class="modal-close" bindtap="onCloseRulesModal">✕</text>
    </view>
    <text class="rules-hint">长期忽略待办时自动创建；有效期内相似的新待办不再提醒。</text>
    <view class="rules-list" wx:if="{{ignoreRules.length}}">
      <view class="rule-item" wx:for="{{ignoreRules}}" wx:key="id">
        <view class="rule-main">
          <text class="rule-pattern">{{item.pattern}}</text>
          <view class="rule-meta">
            <text class="rule-tag">{{item.typeLabel}}</text>
            <text class="rule-duration">{{item.durationLabel}}</text>
            <text class="rule-remain {{item.remain === '已过期' ? 'rule-expired' : ''}}" wx:if="{{item.remain}}">{{item.remain}}</text>
          </view>
        </view>
        <view class="rule-del" catchtap="onDeleteIgnoreRule" data-id="{{item.id}}">删除</view>
      </view>
    </view>
    <view class="rules-empty" wx:else>
      <text class="rules-empty-icon">🔕</text>
      <text class="rules-empty-text">暂无规则</text>
      <text class="rules-empty-desc">在待办详情或长按菜单中选择「长期忽略」即可创建</text>
    </view>
    <view class="modal-foot">
      <button class="modal-btn modal-btn-confirm" bindtap="onCloseRulesModal">关闭</button>
    </view>
  </view>
</view>

<!-- 关于弹窗 -->
<view class="modal" wx:if="{{showAboutModal}}">
  <view class="modal-mask" bindtap="onCloseAboutModal"></view>
  <view class="modal-panel about-panel" catchtap="noop">
    <view class="modal-head">
      <text class="modal-title">关于</text>
      <text class="modal-close" bindtap="onCloseAboutModal">✕</text>
    </view>
    <view class="about-center">
      <view class="about-logo-wrap">
        <image class="about-logo-img" src="/images/logo.png" mode="aspectFit" />
      </view>
      <text class="about-name">屋事小记</text>
      <text class="about-version">v1.0.0</text>
      <text class="about-desc">快递取件码归集 · 待办管理 · 家庭事务协作</text>
    </view>
    <view class="about-info">
      <view class="about-info-row">
        <text class="about-info-label">服务端地址</text>
        <text class="about-info-value">{{baseUrl}}</text>
      </view>
      <view class="about-info-row">
        <text class="about-info-label">开源仓库</text>
        <text class="about-info-value about-link" bindtap="onCopyGithub">github.com/zsunny6658/family-parcel-hub-api</text>
      </view>
    </view>
    <view class="modal-foot">
      <button class="modal-btn modal-btn-confirm" bindtap="onCloseAboutModal">关闭</button>
    </view>
  </view>
</view>
