/* pages/me/me.wxss - 我的页面 */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: var(--spacing-md);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 用户信息卡片 */
.user-card {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--spacing-md);
  box-shadow: 0 4rpx 20rpx rgba(30, 91, 60, 0.2);
}
.user-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  z-index: 0;
}
.user-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: var(--spacing-lg) var(--spacing-md);
  gap: var(--spacing-md);
}
.user-avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-full);
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  flex-shrink: 0;
}
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.25);
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-white);
  font-size: 52rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.user-details {
  flex: 1;
  min-width: 0;
}
.user-name {
  display: block;
  font-size: var(--font-title);
  font-weight: 700;
  color: var(--text-white);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-email {
  display: block;
  font-size: var(--font-body-sm);
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}
.user-role {
  font-size: var(--font-body-sm);
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  font-weight: 500;
}
.user-divider {
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.5);
}
.user-family {
  font-size: var(--font-body-sm);
  color: rgba(255, 255, 255, 0.9);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 编辑资料按钮 */
.edit-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: var(--radius-full);
  padding: 12rpx 24rpx;
  transition: all 0.15s;
}
.edit-btn:hover, .edit-btn:active {
  background: rgba(255, 255, 255, 0.3);
}
.edit-btn-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 500;
}
.edit-btn-arrow {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 300;
}

/* 家庭切换 */
.section-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-1);
}
.section-label {
  display: block;
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-sm);
  font-weight: 500;
}
.family-switcher {
  display: flex;
  gap: var(--spacing-sm);
  flex-wrap: wrap;
}
.family-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-hover);
  font-size: var(--font-body);
  color: var(--text-secondary);
  transition: all 0.2s;
  cursor: pointer;
}
.family-item.active {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 600;
}
.family-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: var(--radius-full);
  background: var(--text-tertiary);
}
.family-dot.active { background: var(--color-primary); }
.family-check { color: var(--color-primary); font-weight: 700; }

/* 菜单卡片 */
.menu-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 8rpx 0;
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-1);
  overflow: hidden;
}
.menu-group-title {
  display: block;
  font-size: var(--font-caption);
  color: var(--text-tertiary);
  padding: var(--spacing-sm) var(--spacing-md) 8rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm) var(--spacing-md);
  min-height: 96rpx;
  border-top: 1rpx solid var(--border);
  transition: background 0.15s;
  cursor: pointer;
}
.cell:first-child { border-top: none; }
.cell-hover { background: var(--bg-hover); }
.cell-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  flex: 1;
  min-width: 0;
}
.cell-icon {
  flex-shrink: 0;
  font-size: 32rpx;
  width: 48rpx;
  text-align: center;
}
.cell-icon-vec {
  flex-shrink: 0;
  width: 48rpx;
  display: flex;
  justify-content: center;
}
.cell-icon-wrap {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cell-icon-img {
  width: 100%;
  height: 100%;
}
.cell-title {
  font-size: var(--font-body);
  color: var(--text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cell-desc {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
  font-weight: 400;
}
.cell-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
.cell-value {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
}
.cell-arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
  font-weight: 300;
}
.cell-url {
  font-size: var(--font-caption);
  color: var(--color-primary);
  flex-shrink: 0;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 创建家庭按钮 */
.create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--bg-card);
  border: 2rpx dashed var(--color-primary);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  font-size: var(--font-body);
  color: var(--color-primary);
  font-weight: 500;
  margin-bottom: var(--spacing-md);
  transition: all 0.15s;
  cursor: pointer;
}
.create-btn:active {
  background: var(--color-primary-light);
  transform: scale(0.98);
}
.create-icon { font-size: 32rpx; font-weight: 600; }

/* 退出登录 */
.logout-btn {
  width: 100%;
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  font-size: var(--font-body-lg);
  font-weight: 600;
  background: var(--bg-card);
  color: var(--color-error);
  border: none;
  margin-bottom: calc(60rpx + env(safe-area-inset-bottom));
  transition: all 0.15s;
}
.logout-btn::after { border: none; }
.logout-btn:active {
  background: var(--color-error-light);
  transform: scale(0.98);
}

/* 底部间距 */
.me-bottom-spacer {
  height: 20rpx;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}
.modal-panel {
  position: relative;
  z-index: 1001;
  width: 620rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  animation: modalIn 0.2s ease-out;
  max-height: 80vh;
  overflow-y: auto;
}
@keyframes modalIn {
  from { opacity: 0; transform: scale(0.95); }
}
.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-lg);
}
.modal-title {
  font-size: var(--font-subtitle);
  font-weight: 700;
  color: var(--text-primary);
}
.modal-close {
  font-size: 40rpx;
  color: var(--text-tertiary);
  padding: 8rpx;
  cursor: pointer;
}
.modal-input {
  width: 100%;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  font-size: var(--font-body);
  box-sizing: border-box;
  margin-bottom: var(--spacing-lg);
}
.modal-input:focus { border-color: var(--color-primary); }
.placeholder { color: var(--text-tertiary); }
.modal-foot {
  display: flex;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-lg);
}
.modal-btn {
  flex: 1;
  padding: var(--spacing-sm);
  border-radius: var(--radius-sm);
  font-size: var(--font-body);
  font-weight: 500;
  border: none;
  transition: all 0.15s;
}
.modal-btn::after { border: none; }
.modal-btn:active { transform: scale(0.97); }
.modal-btn-cancel {
  background: var(--bg-hover);
  color: var(--text-secondary);
}
.modal-btn-confirm {
  background: var(--color-primary);
  color: var(--text-white);
}

/* 通知设置弹窗 */
.notify-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid var(--border);
}
.notify-item:last-child { border-bottom: none; }
.notify-arrow {
  font-size: 40rpx;
  color: var(--text-tertiary, #94A3B8);
  padding-left: 12rpx;
}
.notify-item-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  flex: 1;
  min-width: 0;
}
.notify-item-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}
.notify-item-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.notify-item-title {
  font-size: var(--font-body);
  color: var(--text-primary);
  font-weight: 500;
}
.notify-item-desc {
  font-size: var(--font-caption);
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.notify-input {
  width: 80rpx;
  text-align: right;
  font-size: var(--font-body);
  color: var(--text-primary);
  font-weight: 600;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 6rpx 12rpx;
  background: var(--bg-hover);
}
.notify-divider {
  height: 1rpx;
  background: var(--border);
  margin: var(--spacing-sm) 0;
}
.notify-section-title {
  display: block;
  font-size: var(--font-caption);
  color: var(--text-tertiary);
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}
.notify-status {
  font-size: var(--font-caption);
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}
.notify-status-enabled {
  color: var(--color-success, #52c41a);
  background: rgba(82, 196, 26, 0.1);
}
.notify-status-disabled {
  color: var(--text-tertiary);
  background: var(--bg-hover);
}

/* 关于弹窗 */
.about-panel {
  text-align: center;
}
.about-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-md) 0 var(--spacing-lg);
}
.about-logo-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 91, 60, 0.25);
}
.about-logo-img {
  width: 100%;
  height: 100%;
}
.about-logo {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.about-name {
  font-size: var(--font-title);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}
.about-version {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}
.about-desc {
  font-size: var(--font-caption);
  color: var(--text-tertiary);
}
.about-info {
  background: var(--bg-hover);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm) var(--spacing-md);
  margin-bottom: var(--spacing-md);
}
.about-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.about-info-row:last-child { border-bottom: none; }
.about-info-label {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
  flex-shrink: 0;
}
.about-info-value {
  font-size: var(--font-caption);
  color: var(--color-primary);
  flex: 1;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-left: var(--spacing-sm);
}
.about-link {
  color: var(--color-primary);
}

/* 通知时间标签 */
.notify-hours {
  display: flex;
  gap: 8rpx;
  align-items: center;
}
.hour-tag {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-caption);
  color: var(--text-secondary);
  background: var(--bg-hover);
  cursor: pointer;
}
.hour-tag.hour-active {
  color: var(--text-white);
  background: var(--color-primary);
}

/* 模板ID输入 */
.notify-template-input {
  width: 100%;
  padding: 16rpx 20rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--font-body-sm);
  background: var(--bg-card);
}

/* 订阅通知行 */
.notify-subscribe-row {
  justify-content: flex-end;
  gap: var(--spacing-sm);
  padding-top: var(--spacing-sm);
}

/* 小按钮 */
.modal-btn-sm {
  flex: 1;
  padding: 12rpx 24rpx;
  font-size: var(--font-body-sm);
}

/* 通知范围三档选择 */
.level-seg {
  display: flex;
  background: var(--bg-page, #F1F5F9);
  border-radius: 999rpx;
  padding: 4rpx;
  flex-shrink: 0;
}
.level-seg-item {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--text-tertiary, #94A3B8);
}
.level-seg-item.level-seg-active {
  background: var(--bg-card, #fff);
  color: #EF4444;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(15, 42, 86, 0.08);
}

/* ===== 忽略规则管理 ===== */
.rules-hint {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary, #9CA3AF);
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.rules-list {
  max-height: 56vh;
  overflow-y: auto;
}
.rule-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color, rgba(0, 0, 0, 0.06));
}
.rule-item:last-child { border-bottom: none; }
.rule-main { flex: 1; min-width: 0; }
.rule-pattern {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary, #1F2937);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rule-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}
.rule-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--color-primary-light, rgba(30, 91, 60, 0.12));
  color: var(--color-primary, #1E5B3C);
}
.rule-duration {
  font-size: 22rpx;
  color: var(--text-secondary, #6B7280);
}
.rule-remain {
  font-size: 22rpx;
  color: #10B981;
}
.rule-expired { color: #9CA3AF; }
.rule-del {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #EF4444;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  background: var(--color-error-light, rgba(239, 68, 68, 0.1));
}
.rules-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
}
.rules-empty-icon { font-size: 64rpx; }
.rules-empty-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #1F2937);
}
.rules-empty-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-tertiary, #9CA3AF);
  text-align: center;
  line-height: 1.6;
}

/* ── 我的待办习惯（v0.16.0 行为画像） ── */
.habit-card {
  margin-top: 24rpx;
}
.habit-sub {
  display: block;
  font-size: 22rpx;
  color: var(--text-tertiary, #A4AC9F);
  margin-top: 4rpx;
}
.habit-grid {
  display: flex;
  margin-top: 20rpx;
}
.habit-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.habit-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary, #26302A);
  font-variant-numeric: tabular-nums;
}
.habit-green { color: #1E5B3C; }
.habit-orange { color: #E8622C; }
.habit-gray { color: #A4AC9F; }
.habit-label {
  font-size: 22rpx;
  color: var(--text-secondary, #6B7568);
}
