/* pages/me/me.wxss - 我的页面 */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: var(--spacing-md);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
}

/* 用户信息卡片 */
.user-card {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--spacing-md);
  box-shadow: 0 4rpx 20rpx rgba(74, 144, 217, 0.2);
}
.user-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  z-index: 0;
}
.user-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: var(--spacing-lg) var(--spacing-md);
  gap: var(--spacing-md);
}
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.25);
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-white);
  font-size: 52rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.user-details {
  flex: 1;
  min-width: 0;
}
.user-name {
  display: block;
  font-size: var(--font-title);
  font-weight: 700;
  color: var(--text-white);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-email {
  display: block;
  font-size: var(--font-body-sm);
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}
.user-role {
  font-size: var(--font-body-sm);
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  font-weight: 500;
}
.user-divider {
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.5);
}
.user-family {
  font-size: var(--font-body-sm);
  color: rgba(255, 255, 255, 0.9);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-action {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}
.action-icon { font-size: 32rpx; }

/* 家庭切换 */
.section-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-1);
}
.section-label {
  display: block;
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-sm);
  font-weight: 500;
}
.family-switcher {
  display: flex;
  gap: var(--spacing-sm);
  flex-wrap: wrap;
}
.family-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-hover);
  font-size: var(--font-body);
  color: var(--text-secondary);
  transition: all 0.2s;
  cursor: pointer;
}
.family-item.active {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 600;
}
.family-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: var(--radius-full);
  background: var(--text-tertiary);
}
.family-dot.active { background: var(--color-primary); }
.family-check { color: var(--color-primary); font-weight: 700; }

/* 菜单卡片 */
.menu-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 8rpx 0;
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-1);
  overflow: hidden;
}
.menu-group-title {
  display: block;
  font-size: var(--font-caption);
  color: var(--text-tertiary);
  padding: var(--spacing-sm) var(--spacing-md) 8rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm) var(--spacing-md);
  min-height: 96rpx;
  border-top: 1rpx solid var(--border);
  transition: background 0.15s;
  cursor: pointer;
}
.cell:first-child { border-top: none; }
.cell-hover { background: var(--bg-hover); }
.cell-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  flex: 1;
  min-width: 0;
}
.cell-icon {
  flex-shrink: 0;
  font-size: 32rpx;
  width: 48rpx;
  text-align: center;
}
.cell-title {
  font-size: var(--font-body);
  color: var(--text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cell-desc {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
  font-weight: 400;
}
.cell-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
.cell-value {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
}
.cell-arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
  font-weight: 300;
}
.cell-url {
  font-size: var(--font-caption);
  color: var(--color-primary);
  flex-shrink: 0;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 创建家庭按钮 */
.create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--bg-card);
  border: 2rpx dashed var(--color-primary);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  font-size: var(--font-body);
  color: var(--color-primary);
  font-weight: 500;
  margin-bottom: var(--spacing-md);
  transition: all 0.15s;
  cursor: pointer;
}
.create-btn:active {
  background: var(--color-primary-light);
  transform: scale(0.98);
}
.create-icon { font-size: 32rpx; font-weight: 600; }

/* 退出登录 */
.logout-btn {
  width: 100%;
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  font-size: var(--font-body-lg);
  font-weight: 600;
  background: var(--bg-card);
  color: var(--color-error);
  border: none;
  margin-bottom: var(--spacing-md);
  transition: all 0.15s;
}
.logout-btn::after { border: none; }
.logout-btn:active {
  background: var(--color-error-light);
  transform: scale(0.98);
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}
.modal-panel {
  position: relative;
  width: 600rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  animation: modalIn 0.2s ease-out;
}
@keyframes modalIn {
  from { opacity: 0; transform: scale(0.95); }
}
.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-lg);
}
.modal-title {
  font-size: var(--font-subtitle);
  font-weight: 700;
  color: var(--text-primary);
}
.modal-close {
  font-size: 40rpx;
  color: var(--text-tertiary);
  padding: 8rpx;
  cursor: pointer;
}
.modal-input {
  width: 100%;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  font-size: var(--font-body);
  box-sizing: border-box;
  margin-bottom: var(--spacing-lg);
}
.modal-input:focus { border-color: var(--color-primary); }
.placeholder { color: var(--text-tertiary); }
.modal-foot {
  display: flex;
  gap: var(--spacing-sm);
}
.modal-btn {
  flex: 1;
  padding: var(--spacing-sm);
  border-radius: var(--radius-sm);
  font-size: var(--font-body);
  font-weight: 500;
  border: none;
  transition: all 0.15s;
}
.modal-btn::after { border: none; }
.modal-btn:active { transform: scale(0.97); }
.modal-btn-cancel {
  background: var(--bg-hover);
  color: var(--text-secondary);
}
.modal-btn-confirm {
  background: var(--color-primary);
  color: var(--text-white);
}
