<view class="page">
  <!-- SSE 断线提示 -->
  <view class="rt-banner" wx:if="{{rtOff}}">⚡ 实时同步已断开，正在重连…（家人操作可能延迟显示）</view>
  <!-- 类型 tab -->
  <view class="toolbar">
    <view class="segmented segmented-fill">
      <view class="seg-item {{recordType === 'all' ? 'seg-active' : ''}}" bindtap="switchType" data-type="all">全部</view>
      <view class="seg-item {{recordType === 'pickup' ? 'seg-active' : ''}}" bindtap="switchType" data-type="pickup">取件</view>
      <view class="seg-item {{recordType === 'todo' ? 'seg-active' : ''}}" bindtap="switchType" data-type="todo">备忘</view>
      <view class="seg-item {{recordType === 'debt' ? 'seg-active' : ''}}" bindtap="switchType" data-type="debt">待还</view>
      <view class="seg-item {{recordType === 'medication' ? 'seg-active' : ''}}" bindtap="switchType" data-type="medication">用药</view>
    </view>
  </view>
  <!-- 状态 tab -->
  <view class="toolbar">
    <view class="segmented">
      <view class="seg-item {{filter === 'all' ? 'seg-active' : ''}}" bindtap="switchFilter" data-filter="all">全部<text class="seg-count">{{counts.all}}</text></view>
      <view class="seg-item {{filter === 'pending' ? 'seg-active' : ''}}" bindtap="switchFilter" data-filter="pending">待办<text class="seg-count">{{counts.pending}}</text></view>
      <view class="seg-item {{filter === 'picked' ? 'seg-active' : ''}}" bindtap="switchFilter" data-filter="picked">完成<text class="seg-count">{{counts.picked}}</text></view>
      <view class="seg-item {{filter === 'overdue' ? 'seg-active' : ''}}" bindtap="switchFilter" data-filter="overdue">逾期<text class="seg-count">{{counts.overdue}}</text></view>
      <view class="seg-item {{filter === 'ignored' ? 'seg-active' : ''}}" bindtap="switchFilter" data-filter="ignored">忽略<text class="seg-count">{{counts.ignored}}</text></view>
    </view>
  </view>

  <!-- 搜索 + 筛选入口 -->
  <view class="toolbar search-row">
    <input class="search-input" placeholder="{{recordType === 'todo' ? '搜索备忘内容' : '搜索取件码/驿站'}}" placeholder-style="color:var(--text-tertiary);line-height:1.5;font-size:28rpx;" value="{{search}}" bindinput="onSearch" />
    <view class="filter-entry {{activeFilterCount ? 'filter-on' : ''}}" bindtap="onToggleFilter">
      <text>筛选</text>
      <text class="filter-badge" wx:if="{{activeFilterCount}}">{{activeFilterCount}}</text>
    </view>
  </view>

  <!-- 筛选抽屉 -->
  <view class="filter-drawer" wx:if="{{showFilter}}">
    <view class="segmented segmented-fill">
      <view class="seg-item {{scope === 'all' ? 'seg-active' : ''}}" bindtap="switchScope" data-scope="all">全部</view>
      <view class="seg-item {{scope === 'family' ? 'seg-active' : ''}}" bindtap="switchScope" data-scope="family"><ficon name="users" size="26" color="{{scope === 'family' ? '#1E5B3C' : '#718096'}}" /> 家庭</view>
      <view class="seg-item {{scope === 'personal' ? 'seg-active' : ''}}" bindtap="switchScope" data-scope="personal"><ficon name="lock" size="26" color="{{scope === 'personal' ? '#1E5B3C' : '#718096'}}" /> 个人</view>
    </view>
    <view class="toolbar filters">
      <picker class="mini-select" range="{{impOptions}}" value="{{impIndex}}" bindchange="onImpChange">
        <view class="mini-select-inner">{{impOptions[impIndex]}}</view>
      </picker>
      <picker class="mini-select" range="{{urgOptions}}" value="{{urgIndex}}" bindchange="onUrgChange">
        <view class="mini-select-inner">{{urgOptions[urgIndex]}}</view>
      </picker>
      <picker class="mini-select" range="{{groupOptions}}" value="{{groupIndex}}" bindchange="onGroupChange">
        <view class="mini-select-inner">{{groupOptions[groupIndex]}}</view>
      </picker>
      <view class="filter-reset" wx:if="{{activeFilterCount}}" bindtap="onResetFilter">重置</view>
    </view>
  </view>

  <!-- 批量操作栏 -->
  <view class="batch-bar" wx:if="{{batchMode && list.length}}">
    <view class="batch-left">
      <text class="batch-count">已选 {{batchCount}}/{{list.length}}</text>
      <text class="batch-select-all" bindtap="onSelectAll">{{batchCount === list.length ? '取消全选' : '全选'}}</text>
    </view>
    <view class="batch-actions">
      <button class="btn btn-sm btn-primary" wx:if="{{batchCount > 0}}" bindtap="onBatchPick">✓ 批量完成</button>
      <button class="btn btn-sm btn-danger" wx:if="{{batchCount > 0}}" bindtap="onBatchDelete">删除</button>
    </view>
    <text class="batch-exit" bindtap="onExitBatch">退出</text>
  </view>

  <!-- 首屏骨架（首次加载未就绪时占位，避免白屏） -->
  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-card" wx:for="{{skeletonRows}}" wx:key="*this">
      <view class="sk-line sk-tag"></view>
      <view class="sk-line sk-main"></view>
      <view class="sk-line sk-sub"></view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{!list.length}}">
    <text class="empty-icon">{{emptyEmoji}}</text>
    <text class="empty-text">{{emptyTitle}}</text>
    <text class="empty-desc">{{emptyDesc}}</text>
  </view>

  <!-- 分组或列表 -->
  <block wx:else>
    <block wx:if="{{group === 'none' || recordType === 'todo'}}">
      <view class="cards">
        <view class="card-swipe-wrap" wx:for="{{list}}" wx:key="id">
          <view class="swipe-left">
            <view class="swipe-act {{item.importance === 'high' ? 'swipe-flag-off' : 'swipe-flag'}}" catchtap="onSwipeFlag" data-id="{{item.id}}"><ficon name="flag" size="26" color="#fff" /> {{item.importance === 'high' ? '取消红旗' : '红旗'}}</view>
          </view>
          <view class="swipe-actions">
            <view class="swipe-act {{item.status === 'picked' ? 'swipe-undo' : 'swipe-done'}}" catchtap="onSwipePick" data-id="{{item.id}}">{{item.status === 'picked' ? '↩ 撤销' : (item.type === 'medication' ? '💊 打卡' : '✓ 完成')}}</view>
          </view>
          <view hover-class="card-press" hover-stay-time="60" class="card {{item.importance === 'high' ? 'flagged' : ''}} {{item.status === 'picked' ? 'picked' : ''}} {{item.overdue ? 'urgent' : ''}} {{batchMode && item.batchSelected ? 'selected' : ''}} {{item.id === swipeId && swipeOffset !== 0 ? 'swiping' : ''}}" bindtap="onCardTap" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindlongpress="onCardLongPress" data-id="{{item.id}}" style="transform:translateX({{item.id === swipeId ? swipeOffset : 0}}rpx)">
            <view class="card-inner">
              <view class="batch-check" wx:if="{{batchMode}}" data-id="{{item.id}}">
                <text class="checkbox {{item.batchSelected ? 'checked' : ''}}">{{item.batchSelected ? '✓' : ''}}</text>
              </view>
              <view class="card-body">
                <view class="card-meta-row">
                  <view class="card-type-group">
                    <text class="tag tag-primary" wx:if="{{item.type === 'pickup'}}">取件</text>
                    <text class="tag tag-warning" wx:if="{{item.type === 'todo'}}">备忘</text>
                    <text class="tag tag-debt" wx:if="{{item.type === 'debt'}}">待还</text>
                    <text class="tag tag-med" wx:if="{{item.type === 'medication'}}">用药</text>
                    <view class="tag tag-private" wx:if="{{item.isPrivate}}"><ficon style="vertical-align:-4rpx" name="lock" size="22" color="#64748B" /></view>
                  </view>
                  <view class="card-info-group">
                    <view class="meta-item {{item.overdue ? 'time-warn' : ''}}" wx:if="{{item.arrivedAt}}"><ficon wx:if="{{item.type === 'debt'}}" style="vertical-align:-4rpx;margin-right:6rpx" name="creditcard" size="24" color="#9CA3AF" /><ficon wx:elif="{{item.type === 'medication'}}" style="vertical-align:-4rpx;margin-right:6rpx" name="pill" size="24" color="#9CA3AF" /><ficon wx:else name="clock" size="24" color="#9CA3AF" /> {{item.arrivedLabel}}</view>
                    <text class="meta-item imp-{{item.importance}}">{{item.impLabel}}</text>
                    <text class="meta-item urg-{{item.urgency}}">{{item.urgLabel}}</text>
                    <text class="tag tag-success" wx:if="{{item.assignee}}">@{{item.assignee}}</text>
                  </view>
                </view>
                <text class="code-value">{{item.summaryText}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="group" wx:for="{{groups}}" wx:key="key">
        <view class="group-head">
          <view class="group-dot"></view>
          <text class="group-title">{{item.key}}</text>
          <text class="group-count">{{item.items.length}}</text>
        </view>
        <view class="cards">
          <view class="card-swipe-wrap" wx:for="{{item.items}}" wx:for-item="pkg" wx:key="id">
          <view class="swipe-left">
            <view class="swipe-act {{pkg.importance === 'high' ? 'swipe-flag-off' : 'swipe-flag'}}" catchtap="onSwipeFlag" data-id="{{pkg.id}}"><ficon name="flag" size="26" color="#fff" /> {{pkg.importance === 'high' ? '取消红旗' : '红旗'}}</view>
          </view>
          <view class="swipe-actions">
            <view class="swipe-act {{pkg.status === 'picked' ? 'swipe-undo' : 'swipe-done'}}" catchtap="onSwipePick" data-id="{{pkg.id}}">{{pkg.status === 'picked' ? '↩ 撤销' : (pkg.type === 'medication' ? '💊 打卡' : '✓ 完成')}}</view>
          </view>
          <view hover-class="card-press" hover-stay-time="60" class="card {{pkg.importance === 'high' ? 'flagged' : ''}} {{pkg.status === 'picked' ? 'picked' : ''}} {{pkg.overdue ? 'urgent' : ''}} {{batchMode && pkg.batchSelected ? 'selected' : ''}} {{pkg.id === swipeId && swipeOffset !== 0 ? 'swiping' : ''}}" bindtap="onCardTap" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindlongpress="onCardLongPress" data-id="{{pkg.id}}" style="transform:translateX({{pkg.id === swipeId ? swipeOffset : 0}}rpx)">
            <view class="card-inner">
              <view class="batch-check" wx:if="{{batchMode}}" data-id="{{pkg.id}}">
                <text class="checkbox {{pkg.batchSelected ? 'checked' : ''}}">{{pkg.batchSelected ? '✓' : ''}}</text>
              </view>
              <view class="card-body">
                <view class="card-meta-row">
                  <view class="card-type-group">
                    <text class="tag tag-primary" wx:if="{{pkg.type === 'pickup'}}">取件</text>
                    <text class="tag tag-warning" wx:if="{{pkg.type === 'todo'}}">备忘</text>
                    <text class="tag tag-debt" wx:if="{{pkg.type === 'debt'}}">待还</text>
                    <text class="tag tag-med" wx:if="{{pkg.type === 'medication'}}">用药</text>
                    <view class="tag tag-private" wx:if="{{pkg.isPrivate}}"><ficon style="vertical-align:-4rpx" name="lock" size="22" color="#64748B" /></view>
                  </view>
                  <view class="card-info-group">
                    <view class="meta-item {{pkg.overdue ? 'time-warn' : ''}}" wx:if="{{pkg.arrivedAt}}"><ficon wx:if="{{pkg.type === 'debt'}}" style="vertical-align:-4rpx;margin-right:6rpx" name="creditcard" size="24" color="#9CA3AF" /><ficon wx:elif="{{pkg.type === 'medication'}}" style="vertical-align:-4rpx;margin-right:6rpx" name="pill" size="24" color="#9CA3AF" /><ficon wx:else name="clock" size="24" color="#9CA3AF" /> {{pkg.arrivedLabel}}</view>
                    <text class="meta-item imp-{{pkg.importance}}">{{pkg.impLabel}}</text>
                    <text class="meta-item urg-{{pkg.urgency}}">{{pkg.urgLabel}}</text>
                    <text class="tag tag-success" wx:if="{{pkg.assignee}}">@{{pkg.assignee}}</text>
                  </view>
                </view>
                <text class="code-value">{{pkg.summaryText}}</text>
              </view>
            </view>
          </view>
          </view>
        </view>
      </view>
    </block>
  </block>
</view>