<view class="page">
  <!-- 类型 + 范围 + 状态 tab -->
  <view class="toolbar">
    <view class="segmented segmented-fill">
      <view class="seg-item {{recordType === 'all' ? 'seg-active' : ''}}" bindtap="switchType" data-type="all">全部</view>
      <view class="seg-item {{recordType === 'pickup' ? 'seg-active' : ''}}" bindtap="switchType" data-type="pickup">取件</view>
      <view class="seg-item {{recordType === 'todo' ? 'seg-active' : ''}}" bindtap="switchType" data-type="todo">备忘</view>
      <view class="seg-item {{recordType === 'debt' ? 'seg-active' : ''}}" bindtap="switchType" data-type="debt">待还</view>
    </view>
  </view>
  <view class="toolbar">
    <view class="segmented segmented-fill">
      <view class="seg-item {{scope === 'all' ? 'seg-active' : ''}}" bindtap="switchScope" data-scope="all">全部</view>
      <view class="seg-item {{scope === 'family' ? 'seg-active' : ''}}" bindtap="switchScope" data-scope="family">👨‍👩‍👧 家庭</view>
      <view class="seg-item {{scope === 'personal' ? 'seg-active' : ''}}" bindtap="switchScope" data-scope="personal">🔒 个人</view>
    </view>
  </view>
  <view class="toolbar">
    <view class="segmented">
      <view class="seg-item {{filter === 'all' ? 'seg-active' : ''}}" bindtap="switchFilter" data-filter="all">全部<text class="seg-count">{{counts.all}}</text></view>
      <view class="seg-item {{filter === 'pending' ? 'seg-active' : ''}}" bindtap="switchFilter" data-filter="pending">待办<text class="seg-count">{{counts.pending}}</text></view>
      <view class="seg-item {{filter === 'picked' ? 'seg-active' : ''}}" bindtap="switchFilter" data-filter="picked">完成<text class="seg-count">{{counts.picked}}</text></view>
      <view class="seg-item {{filter === 'overdue' ? 'seg-active' : ''}}" bindtap="switchFilter" data-filter="overdue">逾期<text class="seg-count">{{counts.overdue}}</text></view>
      <view class="seg-item {{filter === 'ignored' ? 'seg-active' : ''}}" bindtap="switchFilter" data-filter="ignored">忽略<text class="seg-count">{{counts.ignored}}</text></view>
    </view>
  </view>

  <!-- 搜索 + 筛选 -->
  <view class="toolbar">
    <input class="search-input" placeholder="{{recordType === 'todo' ? '搜索备忘内容' : '搜索取件码/驿站'}}" placeholder-style="color:var(--text-tertiary);line-height:1.5;font-size:28rpx;" value="{{search}}" bindinput="onSearch" />
  </view>
  <view class="toolbar filters">
    <picker class="mini-select" range="{{impOptions}}" value="{{impIndex}}" bindchange="onImpChange">
      <view class="mini-select-inner">{{impOptions[impIndex]}}</view>
    </picker>
    <picker class="mini-select" range="{{urgOptions}}" value="{{urgIndex}}" bindchange="onUrgChange">
      <view class="mini-select-inner">{{urgOptions[urgIndex]}}</view>
    </picker>
    <picker class="mini-select" range="{{groupOptions}}" value="{{groupIndex}}" bindchange="onGroupChange">
      <view class="mini-select-inner">{{groupOptions[groupIndex]}}</view>
    </picker>
  </view>

  <!-- 批量操作栏 -->
  <view class="batch-bar" wx:if="{{batchMode && list.length}}">
    <view class="batch-left">
      <text class="batch-count">已选 {{batchCount}}/{{list.length}}</text>
      <text class="batch-select-all" bindtap="onSelectAll">{{batchCount === list.length ? '取消全选' : '全选'}}</text>
    </view>
    <view class="batch-actions">
      <button class="btn btn-sm btn-primary" wx:if="{{batchCount > 0}}" bindtap="onBatchPick">✓ 批量完成</button>
      <button class="btn btn-sm btn-danger" wx:if="{{batchCount > 0}}" bindtap="onBatchDelete">删除</button>
    </view>
    <text class="batch-exit" bindtap="onExitBatch">退出</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!list.length}}">
    <text class="empty-icon">{{emptyEmoji}}</text>
    <text class="empty-text">{{emptyTitle}}</text>
    <text class="empty-desc">{{emptyDesc}}</text>
  </view>

  <!-- 分组或列表 -->
  <block wx:else>
    <block wx:if="{{group === 'none' || recordType === 'todo'}}">
      <view class="cards">
        <view class="card {{item.importance === 'high' ? 'flagged' : ''}} {{item.status === 'picked' ? 'picked' : ''}} {{item.overdue ? 'urgent' : ''}} {{batchMode && item.batchSelected ? 'selected' : ''}}" wx:for="{{list}}" wx:key="id" bindtap="onCardTap" data-id="{{item.id}}" hover-class="hover-press">
          <view class="card-inner">
            <view class="batch-check" wx:if="{{batchMode}}" data-id="{{item.id}}">
              <text class="checkbox {{item.batchSelected ? 'checked' : ''}}">{{item.batchSelected ? '✓' : ''}}</text>
            </view>
            <view class="card-body">
              <view class="card-meta-row">
                <view class="card-type-group">
                  <text class="tag tag-primary" wx:if="{{item.type === 'pickup'}}">取件</text>
                  <text class="tag tag-warning" wx:if="{{item.type === 'todo'}}">备忘</text>
                  <text class="tag tag-debt" wx:if="{{item.type === 'debt'}}">待还</text>
                  <text class="tag tag-private" wx:if="{{item.isPrivate}}">🔒</text>
                </view>
                <view class="card-info-group">
                  <text class="meta-item {{item.overdue ? 'time-warn' : ''}}" wx:if="{{item.arrivedAt}}">{{item.type === 'pickup' ? '🕐' : (item.type === 'debt' ? '💳' : '⏰')}} {{item.arrivedLabel}}</text>
                  <text class="meta-item imp-{{item.importance}}">{{item.impLabel}}</text>
                  <text class="meta-item urg-{{item.urgency}}">{{item.urgLabel}}</text>
                  <text class="tag tag-success" wx:if="{{item.assignee}}">@{{item.assignee}}</text>
                </view>
              </view>
              <text class="code-value">{{item.summaryText}}</text>
            </view>
            <view class="card-quick" wx:if="{{!batchMode}}" catchtap="onQuickPick" data-id="{{item.id}}">
              <text class="quick-icon">{{item.status === 'picked' ? '↩' : '✓'}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="group" wx:for="{{groups}}" wx:key="key">
        <view class="group-head">
          <view class="group-dot"></view>
          <text class="group-title">{{item.key}}</text>
          <text class="group-count">{{item.items.length}}</text>
        </view>
        <view class="cards">
          <view class="card {{pkg.importance === 'high' ? 'flagged' : ''}} {{pkg.status === 'picked' ? 'picked' : ''}} {{pkg.overdue ? 'urgent' : ''}} {{batchMode && pkg.batchSelected ? 'selected' : ''}}" wx:for="{{item.items}}" wx:for-item="pkg" wx:key="id" bindtap="onCardTap" data-id="{{pkg.id}}" hover-class="hover-press">
            <view class="card-inner">
              <view class="batch-check" wx:if="{{batchMode}}" data-id="{{pkg.id}}">
                <text class="checkbox {{pkg.batchSelected ? 'checked' : ''}}">{{pkg.batchSelected ? '✓' : ''}}</text>
              </view>
              <view class="card-body">
                <view class="card-meta-row">
                  <view class="card-type-group">
                    <text class="tag tag-primary" wx:if="{{pkg.type === 'pickup'}}">取件</text>
                    <text class="tag tag-warning" wx:if="{{pkg.type === 'todo'}}">备忘</text>
                    <text class="tag tag-debt" wx:if="{{pkg.type === 'debt'}}">待还</text>
                    <text class="tag tag-private" wx:if="{{pkg.isPrivate}}">🔒</text>
                  </view>
                  <view class="card-info-group">
                    <text class="meta-item {{pkg.overdue ? 'time-warn' : ''}}" wx:if="{{pkg.arrivedAt}}">{{pkg.type === 'pickup' ? '🕐' : (pkg.type === 'debt' ? '💳' : '⏰')}} {{pkg.arrivedLabel}}</text>
                    <text class="meta-item imp-{{pkg.importance}}">{{pkg.impLabel}}</text>
                    <text class="meta-item urg-{{pkg.urgency}}">{{pkg.urgLabel}}</text>
                    <text class="tag tag-success" wx:if="{{pkg.assignee}}">@{{pkg.assignee}}</text>
                  </view>
                </view>
                <text class="code-value">{{pkg.summaryText}}</text>
              </view>
              <view class="card-quick" wx:if="{{!batchMode}}" catchtap="onQuickPick" data-id="{{pkg.id}}">
                <text class="quick-icon">{{pkg.status === 'picked' ? '↩' : '✓'}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </block>
</view>
