/* pages/list/list.wxss - 列表页 */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: var(--spacing-md);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 工具栏 */
.toolbar {
  margin-bottom: var(--spacing-sm);
}
.toolbar.filters {
  display: flex;
  gap: var(--spacing-xs);
  flex-wrap: wrap;
}
.search-input {
  width: 100%;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-full);
  padding: 16rpx 24rpx;
  font-size: var(--font-body);
  line-height: 1.5;
  height: 88rpx;
  background: var(--bg-card);
  box-sizing: border-box;
  transition: border-color 0.15s;
}
.search-input:focus { border-color: var(--color-primary); }
.mini-select {
  flex: 1;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--bg-card);
  min-width: 0;
  cursor: pointer;
  transition: border-color 0.15s;
}
.mini-select:active { border-color: var(--color-primary); }
.mini-select-inner {
  padding: 12rpx 16rpx;
  font-size: var(--font-body-sm);
  color: var(--text-primary);
  text-align: center;
}

/* 搜索行 + 筛选入口 */
.search-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}
.search-row .search-input { flex: 1; width: auto; }
.filter-entry {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  height: 88rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-full);
  background: var(--bg-card);
  font-size: var(--font-body);
  color: var(--text-secondary);
  flex-shrink: 0;
}
.filter-entry.filter-on {
  border-color: var(--color-primary);
  color: var(--color-primary);
}
.filter-badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: var(--color-primary);
  border-radius: 999rpx;
  padding: 0 6rpx;
}

/* 筛选抽屉 */
.filter-drawer {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm) var(--spacing-md);
  margin-bottom: var(--spacing-sm);
  box-shadow: var(--shadow-1);
}
.filter-drawer .toolbar { margin-bottom: var(--spacing-sm); }
.filter-drawer .toolbar:last-child { margin-bottom: 0; }
.filter-reset {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 20rpx;
  font-size: var(--font-body-sm);
  color: var(--color-error);
  flex-shrink: 0;
}

/* 批量操作栏 */
.batch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
  background: var(--color-primary-light);
  border-radius: var(--radius-md);
  position: sticky;
  top: 0;
  z-index: 100;
}
.batch-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}
.batch-count {
  font-size: var(--font-body-sm);
  font-weight: 600;
  color: var(--color-primary);
}
.batch-select-all {
  font-size: var(--font-body-sm);
  color: var(--color-primary);
  text-decoration: underline;
  cursor: pointer;
}
.batch-actions {
  display: flex;
  gap: var(--spacing-xs);
}
.batch-exit {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
  padding: 8rpx 12rpx;
  cursor: pointer;
}

/* 卡片列表 */
.cards {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}
.card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm);
  box-shadow: var(--shadow-1);
  cursor: pointer;
  transition: transform 0.15s;
}
.card:active { transform: scale(0.99); }
.card.picked .card-inner { opacity: 0.6; }
.card.picked .code-value { text-decoration: line-through; color: var(--text-tertiary); }
.card.urgent { border-left: 6rpx solid var(--color-warning); }
.card.flagged { border-left: 6rpx solid var(--color-accent, #E8622C); }
.card.flagged.urgent { border-left: 6rpx solid var(--color-accent, #E8622C); }
.card.selected { border: 2rpx solid var(--color-primary); background: var(--color-primary-light); }

.card-inner {
  display: flex;
  align-items: stretch;
  gap: var(--spacing-sm);
}
.card-body { flex: 1; min-width: 0; }
.card-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.card-type-group {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}
.card-info-group {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  justify-content: flex-end;
  flex-wrap: nowrap;
  overflow: hidden;
}
.code-value {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 5;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.station-line {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--font-body-sm);
  font-weight: 600;
  color: var(--text-secondary);
  margin-top: var(--spacing-xs);
}

/* meta 标签 */
.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: var(--spacing-xs);
}
.meta-item {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-caption);
  background: var(--bg-hover);
  color: var(--text-secondary);
}
.meta-item.time-warn { background: var(--color-warning-light); color: var(--color-warning); }
.meta-item.note { background: rgba(109, 84, 196, 0.14); color: #8B6FE8; }
.meta-item.imp-high { background: var(--color-accent-light, #FCEADD); color: #B4491B; font-weight: 600; }
.meta-item.imp-medium { background: var(--color-warning-light); color: var(--color-warning); font-weight: 600; }
.meta-item.imp-low { background: var(--bg-hover); color: var(--text-tertiary); font-weight: 600; }
.meta-item.urg-urgent { background: var(--color-error-light); color: var(--color-error); font-weight: 600; }
.meta-item.urg-normal { background: var(--color-success-light); color: var(--color-success); font-weight: 600; }

/* 批量 checkbox */
.batch-check {
  flex-shrink: 0;
  margin-right: 8rpx;
}
.checkbox {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--text-disabled);
  border-radius: var(--radius-full);
  font-size: 20rpx;
  color: transparent;
  background: var(--bg-card);
}
.checkbox.checked {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: var(--text-white);
}

/* 快速完成按钮 */
.card-quick {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  flex-shrink: 0;
  align-self: flex-start;
  margin-top: 4rpx;
  cursor: pointer;
}
.quick-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-full);
  font-size: var(--font-body);
  color: var(--color-primary);
  font-weight: 700;
  background: var(--bg-card);
  transition: all 0.15s;
}
.quick-icon:active { transform: scale(0.9); }
.card.picked .quick-icon {
  border-color: var(--text-tertiary);
  color: var(--text-tertiary);
}

/* 分组 */
.group {
  margin-bottom: var(--spacing-md);
}
.group-head {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
  padding: 0 4rpx;
}
.group-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
}
.group-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-primary);
}
.group-count {
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-radius: var(--radius-full);
  padding: 2rpx 12rpx;
  font-size: var(--font-caption);
}

/* 滑动快捷操作 */
.card-swipe-wrap {
  position: relative;
  overflow: hidden;
}
.card-swipe-wrap .card {
  position: relative;
  z-index: 1;
  transition: transform 0.2s ease-out;
  border-radius: 0;
  background: var(--bg-card);
  width: 100%;
  box-sizing: border-box;
  margin: 0;
  padding-left: var(--spacing-sm);
  padding-right: var(--spacing-sm);
}
.card.swiping {
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.12);
}
.swipe-left {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  display: flex;
  z-index: 0;
}
.swipe-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  z-index: 0;
}
.swipe-act {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-white);
  cursor: pointer;
}
.swipe-act:active {
  opacity: 0.8;
}
.swipe-flag {
  background: #ef4444; /* 红旗：红色 */
}
.swipe-flag-off {
  background: #6b7280; /* 取消红旗：灰色 */
}
.swipe-done {
  background: #10b981; /* 完成：绿色，正向确认 */
}
.swipe-undo {
  background: #6b7280; /* 撤销：中性灰，可逆操作 */
}

/* FAB */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: var(--text-white);
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(30, 91, 60, 0.4);
  z-index: 50;
  cursor: pointer;
  transition: all 0.15s;
}
.fab:active { transform: scale(0.92); }
.fab-batch {
  background: var(--color-error) !important;
  box-shadow: 0 8rpx 24rpx rgba(229, 57, 53, 0.4) !important;
}

/* 用药标签 */
.tag-med {
  background: rgba(16, 185, 129, 0.12);
  color: #10B981;
}

/* SSE 断线黄条 */
.rt-banner {
  background: #FEF3C7;
  color: #92400E;
  font-size: 24rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  margin: 0 24rpx 12rpx;
}

/* ── 首屏加载骨架 ── */
.skeleton { padding: 20rpx 24rpx; }
.sk-card {
  background: var(--surface, #fff);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.sk-line {
  border-radius: 8rpx;
  background: linear-gradient(90deg, #EEF1F5 25%, #F7F9FB 40%, #EEF1F5 55%);
  background-size: 400% 100%;
  animation: sk-shimmer 1.2s ease infinite;
}
.sk-tag { width: 120rpx; height: 28rpx; margin-bottom: 16rpx; }
.sk-main { width: 60%; height: 36rpx; margin-bottom: 16rpx; }
.sk-sub { width: 40%; height: 28rpx; }
@keyframes sk-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* ── 块状卡片（v0.16.1：一块一事；v0.16.2 质感升级：克制用色 + 大留白 + 轻操作行） ── */
.card {
  padding: 32rpx 32rpx 28rpx;
  border-radius: 20rpx;
}
.bk-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.bk-main {
  display: block;
  margin-top: 20rpx;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--text-primary, #26302A);
  word-break: break-all;
}
/* 取件码：等宽 + 宽字距，像实体码一样醒目 */
.bk-main-code {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 52rpx;
  letter-spacing: 6rpx;
  color: var(--color-primary-dark, #143D28);
}
/* 金额：橙色大字 */
.bk-main-amount {
  font-size: 52rpx;
  color: var(--color-accent, #E8622C);
  font-variant-numeric: tabular-nums;
}
.bk-main-done {
  text-decoration: line-through;
  color: var(--text-tertiary, #9AA396);
  font-weight: 600;
}
.card.picked .bk-main-code,
.card.picked .bk-main-amount {
  color: var(--text-tertiary, #9AA396);
}
.bk-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-tertiary, #9AA396);
  line-height: 1.5;
  word-break: break-all;
}
.bk-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(38, 48, 42, 0.07);
}
.bk-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  min-width: 0;
}
/* meta 降噪（v0.16.2）：普通信息一律小灰字，仅异常态保留颜色（字色，不用彩底） */
.bk-meta .meta-item {
  background: transparent;
  color: var(--text-tertiary, #9AA396);
  font-weight: 500;
  padding: 0;
  font-size: 22rpx;
}
.bk-meta .meta-item.imp-high { color: #B4491B; font-weight: 600; }
.bk-meta .meta-item.urg-urgent { color: var(--color-error, #EF5350); font-weight: 600; }
.bk-meta .meta-item.time-warn { color: #B45309; font-weight: 600; }
.bk-meta .meta-item.bk-assignee { color: var(--text-tertiary, #9AA396); font-weight: 500; }
.bk-act {
  flex-shrink: 0;
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary, #1E5B3C);
  background: var(--color-primary-light, #E9F1EA);
  border: 1rpx solid rgba(30, 91, 60, 0.18);
}
.bk-act-done {
  color: var(--text-tertiary, #9AA396);
  background: transparent;
  border-color: transparent;
  font-weight: 500;
}

/* ── 附件角标（v0.17.0） ── */
.bk-img-badge {
  color: var(--text-tertiary, #94A3B8);
}
