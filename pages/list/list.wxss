/* pages/list/list.wxss - 列表页 */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: var(--spacing-md);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 工具栏 */
.toolbar {
  margin-bottom: var(--spacing-sm);
}
.toolbar.filters {
  display: flex;
  gap: var(--spacing-xs);
  flex-wrap: wrap;
}
.search-input {
  width: 100%;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-full);
  padding: 16rpx 24rpx;
  font-size: var(--font-body);
  line-height: 1.5;
  height: 88rpx;
  background: var(--bg-card);
  box-sizing: border-box;
  transition: border-color 0.15s;
}
.search-input:focus { border-color: var(--color-primary); }
.mini-select {
  flex: 1;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--bg-card);
  min-width: 0;
  cursor: pointer;
  transition: border-color 0.15s;
}
.mini-select:active { border-color: var(--color-primary); }
.mini-select-inner {
  padding: 12rpx 16rpx;
  font-size: var(--font-body-sm);
  color: var(--text-primary);
  text-align: center;
}

/* 批量操作栏 */
.batch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
  background: var(--color-primary-light);
  border-radius: var(--radius-md);
  position: sticky;
  top: 0;
  z-index: 100;
}
.batch-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}
.batch-count {
  font-size: var(--font-body-sm);
  font-weight: 600;
  color: var(--color-primary);
}
.batch-select-all {
  font-size: var(--font-body-sm);
  color: var(--color-primary);
  text-decoration: underline;
  cursor: pointer;
}
.batch-actions {
  display: flex;
  gap: var(--spacing-xs);
}
.batch-exit {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
  padding: 8rpx 12rpx;
  cursor: pointer;
}

/* 卡片列表 */
.cards {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}
.card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm);
  box-shadow: var(--shadow-1);
  cursor: pointer;
  transition: transform 0.15s;
}
.card:active { transform: scale(0.99); }
.card.picked { opacity: 0.6; }
.card.picked .code-value { text-decoration: line-through; color: var(--text-tertiary); }
.card.urgent { border-left: 6rpx solid var(--color-warning); }
.card.flagged { border-left: 6rpx solid var(--color-error); }
.card.flagged.urgent { border-left: 6rpx solid var(--color-error); }
.card.selected { border: 2rpx solid var(--color-primary); background: var(--color-primary-light); }

.card-inner {
  display: flex;
  align-items: stretch;
  gap: var(--spacing-sm);
}
.card-body { flex: 1; min-width: 0; }
.card-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.card-type-group {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}
.card-info-group {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  justify-content: flex-end;
  flex-wrap: nowrap;
  overflow: hidden;
}
.code-value {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 5;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.station-line {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--font-body-sm);
  font-weight: 600;
  color: var(--text-secondary);
  margin-top: var(--spacing-xs);
}

/* meta 标签 */
.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: var(--spacing-xs);
}
.meta-item {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-caption);
  background: var(--bg-hover);
  color: var(--text-secondary);
}
.meta-item.time-warn { background: var(--color-warning-light); color: var(--color-warning); }
.meta-item.note { background: #F0EDFF; color: #6D54C4; }
.meta-item.imp-high { background: var(--color-error-light); color: var(--color-error); font-weight: 600; }
.meta-item.imp-medium { background: var(--color-warning-light); color: var(--color-warning); font-weight: 600; }
.meta-item.imp-low { background: var(--bg-hover); color: var(--text-tertiary); font-weight: 600; }
.meta-item.urg-urgent { background: var(--color-error-light); color: var(--color-error); font-weight: 600; }
.meta-item.urg-normal { background: var(--color-success-light); color: var(--color-success); font-weight: 600; }

/* 批量 checkbox */
.batch-check {
  flex-shrink: 0;
  margin-right: 8rpx;
}
.checkbox {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--text-disabled);
  border-radius: var(--radius-full);
  font-size: 20rpx;
  color: transparent;
  background: var(--bg-card);
}
.checkbox.checked {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: var(--text-white);
}

/* 快速完成按钮 */
.card-quick {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  flex-shrink: 0;
  align-self: flex-start;
  margin-top: 4rpx;
  cursor: pointer;
}
.quick-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-full);
  font-size: var(--font-body);
  color: var(--color-primary);
  font-weight: 700;
  background: var(--bg-card);
  transition: all 0.15s;
}
.quick-icon:active { transform: scale(0.9); }
.card.picked .quick-icon {
  border-color: var(--text-tertiary);
  color: var(--text-tertiary);
}

/* 分组 */
.group {
  margin-bottom: var(--spacing-md);
}
.group-head {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
  padding: 0 4rpx;
}
.group-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
}
.group-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-primary);
}
.group-count {
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-radius: var(--radius-full);
  padding: 2rpx 12rpx;
  font-size: var(--font-caption);
}

/* FAB */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: var(--text-white);
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
  z-index: 50;
  cursor: pointer;
  transition: all 0.15s;
}
.fab:active { transform: scale(0.92); }
.fab-batch {
  background: var(--color-error) !important;
  box-shadow: 0 8rpx 24rpx rgba(229, 57, 53, 0.4) !important;
}
