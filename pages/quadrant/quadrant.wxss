/* pages/quadrant/quadrant.wxss - 四象限 */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: var(--spacing-md);
}

/* 返回按钮 */
.back-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: var(--spacing-sm);
  font-size: var(--font-body);
  color: var(--color-primary);
  font-weight: 500;
  cursor: pointer;
}
.back-arrow { font-size: 36rpx; font-weight: 300; }

/* 单象限头部 */
.focus-header {
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-1);
}
.focus-header.q1 { background: linear-gradient(135deg, #FEE2E2 0%, #FECACA 100%); }
.focus-header.q2 { background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%); }
.focus-header.q3 { background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%); }
.focus-header.q4 { background: linear-gradient(135deg, #F1F5F9 0%, #E2E8F0 100%); }

.focus-top {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}
.focus-icon { font-size: 44rpx; }
.focus-title {
  font-size: var(--font-subtitle);
  font-weight: 700;
  color: var(--text-primary);
}
.focus-stats {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.focus-count {
  font-size: var(--font-display);
  font-weight: 800;
  color: var(--text-primary);
}
.focus-unit {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
}
.focus-hint {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
}

/* 总数统计 */
.quad-summary {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  padding: var(--spacing-md);
  background: var(--bg-card);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-sm);
  box-shadow: var(--shadow-1);
}
.summary-label {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
}
.summary-count {
  font-size: var(--font-heading);
  font-weight: 800;
  color: var(--color-primary);
}

/* 四象限网格 - 2x2 布局 */
.quad-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}
.quad-cell {
  width: calc(50% - var(--spacing-sm) / 2);
  box-sizing: border-box;
  border-radius: var(--radius-md);
  padding: var(--spacing-md) 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  min-height: 200rpx;
  justify-content: center;
  transition: transform 0.15s;
}
.quad-cell:active { transform: scale(0.97); }
.quad-cell.q1 { background: linear-gradient(135deg, #FEE2E2 0%, #FCA5A5 100%); }
.quad-cell.q2 { background: linear-gradient(135deg, #FEF3C7 0%, #FCD34D 100%); }
.quad-cell.q3 { background: linear-gradient(135deg, #DBEAFE 0%, #93C5FD 100%); }
.quad-cell.q4 { background: linear-gradient(135deg, #F1F5F9 0%, #CBD5E1 100%); }

.cell-icon { font-size: 36rpx; margin-bottom: 4rpx; }
.cell-num {
  font-size: var(--font-heading);
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1;
}
.cell-title {
  font-size: var(--font-body-sm);
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 6rpx;
}
.cell-hint {
  font-size: var(--font-caption);
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* 卡片列表 */
.card-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.qcard {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 18rpx 20rpx;
  box-shadow: var(--shadow-1);
  cursor: pointer;
  transition: transform 0.15s;
}
.qcard:active { transform: scale(0.98); }
.qcard.urgent { border-left: 5rpx solid var(--color-error); }
.qcard-main {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}
.qcard-code {
  display: block;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}
.qcard-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 4rpx;
  flex-wrap: wrap;
}
.qcard-type {
  font-size: var(--font-caption);
  color: var(--text-secondary);
}
.qcard-time {
  font-size: var(--font-caption);
  color: var(--text-tertiary);
}
.qcard-occ {
  font-size: var(--font-caption);
  font-weight: 700;
  color: var(--color-error);
  background: var(--color-error-light);
  padding: 2rpx 8rpx;
  border-radius: var(--radius-sm);
}
.qcard-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

/* 最近添加 */
.recent-section { margin-top: 8rpx; }
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
  padding: 0 4rpx;
}
.section-more {
  font-size: var(--font-caption);
  color: var(--color-primary);
  cursor: pointer;
}
