/* pages/quadrant/quadrant.wxss - 四象限 */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: var(--spacing-md);
}

/* 总数统计 */
.quad-summary {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  padding: var(--spacing-md);
  background: var(--bg-card);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-sm);
  box-shadow: var(--shadow-1);
}
.summary-label {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
}
.summary-count {
  font-size: var(--font-heading);
  font-weight: 800;
  color: var(--color-primary);
}

/* 象限 tab 切换 */
.quad-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: var(--spacing-md);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
.qt-tab {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: 14rpx 18rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  transition: all 0.15s;
  cursor: pointer;
}
.qt-tab:active { transform: scale(0.95); }
.qt-label {
  font-size: var(--font-caption);
  color: var(--text-secondary);
  font-weight: 500;
  white-space: nowrap;
}
.qt-count {
  font-size: var(--font-body-sm);
  font-weight: 700;
  color: var(--text-primary);
}
.qt-active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}
.qt-active .qt-label { color: var(--color-primary); }
.qt-active .qt-count { color: var(--color-primary); }

/* 筛选提示 */
.quad-filter-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: 0 4rpx;
  margin-bottom: var(--spacing-sm);
}
.quad-filter-title {
  font-size: var(--font-body-sm);
  font-weight: 600;
  color: var(--text-primary);
}
.quad-filter-hint {
  font-size: var(--font-caption);
  color: var(--text-tertiary);
}

/* 卡片列表 */
.card-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.qcard {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 18rpx 20rpx;
  box-shadow: var(--shadow-1);
  cursor: pointer;
  transition: transform 0.15s;
}
.qcard:active { transform: scale(0.98); }
.qcard.urgent { border-left: 5rpx solid var(--color-error); }
.qcard-main {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}
.qcard-code {
  display: block;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}
.qcard-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 4rpx;
  flex-wrap: wrap;
}
.qcard-type {
  font-size: var(--font-caption);
  color: var(--text-secondary);
}
.qcard-time {
  font-size: var(--font-caption);
  color: var(--text-tertiary);
}
.qcard-occ {
  font-size: var(--font-caption);
  font-weight: 700;
  color: var(--color-error);
  background: var(--color-error-light);
  padding: 2rpx 8rpx;
  border-radius: var(--radius-sm);
}
.qcard-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx var(--spacing-md);
}
.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: var(--spacing-sm);
}
.empty-text {
  display: block;
  font-size: var(--font-body);
  color: var(--text-secondary);
}
