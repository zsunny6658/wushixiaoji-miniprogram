/* pages/quadrant/quadrant.wxss - 四象限 2x2 网格 */

.version-bar {
  position: fixed;
  top: 0;
  right: 0;
  background: #333;
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 16rpx;
  border-radius: 0 0 0 12rpx;
  z-index: 999;
}

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: var(--spacing-md);
  padding-top: calc(var(--spacing-md) + 30rpx);
  box-sizing: border-box;
}

/* 总数统计 */
.quad-summary {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  padding: 16rpx var(--spacing-md);
  background: var(--bg-card);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-sm);
  box-shadow: var(--shadow-1);
}
.summary-label {
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
}
.summary-count {
  font-size: var(--font-title);
  font-weight: 800;
  color: var(--color-accent, #E8622C);
  font-variant-numeric: tabular-nums;
}

/* 2x2 网格 */
.quad-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: var(--spacing-sm);
  height: calc(100vh - 180rpx - env(safe-area-inset-bottom));
}

/* 每个象限格子 */
.quad-cell {
  display: flex;
  flex-direction: column;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-1);
  overflow: hidden;
  border-top: 4rpx solid;
  min-height: 0;
}
.quad-cell.q1 { border-top-color: var(--quad-q1-num); background: var(--quad-q1-bg); }
.quad-cell.q2 { border-top-color: var(--quad-q2-num); background: var(--quad-q2-bg); }
.quad-cell.q3 { border-top-color: var(--quad-q3-num); background: var(--quad-q3-bg); }
.quad-cell.q4 { border-top-color: var(--quad-q4-num); background: var(--quad-q4-bg); }

/* 象限头部 */
.quad-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  flex-shrink: 0;
}
.quad-title {
  font-size: 24rpx;
  font-weight: 700;
}
.quad-cell.q1 .quad-title { color: var(--quad-q1-label); }
.quad-cell.q2 .quad-title { color: var(--quad-q2-label); }
.quad-cell.q3 .quad-title { color: var(--quad-q3-label); }
.quad-cell.q4 .quad-title { color: var(--quad-q4-label); }
.quad-count {
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 700;
  background: var(--bg-card);
  padding: 0 8rpx;
  box-sizing: border-box;
}
.quad-cell.q1 .quad-count { color: var(--quad-q1-num); }
.quad-cell.q2 .quad-count { color: var(--quad-q2-num); }
.quad-cell.q3 .quad-count { color: var(--quad-q3-num); }
.quad-cell.q4 .quad-count { color: var(--quad-q4-num); }

/* 象限内列表（可滚动） */
.quad-list {
  flex: 1;
  min-height: 0;
  padding: 0 12rpx 12rpx;
}

/* 卡片 */
.qcard {
  background: var(--bg-card);
  border-radius: var(--radius-sm);
  padding: 10rpx 14rpx;
  margin-bottom: 6rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.06);
  transition: transform 0.15s;
}
.qcard:active { transform: scale(0.98); }
.qcard.urgent { border-left: 3rpx solid var(--color-error); }
.qcard.flagged { border-left: 3rpx solid #ef4444; }

.qcard-body {
  min-width: 0;
}
.qcard-title-text {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
  margin-bottom: 2rpx;
}
.qcard-meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}
.qcard-meta-item {
  font-size: 18rpx;
  color: var(--text-tertiary);
}
.qcard-meta-item.assignee {
  color: var(--color-success);
  font-weight: 600;
}

/* 空状态 */
.quad-empty {
  text-align: center;
  padding: 20rpx 0;
  font-size: 20rpx;
  color: var(--text-tertiary);
}
/* ── 卡片快捷操作 ── */
.qcard-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}
.qact {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.4;
  background: #F1F5F9;
  color: #475569;
  border: 1rpx solid #E2E8F0;
}
.qact-done {
  background: rgba(16, 185, 129, 0.1);
  border-color: rgba(16, 185, 129, 0.35);
  color: #0F6E56;
}
.qact-on {
  background: rgba(245, 158, 11, 0.14);
  border-color: rgba(245, 158, 11, 0.4);
  color: #854F0B;
}

/* ── 个人重要度 AI 建议徽标（v0.16.0） ── */
.qcard-ai {
  font-size: 20rpx;
  color: #B4491B;
  background: #FCEADD;
  border: 1rpx solid rgba(232, 98, 44, 0.35);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-weight: 600;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.qcard-ai-low {
  font-size: 20rpx;
  color: var(--text-tertiary, #A4AC9F);
  background: var(--bg-hover, #F1F5F9);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
