<view class="page">
  <view class="quad-summary">
    <text class="summary-label">待处理总数</text>
    <text class="summary-count">{{totalCount}}</text>
  </view>

  <view class="quad-grid">
    <view class="quad-cell q1">
      <view class="quad-head">
        <text class="quad-title">🔴 重要紧急</text>
        <text class="quad-count">{{quadrants.q1.length}}</text>
      </view>
      <view class="quad-hint">立即处理</view>
      <scroll-view class="quad-list" scroll-y>
        <view class="qcard {{pkg.overdue ? 'urgent' : ''}}" wx:for="{{quadrants.q1}}" wx:key="id" catchtap="onEdit" data-id="{{pkg.id}}">
          <view class="qcard-main">
            <text class="qcard-title">{{pkg.title || pkg.code}}</text>
            <view class="qcard-meta">
              <text class="qcard-type">{{pkg.type === 'pickup' ? '📦取件' : '📝备忘'}}</text>
              <text class="qcard-code" wx:if="{{pkg.type === 'pickup'}}">{{pkg.code}}</text>
              <text class="qcard-assignee" wx:if="{{pkg.type === 'todo' && pkg.assignee}}">@{{pkg.assignee}}</text>
              <text class="qcard-src" wx:if="{{pkg.source}}">{{pkg.source}}</text>
              <text class="qcard-time" wx:if="{{pkg.arrivedLabel}}">⏰{{pkg.arrivedLabel}}</text>
              <text class="qcard-occ" wx:if="{{pkg.occCount > 1}}">×{{pkg.occCount}}</text>
            </view>
          </view>
          <text class="qcard-arrow">›</text>
        </view>
        <view class="quad-empty" wx:if="{{quadrants.q1.length === 0}}">暂无</view>
      </scroll-view>
    </view>

    <view class="quad-cell q2">
      <view class="quad-head">
        <text class="quad-title">🟡 重要不紧急</text>
        <text class="quad-count">{{quadrants.q2.length}}</text>
      </view>
