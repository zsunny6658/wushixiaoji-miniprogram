<view class="page">
  <view class="version-bar">V6 21:23</view>
  <view class="quad-summary">
    <text class="summary-label">待处理总数</text>
    <text class="summary-count">{{totalCount}}</text>
  </view>

  <view class="quad-grid">
    <view class="quad-cell q1">
      <view class="quad-head">
        <text class="quad-title">🔴 重要紧急</text>
        <text class="quad-count">{{quadrants.q1.length}}</text>
      </view>
      <scroll-view class="quad-list" scroll-y>
        <view class="qcard {{pkg.overdue ? 'urgent' : ''}} {{pkg.importance === 'high' ? 'flagged' : ''}}" wx:for="{{quadrants.q1}}" wx:for-item="pkg" wx:key="id" catchtap="onEdit" data-id="{{pkg.id}}">
          <view class="qcard-body">
            <text class="qcard-title-text">{{pkg.summaryText || pkg.title || pkg.code}}</text>
            <view class="qcard-meta-row">
              <view class="qcard-meta-item" wx:if="{{pkg.arrivedLabel}}"><ficon style="vertical-align:-3rpx;margin-right:4rpx" name="clock" size="22" color="#9CA3AF" />{{pkg.arrivedLabel}}</view>
              <text class="qcard-meta-item" wx:if="{{pkg.occCount > 1}}">×{{pkg.occCount}}</text>
              <text class="qcard-meta-item assignee" wx:if="{{pkg.assignee}}">@{{pkg.assignee}}</text>
              <text class="qcard-ai" wx:if="{{pkg.aiUp}}">AI↑ {{pkg.aiReason}}</text>
              <text class="qcard-ai-low" wx:elif="{{pkg.aiLow}}">AI·可缓</text>
            </view>
            <view class="qcard-actions">
              <view class="qact qact-done" wx:if="{{pkg.type !== 'medication'}}" catchtap="onQuickDone" data-id="{{pkg.id}}" data-type="{{pkg.type}}">✓ 完成</view>
              <view class="qact {{pkg.importance === 'high' ? 'qact-on' : ''}}" catchtap="onQuickFlag" data-id="{{pkg.id}}" data-important="{{pkg.importance === 'high' ? '1' : '0'}}">{{pkg.importance === 'high' ? '⚑ 取消重要' : '⚑ 标重要'}}</view>
            </view>
          </view>
        </view>
        <view class="quad-empty" wx:if="{{quadrants.q1.length === 0}}">暂无</view>
      </scroll-view>
    </view>

