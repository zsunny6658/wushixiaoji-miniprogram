<view class="page">
  <!-- ============ 个人设置 ============ -->
  <block wx:if="{{action === 'profile'}}">
    <view class="section">
      <text class="section-title">个人资料</text>
      <view class="form-item avatar-row">
        <button open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" class="avatar-btn">
          <image class="avatar-image" src="{{profile.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
          <text class="avatar-tip">点击更换头像</text>
        </button>
      </view>
      <view class="form-item">
        <text class="form-label">用户名</text>
        <input class="form-input" value="{{profile.username}}" data-field="username" bindinput="onProfileInput" />
      </view>
      <view class="form-item">
        <text class="form-label">显示名</text>
        <input class="form-input" value="{{profile.displayName}}" data-field="displayName" bindinput="onProfileInput" />
      </view>
      <view class="form-item">
        <text class="form-label">邮箱</text>
        <input class="form-input" type="email" value="{{profile.email}}" data-field="email" bindinput="onProfileInput" />
      </view>
      <button class="btn-primary" bindtap="onSaveProfile">保存</button>
    </view>
  </block>

  <!-- ============ 修改密码 ============ -->
  <block wx:elif="{{action === 'password'}}">
    <view class="section">
      <text class="section-title">修改密码</text>
      <view class="form-item">
        <text class="form-label">验证方式</text>
        <view class="pwd-mode-switch">
          <view class="pwd-mode-btn {{pwdMode === 'password' ? 'pwd-mode-active' : ''}}" data-mode="password" bindtap="onPwdModeChange">原密码</view>
          <view class="pwd-mode-btn {{pwdMode === 'passcode' ? 'pwd-mode-active' : ''}}" data-mode="passcode" bindtap="onPwdModeChange">家庭码</view>
        </view>
      </view>
      <view class="form-item" wx:if="{{pwdMode === 'password'}}">
        <text class="form-label">当前密码</text>
        <input class="form-input" password="true" value="{{pwdForm.oldPassword}}" data-field="oldPassword" bindinput="onPwdInput" />
      </view>
      <view class="form-item" wx:if="{{pwdMode === 'passcode'}}">
        <text class="form-label">家庭码</text>
        <input class="form-input" value="{{pwdForm.familyPasscode}}" data-field="familyPasscode" bindinput="onPwdInput" />
      </view>
      <view class="form-item">
        <text class="form-label">新密码</text>
        <input class="form-input" password="true" value="{{pwdForm.newPassword}}" data-field="newPassword" bindinput="onPwdInput" />
      </view>
      <view class="form-item">
        <text class="form-label">确认新密码</text>
        <input class="form-input" password="true" value="{{pwdForm.confirm}}" data-field="confirm" bindinput="onPwdInput" />
      </view>
      <button class="btn-primary" bindtap="onSavePassword">修改密码</button>
    </view>
  </block>

  <!-- ============ CLI Token 管理 ============ -->
  <block wx:elif="{{action === 'tokens'}}">
    <view class="section">
      <text class="section-title">创建 Token</text>
      <view class="form-item">
        <text class="form-label">名称</text>
        <input class="form-input" placeholder="如：青龙签到" value="{{newTokenName}}" bindinput="onNewTokenName" />
      </view>
      <view class="form-item">
        <text class="form-label">过期时间</text>
        <input class="form-input" placeholder="可选，如 2026-12-31" value="{{newTokenExpiry}}" bindinput="onNewTokenExpiry" />
      </view>
      <view class="form-item">
        <text class="form-label">权限范围</text>
        <view class="perm-tags">
          <view wx:for="{{permOptions}}" wx:key="id" class="perm-tag {{newTokenPerms.indexOf(item.id) >= 0 ? 'perm-tag-active' : ''}}" data-id="{{item.id}}" bindtap="onTokenPermChange">
            <text class="perm-tag-label">{{item.label}}</text>
            <text class="perm-tag-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
      <button class="btn-primary" bindtap="onCreateToken">生成 Token</button>
    </view>

    <view class="section">
      <text class="section-title">Token 列表（{{tokens.length}}）</text>
      <view wx:if="{{!tokens.length}}" class="empty-tip">暂无 Token</view>
      <view class="item-card" wx:for="{{tokens}}" wx:key="id">
        <view class="item-head">
          <text class="item-name">{{item.name}}</text>
          <text class="item-tag" wx:if="{{item.isFamilyCode}}">家庭码</text>
          <text class="item-tag" wx:elif="{{item.expiresAt}}">到期 {{item.expiresAt}}</text>
          <text class="item-tag" wx:else>永久</text>
        </view>
        <text class="item-value mono">{{item.value}}</text>
        <view class="item-actions" wx:if="{{!item.isFamilyCode}}">
          <button class="btn-sm btn-danger" bindtap="onDeleteToken" data-id="{{item.id}}">删除</button>
        </view>
      </view>
    </view>
  </block>

  <!-- ============ Webhook 管理 ============ -->
  <block wx:elif="{{action === 'webhooks'}}">
    <view class="section">
      <text class="section-title">创建 Webhook</text>
      <view class="form-item">
        <text class="form-label">名称</text>
        <input class="form-input" placeholder="如：邮箱转发" value="{{newWebhookName}}" bindinput="onNewWebhookName" />
      </view>
      <view class="form-item">
        <text class="form-label">过期时间</text>
        <input class="form-input" placeholder="可选，如 2026-12-31" value="{{newWebhookExpiry}}" bindinput="onNewWebhookExpiry" />
      </view>
      <view class="form-item">
        <text class="form-label">权限范围</text>
        <view class="perm-tags">
          <view wx:for="{{permOptions}}" wx:key="id" class="perm-tag {{newWebhookPerms.indexOf(item.id) >= 0 ? 'perm-tag-active' : ''}}" data-id="{{item.id}}" bindtap="onWebhookPermChange">
            <text class="perm-tag-label">{{item.label}}</text>
            <text class="perm-tag-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
      <button class="btn-primary" bindtap="onCreateWebhook">生成 Webhook</button>
    </view>

    <view class="section">
      <text class="section-title">Webhook 列表（{{webhooks.length}}）</text>
      <view wx:if="{{!webhooks.length}}" class="empty-tip">暂无 Webhook</view>
      <view class="item-card" wx:for="{{webhooks}}" wx:key="id">
        <view class="item-head">
          <text class="item-name">{{item.name}}</text>
          <text class="item-tag" wx:if="{{item.isFamilyCode}}">家庭码</text>
          <text class="item-tag" wx:elif="{{item.expiresAt}}">到期 {{item.expiresAt}}</text>
          <text class="item-tag" wx:else>永久</text>
        </view>
        <text class="item-value mono">{{item.token}}</text>
        <view class="item-actions" wx:if="{{!item.isFamilyCode}}">
          <button class="btn-sm btn-danger" bindtap="onDeleteWebhook" data-id="{{item.id}}">删除</button>
        </view>
      </view>
    </view>
  </block>

  <!-- ============ 家庭配置（邮件/AI） ============ -->
  <block wx:elif="{{action === 'mail'}}">
    <view class="section">
      <text class="section-title">邮件配置（SMTP）</text>
      <view class="form-item">
        <text class="form-label">SMTP 服务器</text>
        <input class="form-input" placeholder="smtp.qq.com" value="{{config.smtpHost}}" data-field="smtpHost" bindinput="onConfigInput" />
      </view>
      <view class="form-item">
        <text class="form-label">端口</text>
        <input class="form-input" type="number" value="{{config.smtpPort}}" data-field="smtpPort" bindinput="onConfigInput" />
      </view>
      <view class="form-item">
        <text class="form-label">用户名</text>
        <input class="form-input" value="{{config.smtpUser}}" data-field="smtpUser" bindinput="onConfigInput" />
      </view>
      <view class="form-item">
        <text class="form-label">密码/授权码</text>
        <input class="form-input" value="{{config.smtpPass}}" data-field="smtpPass" bindinput="onConfigInput" />
      </view>
      <view class="form-item">
        <text class="form-label">发件人地址</text>
        <input class="form-input" type="email" value="{{config.smtpFrom}}" data-field="smtpFrom" bindinput="onConfigInput" />
      </view>
      <view class="form-item">
        <text class="form-label">发件人名称</text>
        <input class="form-input" value="{{config.smtpFromName}}" data-field="smtpFromName" bindinput="onConfigInput" />
      </view>
      <view class="form-item form-row">
        <text class="form-label">启用 SSL</text>
        <switch checked="{{config.smtpSecure}}" data-field="smtpSecure" bindchange="onConfigSwitch" />
      </view>
      <view class="form-item">
        <text class="form-label">测试邮箱</text>
        <input class="form-input" type="email" placeholder="接收测试邮件的地址" value="{{testEmailTo}}" data-field="testEmailTo" bindinput="onTestEmailInput" />
      </view>
      <view class="btn-row">
        <button class="btn-primary" bindtap="onTestEmail">发送测试邮件</button>
        <button class="btn-secondary" bindtap="onSaveConfig">保存配置</button>
      </view>
    </view>

    <view class="section">
      <text class="section-title">AI 配置</text>
      <view class="form-item">
        <text class="form-label">服务商</text>
        <input class="form-input" placeholder="openai / deepseek / qwen / ollama" value="{{config.aiProvider}}" data-field="aiProvider" bindinput="onConfigInput" />
      </view>
      <view class="form-item">
        <text class="form-label">模型</text>
        <input class="form-input" placeholder="gpt-4o / deepseek-chat" value="{{config.aiModel}}" data-field="aiModel" bindinput="onConfigInput" />
      </view>
      <view class="form-item">
        <text class="form-label">API Base URL</text>
        <input class="form-input" placeholder="https://api.openai.com/v1" value="{{config.aiBaseUrl}}" data-field="aiBaseUrl" bindinput="onConfigInput" />
      </view>
      <view class="form-item">
        <text class="form-label">API Key</text>
        <input class="form-input" value="{{config.aiApiKey}}" data-field="aiApiKey" bindinput="onConfigInput" />
      </view>
      <view class="btn-row">
        <button class="btn-primary" bindtap="onTestAI">测试连通性</button>
        <button class="btn-secondary" bindtap="onSaveConfig">保存配置</button>
      </view>
    </view>

    <view class="section">
      <text class="section-title">数据清理</text>
      <text class="section-desc">已忽略的记录会在指定天数后自动删除</text>
      <view class="form-item">
        <text class="form-label">自动删除天数</text>
        <input class="form-input" type="number" value="{{config.ignoreCleanupDays}}" data-field="ignoreCleanupDays" bindinput="onConfigInput" />
      </view>
      <view class="form-item">
        <text class="form-label">逾期提醒提前天数</text>
        <input class="form-input" type="number" value="{{config.reminderDays}}" data-field="reminderDays" bindinput="onConfigInput" />
      </view>
      <view class="btn-row">
        <button class="btn-secondary" bindtap="onSaveConfig">保存配置</button>
      </view>
    </view>
  </block>

  <!-- ============ 默认：完整设置页 ============ -->
  <block wx:else>
    <!-- 用户信息 -->
    <view class="section">
      <view class="user-card">
        <view class="user-avatar">{{meFirstChar}}</view>
        <view class="user-info">
          <text class="user-name">{{meName}}</text>
          <text class="user-role">{{roleLabel}} · {{familyName}}</text>
        </view>
      </view>
    </view>

    <!-- 家庭 -->
    <view class="section" wx:if="{{isAdmin}}">
      <text class="section-title">家庭</text>
      <text class="section-desc">当前家庭：{{familyName}}</text>
    </view>

    <!-- 语音额度 -->
    <view class="section" wx:if="{{asrStatus}}">
      <text class="section-title">语音识别</text>
      <view class="quota-card">
        <view class="quota-row">
          <text class="quota-label">一句话识别</text>
          <text class="quota-value">{{asrStatus.textToSentence.used}} / {{asrStatus.textToSentence.quota}}</text> 
        </view>
        <view class="quota-bar">
          <view class="quota-fill" style="width: {{asrStatus.textToSentence.percent}}%"></view>
        </view>
        <text class="quota-hint">每月免费 {{asrStatus.textToSentence.quota}} 次，已用 {{asrStatus.textToSentence.percent}}%</text>
      </view>
      <view class="quota-card" wx:if="{{asrStatus.realtime}}">
        <view class="quota-row">
          <text class="quota-label">实时语音</text>
          <text class="quota-value">{{asrStatus.realtime.usedHours}}h / {{asrStatus.realtime.quotaHours}}h</text>
        </view>
        <view class="quota-bar">
          <view class="quota-fill" style="width: {{asrStatus.realtime.percent}}%"></view>
        </view>
        <text class="quota-hint">剩余 {{asrStatus.realtime.remainingHours}} 小时</text>
      </view>
      <text class="section-desc" wx:if="{{asrStatus.engine === 'local-fallback'}}">⚠️ 额度已用尽，已降级到本地识别</text>
    </view>

    <!-- 关于 -->
    <view class="section">
      <text class="section-title">关于</text>
      <view class="about-card">
        <view class="about-logo">📦</view>
        <text class="about-name">屋事小记</text>
        <text class="about-desc">家庭快递取件码共享平台</text>
        <view class="about-divider"></view>
        <view class="about-row"><text class="about-label">版本</text><text class="about-value">v{{version}}</text></view>
        <view class="about-row"><text class="about-label">服务地址</text><text class="about-value">{{baseUrl}}</text></view>
        <view class="about-divider"></view>
        <view class="about-icp">
          <text class="about-icp-label">ICP备案</text>
          <text class="about-icp-value" bindtap="onCopyICP">{{icpText}}</text>
        </view>
        <view class="about-icp">
          <text class="about-icp-label">公安备案</text>
          <text class="about-icp-value" bindtap="onCopyICP">{{govText}}</text>
        </view>
      </view>
    </view>
  </block>

  <view class="page-bottom"></view>
</view>
