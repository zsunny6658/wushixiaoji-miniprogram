/* pages/read/read.wxss - 待读列表 */
.page {
  padding: var(--spacing-md);
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

/* ---------- 头部 ---------- */
.rd-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
}
.rd-head-left { display: flex; flex-direction: column; min-width: 0; }
.rd-title { font-size: var(--font-heading); font-weight: 700; color: var(--text-primary); line-height: 1.2; }
.rd-sub { font-size: var(--font-caption); color: var(--text-tertiary); margin-top: 6rpx; }
.rd-add-btn {
  width: 72rpx; height: 72rpx; border-radius: var(--radius-full);
  background: var(--color-primary);
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-2);
  flex-shrink: 0;
}
.rd-add-btn:active { transform: scale(0.94); }

/* ---------- 搜索 ---------- */
.rd-search {
  display: flex; align-items: center; gap: 12rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-full);
  padding: 0 24rpx;
  height: 76rpx;
  margin-bottom: var(--spacing-sm);
}
.rd-search-input { flex: 1; font-size: var(--font-body-sm); color: var(--text-primary); min-width: 0; }
.rd-search-ph { color: var(--text-tertiary); }
.rd-search-clear {
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  color: var(--text-tertiary); font-size: 26rpx;
}

/* ---------- 筛选 ---------- */
.rd-filters { display: flex; gap: 12rpx; margin-bottom: var(--spacing-sm); }
.rd-filter {
  padding: 10rpx 26rpx;
  border-radius: var(--radius-full);
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  font-size: var(--font-caption);
  color: var(--text-secondary);
}
.rd-filter.on {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
  color: var(--color-primary);
  font-weight: 600;
}

/* ---------- 标签 ---------- */
.rd-tags-row {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: var(--spacing-sm);
}
.rd-tags {
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}
.rd-tags-organize {
  flex-shrink: 0;
  font-size: var(--font-caption);
  color: var(--text-tertiary);
  padding: 8rpx 8rpx;
}
.rd-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  margin-right: 12rpx;
  border-radius: var(--radius-full);
  background: var(--bg-hover);
  color: var(--text-secondary);
  font-size: var(--font-caption);
}

/* ---------- 卡片 ---------- */
.rd-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-sm);
  box-shadow: var(--shadow-1);
  border-left: 6rpx solid transparent;
}
.rd-card.is-unread { border-left-color: var(--color-primary); }
.rd-card:active { background: var(--bg-hover); }

.rd-card-top { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; }
.rd-plat {
  font-size: var(--font-caption);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary-light);
  color: var(--color-primary);
  flex-shrink: 0;
}
.plat-wechat { background: #E8F7EC; color: #07A24B; }
.plat-xiaohongshu { background: #FDECEC; color: #E64C4C; }
.plat-douyin { background: #EFEFF3; color: #2B2B33; }
.plat-bilibili { background: #E9F3FB; color: #1E88C7; }
.plat-zhihu { background: #EAF1FB; color: #1762B0; }
.rd-time { font-size: var(--font-caption); color: var(--text-tertiary); margin-left: auto; }
.rd-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--color-accent);
  flex-shrink: 0;
}

.rd-card-title {
  display: block;
  font-size: var(--font-body-lg);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.42;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.rd-card-summary {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-body-sm);
  color: var(--text-secondary);
  line-height: 1.55;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.rd-card-summary.rd-snippet { color: var(--text-secondary); }
.hl {
  background: rgba(30, 91, 60, 0.14);
  color: var(--color-primary);
  border-radius: 4rpx;
  font-weight: 600;
}
.rd-card-tags { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.rd-mini-tag { font-size: var(--font-caption); color: var(--text-tertiary); }

.rd-card-status {
  margin-top: 12rpx;
  display: flex; align-items: center; gap: 16rpx;
  font-size: var(--font-caption);
  color: var(--text-tertiary);
}
.rd-card-status.is-failed { color: var(--color-error); }
.rd-retry {
  color: var(--color-primary);
  text-decoration: underline;
}

/* ---------- 搜索结果头 ---------- */
.rd-result-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: var(--spacing-sm);
  font-size: var(--font-caption);
  color: var(--text-secondary);
}
.rd-result-clear { color: var(--color-primary); }

/* ---------- 空态 / 加载 ---------- */
.rd-loading, .rd-more {
  text-align: center;
  padding: var(--spacing-lg) 0;
  font-size: var(--font-caption);
  color: var(--text-tertiary);
}
.rd-empty {
  display: flex; flex-direction: column; align-items: center;
  padding: 120rpx 48rpx;
  text-align: center;
}
.rd-empty-title {
  margin-top: var(--spacing-md);
  font-size: var(--font-body-lg);
  font-weight: 600;
  color: var(--text-secondary);
}
.rd-empty-desc {
  margin-top: 12rpx;
  font-size: var(--font-body-sm);
  color: var(--text-tertiary);
  line-height: 1.6;
}
.rd-empty-btn {
  margin-top: var(--spacing-lg);
  padding: 20rpx 56rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-body);
}

/* ---------- 添加弹窗 ---------- */
.rd-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex; align-items: flex-end;
}
.rd-sheet {
  width: 100%;
  background: var(--bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: var(--spacing-md) var(--spacing-md) calc(var(--spacing-md) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.rd-sheet-title { font-size: var(--font-subtitle); font-weight: 700; color: var(--text-primary); }
.rd-sheet-desc {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--text-tertiary);
  line-height: 1.5;
}
.rd-textarea {
  width: 100%;
  min-height: 140rpx;
  margin-top: var(--spacing-sm);
  padding: 20rpx;
  box-sizing: border-box;
  background: var(--bg-page);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  font-size: var(--font-body-sm);
  color: var(--text-primary);
  line-height: 1.5;
}
.rd-note-input {
  width: 100%;
  height: 84rpx;
  margin-top: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: var(--bg-page);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  font-size: var(--font-body-sm);
  color: var(--text-primary);
}
.rd-ph { color: var(--text-tertiary); }
.rd-sheet-actions {
  display: flex; gap: var(--spacing-sm);
  margin-top: var(--spacing-md);
}
.rd-sheet-actions .btn-sm { flex: 1; }
